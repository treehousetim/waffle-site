---
/**
 * Everything in <head> that search engines and link previews read. Part of
 * the core: every example's Base layout renders it once, and
 * tools/audit.mjs checks its output against docs/seo.md's rules after every
 * build. Everything it needs comes in as props, so it knows nothing about
 * any one site's design.
 */
import { settings } from '../settings';
import { absoluteUrl, canonicalUrl, isNoindex, pageTitle, robotsMeta } from '../lib/seo.js';
import { serializeJsonLd } from '../lib/jsonld.js';

interface Props {
    title: string;
    description: string;
    /** The site's name, added after the title, and its locale (en_US). */
    siteName: string;
    locale: string;
    /** Paths kept out of search results (site.ts's noindex list). */
    noindexPaths: readonly string[];
    /** Path or absolute URL of the link-preview image, and its alt text. */
    image: { src: string; alt: string };
    type: 'website' | 'article';
    jsonLd: Record<string, unknown>;
    article?: { published: Date; updated?: Date | undefined; tags: readonly string[] } | undefined;
}

const { title, description, siteName, locale, noindexPaths, image, type, jsonLd, article } = Astro.props;
const path = Astro.url.pathname;
const noindex = isNoindex(path, noindexPaths);
// Astro.site is the site's origin (astro.config.mjs's `site`).
const origin = new URL(Astro.site ?? settings.siteUrl).origin;
const canonical = canonicalUrl(path, origin);
const fullTitle = pageTitle(title, siteName);
const imageUrl = absoluteUrl(image.src, origin);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={robotsMeta({ indexable: settings.indexable, noindex })} />
{!noindex && <link rel="canonical" href={canonical} />}

<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={locale} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={image.alt} />
{article && <meta property="article:published_time" content={article.published.toISOString()} />}
{article?.updated && <meta property="article:modified_time" content={article.updated.toISOString()} />}
{article?.tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />
