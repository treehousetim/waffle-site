---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { site } from '../site';
---

<Base
    title="Privacy policy"
    description="What Waffle Site collects on this website, why, how long we keep it, and how to ask us to delete it. Plain language, and no tracking cookies."
    breadcrumbs={[{ name: 'Privacy', href: '/privacy/' }]}
>
    <Hero size="small" eyebrow="Legal" heading="Privacy policy" />

    <div class="prose page">
        <p class="muted">Example text. Replace it with your own policy before you launch.</p>
        <h2>What this website collects</h2>
        <p>This website sets no tracking cookies and runs no third-party analytics. When you send the quote form, we receive what you typed in it, so that we can reply and quote for the job.</p>
        <h2>How long we keep it</h2>
        <p>Quote requests are kept for two years, and job records for as long as tax and licensing rules require.</p>
        <h2>Your rights</h2>
        <p>Ask us to see, correct or delete anything we hold about you at <a href={`mailto:${site.business.email}`}>{site.business.email}</a>.</p>
    </div>
</Base>

<style>
    .page {
        padding-bottom: var(--section);
    }
</style>
