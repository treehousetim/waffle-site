---
/**
 * The price guide comes from the waffle app at build time
 * (docs/waffle-api.md): /api/site/prices, checked by parsePriceGuide before
 * anything renders. A development build reads api-fixtures/ instead.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import PriceGuide from '../components/PriceGuide.astro';
import Faq from '../components/Faq.astro';
import CallToAction from '../components/CallToAction.astro';
import { waffle } from '../settings';
import { site } from '../site';
import { parsePriceGuide } from '../lib/prices.js';
import { faqPage } from '../lib/jsonld.js';

const guide = parsePriceGuide(await waffle.get('/api/site/prices'));
const updated = new Date(guide.updated).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const questions = [
    { question: 'Are these the prices I will pay?', answer: 'They are starting prices for a straightforward job. Every job gets a written price before work starts, and that is the price you pay.' },
    { question: 'Do you charge for estimates?', answer: 'No. Estimates are free for any job over $500, in person or by video call.' },
    { question: 'Are permits included?', answer: 'Yes. Where a job needs a permit, the fee and the inspection are in the quote.' },
    { question: 'How do I pay?', answer: 'Card, bank transfer or check, when the job is done. Larger jobs take a deposit for materials.' },
];
---

<Base
    title="Electrician prices"
    description="Starting prices for electrical work in Springfield: service calls, panel upgrades, EV chargers, lighting, generators and inspections. Free written estimates."
    breadcrumbs={[{ name: 'Prices', href: '/prices/' }]}
    jsonLd={[faqPage(questions)]}
>
    <Hero
        size="small"
        eyebrow={`Price guide · updated ${updated}`}
        heading="What electrical work costs"
        lead="Starting prices for our most common jobs. You always get a written price before we start, and permits are always included."
        photo="clampMeterAndTools"
        primary={{ label: site.cta.label, href: site.cta.href }}
        secondary={{ label: `Call ${site.business.phone}`, href: `tel:${site.business.phoneE164}` }}
    />

    <Section>
        <PriceGuide guide={guide} />
    </Section>

    <Section tone="surface" eyebrow="FAQ" heading="About our prices">
        <Faq items={questions} />
    </Section>

    <CallToAction heading="Want an exact price?" text="Send a few photos and a description. Most quotes are back the same day." action={{ label: 'Request a free quote', href: '/contact/' }} />
</Base>
