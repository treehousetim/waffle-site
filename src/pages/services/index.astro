---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import CardGrid from '../../components/CardGrid.astro';
import CallToAction from '../../components/CallToAction.astro';
import { services, serviceUrl } from '../../data/services';
---

<Base
    title="Electrical services"
    description="Residential and light commercial electrical services in Springfield: repairs, panel upgrades, EV chargers, rewiring, lighting, generators and inspections."
    breadcrumbs={[{ name: 'Services', href: '/services/' }]}
>
    <Hero
        size="small"
        eyebrow="Services"
        heading="Electrical services for homes and small businesses"
        lead="Every job is done by a licensed electrician, permitted where the code requires it, and priced in writing before we start."
    />

    <Section>
        <CardGrid cards={services.map((item) => ({ href: serviceUrl(item.slug), title: item.name, text: item.summary, icon: item.icon }))} level="h2" />
    </Section>

    <CallToAction heading="Not sure what you need?" text="Describe the problem and we will tell you, free, whether it is a five-minute fix or a bigger job." action={{ label: 'Ask us', href: '/contact/' }} />
</Base>
