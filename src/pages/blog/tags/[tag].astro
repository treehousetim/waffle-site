---
/** /blog/tags/<tag>/ for every tag in use. */
import type { GetStaticPaths } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Hero from '../../../components/Hero.astro';
import PostGrid from '../../../components/PostGrid.astro';
import { site } from '../../../site';
import { buildTime, settings } from '../../../settings';
import { postsTagged, tagIndex, visiblePosts } from '../../../lib/posts.js';

export const getStaticPaths = (async () => {
    const posts = visiblePosts(await getCollection('blog'), { includeDrafts: !settings.production, now: buildTime });

    return tagIndex(posts).map((tag) => ({
        params: { tag: tag.slug },
        props: { name: tag.tag, posts: postsTagged(posts, tag.slug) },
    }));
}) satisfies GetStaticPaths;

interface Props {
    name: string;
    posts: CollectionEntry<'blog'>[];
}

const { name, posts } = Astro.props;
const count = posts.length === 1 ? 'one post' : `${posts.length} posts`;
---

<Base
    title={`Posts about ${name}`}
    description={`Every ${site.name} blog post about ${name}: ${count}, newest first. Plain-language advice from licensed electricians.`}
    breadcrumbs={[
        { name: site.blog.title, href: '/blog/' },
        { name, href: Astro.url.pathname },
    ]}
>
    <Hero size="small" eyebrow={`Topic · ${count}`} heading={`Posts about ${name}`} secondary={{ label: '← All articles', href: '/blog/' }} />
    <div class="container list">
        <PostGrid posts={posts} />
    </div>
</Base>

<style>
    .list {
        padding: var(--space-12) 0 var(--section);
    }
</style>
