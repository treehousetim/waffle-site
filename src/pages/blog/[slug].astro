---
/** /blog/<slug>/ for every post the build shows (src/lib/posts.js decides which). */
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { buildTime, settings } from '../../settings';
import { visiblePosts } from '../../lib/posts.js';

export const getStaticPaths = (async () => {
    const posts = visiblePosts(await getCollection('blog'), { includeDrafts: !settings.production, now: buildTime });

    return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
---

<BlogPost post={post}>
    <Content />
</BlogPost>
