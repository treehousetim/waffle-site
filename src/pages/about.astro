---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import CallToAction from '../components/CallToAction.astro';
import { site } from '../site';
---

<Base
    title="About us"
    description="Waffle Site is a family-run electrical contractor in Springfield since 2009: licensed electricians, straight prices and clean, permitted work."
    breadcrumbs={[{ name: 'About', href: '/about/' }]}
>
    <Hero size="small" eyebrow="About us" heading="A local electrical contractor, since 2009" />

    <div class="prose">
        <p class="lead">{site.name} started with one van and one electrician who was tired of seeing rushed, unpermitted work in people's homes.</p>
        <p>Today we are a team of licensed electricians and apprentices working across Springfield and the towns around it. We are still run by the people who started it, and we still answer our own phone.</p>
        <h2>How we work</h2>
        <p>We give a written price before we start, pull the permits the work needs, and leave every job cleaner than we found it. If something is not right, we come back and make it right.</p>
        <h2>Licensing</h2>
        <p>{site.business.licence}. Insured for general liability and workers compensation; certificates on request.</p>
    </div>

    <Section tone="surface" heading="What we promise">
        <FeatureGrid
            features={[
                { icon: 'dollar', title: 'Prices in writing', text: 'The price we quote is the price you pay, unless you ask for more work.' },
                { icon: 'shield', title: 'Done to code', text: 'Permitted and inspected where the code requires it, every time.' },
                { icon: 'clock', title: 'On time', text: 'A two-hour arrival window, and a call if we are running late.' },
                { icon: 'check', title: 'Guaranteed', text: 'Two years on our workmanship. If it is our fault, it is our cost.' },
            ]}
        />
    </Section>

    <CallToAction heading="Let's talk about your project" action={{ label: 'Get a free quote', href: '/contact/' }} />
</Base>
