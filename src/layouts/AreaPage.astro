---
/**
 * The frame every town page shares (src/pages/areas/<slug>.astro): the
 * town's own copy in the slot beside a quote card, then the services, the
 * reviews from that town and the way to get in touch.
 *
 * A town page earns its place only with copy that is true of that town and no
 * other: the housing, the jobs done there, how long it takes to get there
 * (docs/pages.md, "Town pages"). Swap the town's name into another page and
 * search engines will treat both as doorway pages.
 */
import Base from './Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import CardGrid from '../components/CardGrid.astro';
import Testimonials, { type Testimonial } from '../components/Testimonials.astro';
import QuoteCard from '../components/QuoteCard.astro';
import CallToAction from '../components/CallToAction.astro';
import { areas } from '../data/areas';
import { services, serviceUrl } from '../data/services';
import { site } from '../site';

interface Props {
    /** The slug in src/data/areas.ts. */
    slug: string;
    title: string;
    description: string;
    heading: string;
    lead: string;
    reviews?: Testimonial[];
}

const { slug, title, description, heading, lead, reviews = [] } = Astro.props;
const area = areas.find((item) => item.slug === slug);

if (area === undefined) {
    throw new Error(`AreaPage: no area '${slug}' in src/data/areas.ts.`);
}
---

<Base
    title={title}
    description={description}
    breadcrumbs={[
        { name: 'Areas we serve', href: '/areas/' },
        { name: area.name, href: Astro.url.pathname },
    ]}
>
    <Hero
        size="small"
        eyebrow={`Electricians in ${area.name}`}
        heading={heading}
        lead={lead}
        photo={area.photo}
        badge={{ title: area.drive, text: 'from our Springfield shop' }}
        primary={{ label: site.cta.label, href: site.cta.href }}
        secondary={{ label: `Call ${site.business.phone}`, href: `tel:${site.business.phoneE164}` }}
    />

    <div class="container body">
        <div class="prose-column">
            <slot />
        </div>
        <div class="aside">
            <QuoteCard heading={`Need an electrician in ${area.name}?`} />
        </div>
    </div>

    <Section tone="surface" heading={`What we do in ${area.name}`} align="start" more={{ label: 'All services', href: '/services/' }}>
        <CardGrid cards={services.map((item) => ({ href: serviceUrl(item.slug), title: item.name, text: item.summary, icon: item.icon }))} />
    </Section>

    {
        reviews.length > 0 && (
            <Section heading={`What ${area.name} customers say`}>
                <Testimonials items={reviews} />
            </Section>
        )
    }

    <CallToAction heading={`Need an electrician in ${area.name}?`} text="Same-week appointments, and emergency call-outs around the clock." action={{ label: 'Request a free quote', href: '/contact/' }} />
</Base>

<style>
    .body {
        display: grid;
        gap: var(--space-12);
        padding: var(--section) 0;
    }

    .prose-column {
        max-width: var(--width-prose);
    }

    .prose-column :global(h2) {
        font-size: clamp(1.5rem, 1.25rem + 1vw, 1.875rem);
    }

    .prose-column :global(* + h2) {
        margin-top: var(--space-12);
    }

    @media (min-width: 64rem) {
        .body {
            grid-template-columns: minmax(0, 1fr) 22rem;
            align-items: start;
        }

        .aside {
            position: sticky;
            top: calc(var(--header-height) + var(--space-6));
        }
    }
</style>
