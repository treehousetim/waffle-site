---
/**
 * The one template every blog post uses (docs/blog.md).
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from './Base.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { site } from '../site';
import { settings } from '../settings';
import { blogPosting } from '../lib/jsonld.js';
import { absoluteUrl, canonicalUrl } from '../lib/seo.js';
import { readingMinutes, tagSlug } from '../lib/posts.js';

interface Props {
    post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover, coverAlt, draft } = post.data;
const author = post.data.author ?? site.blog.defaultAuthor;
const url = canonicalUrl(Astro.url.pathname, settings.siteUrl);
const image = cover !== undefined ? { src: cover.src, alt: coverAlt ?? '' } : site.defaultImage;
---

<Base
    title={title}
    description={description}
    type="article"
    image={image}
    breadcrumbs={[
        { name: site.blog.title, href: '/blog/' },
        { name: title, href: Astro.url.pathname },
    ]}
    article={{ published: pubDate, updated: updatedDate, tags }}
    jsonLd={[
        blogPosting(
            {
                url,
                title,
                description,
                image: absoluteUrl(image.src, settings.siteUrl),
                published: pubDate,
                updated: updatedDate,
                author,
                tags,
            },
            settings.siteUrl,
        ),
    ]}
>
    <article class="post">
        <header class="prose">
            <p class="muted"><a href="/blog/">{site.blog.title}</a></p>
            {draft && <p class="draft">Draft: not published in production.</p>}
            <h1>{title}</h1>
            <p class="meta muted">
                By {author} · <FormattedDate date={pubDate} /> · {readingMinutes(post.body ?? '')} min read
                {
                    updatedDate && (
                        <>
                            {' '}
                            · Updated <FormattedDate date={updatedDate} />
                        </>
                    )
                }
            </p>
        </header>

        {cover && coverAlt && <Image class="cover" src={cover} alt={coverAlt} width={1200} loading="eager" />}

        <div class="prose body">
            <slot />
        </div>

        {
            tags.length > 0 && (
                <footer class="prose tags">
                    <h2 class="visually-hidden">Tags</h2>
                    <ul>
                        {tags.map((tag) => (
                            <li>
                                <a href={`/blog/tags/${tagSlug(tag)}/`}>{tag}</a>
                            </li>
                        ))}
                    </ul>
                </footer>
            )
        }
    </article>
</Base>

<style>
    .post {
        padding-top: var(--space-16);
    }

    .meta {
        font-size: 0.95rem;
    }

    .draft {
        display: inline-block;
        padding: 0 var(--space-2);
        border-radius: var(--radius-small);
        background: var(--color-brand-soft);
        color: var(--color-brand-strong);
        font-weight: 700;
    }

    .cover {
        width: min(100% - 2 * var(--space-6), 60rem);
        height: auto;
        margin: var(--space-8) auto;
        border-radius: var(--radius);
    }

    .body {
        margin-top: var(--space-8);
    }

    .tags ul {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin: var(--space-12) 0 0;
        padding: 0;
        list-style: none;
    }

    .tags a {
        display: inline-block;
        padding: var(--space-1) var(--space-3);
        border-radius: 999px;
        background: var(--color-surface);
        color: var(--color-text);
        font-size: 0.9rem;
        text-decoration: none;
    }
</style>
