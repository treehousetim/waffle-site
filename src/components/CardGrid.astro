---
/** Linked cards: services, towns, anything that is a list of pages. */
import Icon, { type IconName } from './Icon.astro';

export interface Card {
    href: string;
    title: string;
    text: string;
    icon?: IconName;
    note?: string;
}

interface Props {
    cards: Card[];
    level?: 'h2' | 'h3';
}

const { cards, level = 'h3' } = Astro.props;
const Heading = level;
---

<ul class="cards">
    {
        cards.map((card) => (
            <li>
                <a href={card.href}>
                    {card.icon && (
                        <span class="icon">
                            <Icon name={card.icon} />
                        </span>
                    )}
                    <Heading class="title">{card.title}</Heading>
                    <p>{card.text}</p>
                    {card.note && <p class="note">{card.note}</p>}
                    <span class="more" aria-hidden="true">Learn more →</span>
                </a>
            </li>
        ))
    }
</ul>

<style>
    .cards {
        display: grid;
        gap: var(--space-6);
        grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
        margin: 0;
        padding: 0;
        list-style: none;
    }

    a {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: var(--space-6);
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        background: var(--color-bg);
        color: var(--color-text);
        text-decoration: none;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    a:hover {
        border-color: var(--color-brand);
        box-shadow: var(--shadow);
        color: var(--color-text);
    }

    .icon {
        display: inline-flex;
        align-self: flex-start;
        margin-bottom: var(--space-4);
        padding: var(--space-2);
        border-radius: var(--radius-small);
        background: var(--color-brand-soft);
        color: var(--color-brand-strong);
    }

    .title {
        font-size: 1.15rem;
        margin-bottom: var(--space-2);
    }

    p {
        margin: 0 0 var(--space-3);
        color: var(--color-muted);
    }

    .note {
        font-size: 0.9rem;
        font-weight: 650;
        color: var(--color-brand-strong);
    }

    .more {
        margin-top: auto;
        color: var(--color-brand-strong);
        font-weight: 650;
    }
</style>
