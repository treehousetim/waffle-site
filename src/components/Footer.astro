---
/**
 * The footer: the business's name, address, phone and hours on every page,
 * written exactly as in src/site.ts, then the links.
 */
import Logo from './Logo.astro';
import PhoneLink from './PhoneLink.astro';
import { addressLine, site } from '../site';
import { buildTime } from '../settings';

const dayRange = (days: readonly string[]) =>
    days.length === 1 ? days[0] : `${(days[0] ?? '').slice(0, 3)}–${(days[days.length - 1] ?? '').slice(0, 3)}`;
---

<footer class="site-footer">
    <div class="container grid">
        <div class="brand">
            <Logo />
            <address>
                {addressLine}<br />
                <PhoneLink /><br />
                <a href={`mailto:${site.business.email}`}>{site.business.email}</a>
            </address>
            <p class="hours">
                {
                    site.business.hours.map((hours) => (
                        <span>
                            {dayRange(hours.days)} {hours.opens}–{hours.closes}
                            <br />
                        </span>
                    ))
                }
                <strong>{site.business.emergency}</strong>
            </p>
        </div>
        {
            site.footer.map((column) => (
                <nav aria-label={column.heading}>
                    <h2>{column.heading}</h2>
                    <ul>
                        {column.links.map((link) => (
                            <li>
                                <a href={link.href}>{link.label}</a>
                            </li>
                        ))}
                    </ul>
                </nav>
            ))
        }
    </div>
    <div class="container legal">
        <p class="muted">© {buildTime.getUTCFullYear()} {site.business.legalName} · {site.business.licence}</p>
        <p class="muted"><a href="/blog/rss.xml">RSS</a></p>
    </div>
</footer>

<style>
    .site-footer {
        margin-top: var(--space-24);
        padding: var(--space-16) 0 var(--space-8);
        border-top: 1px solid var(--color-border);
        background: var(--color-surface);
        font-size: 0.95rem;
    }

    .grid {
        display: grid;
        gap: var(--space-8);
        grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    }

    .brand {
        grid-column: span 2;
        max-width: 24rem;
    }

    address {
        margin: var(--space-4) 0;
        font-style: normal;
        line-height: 1.8;
    }

    .hours {
        color: var(--color-muted);
    }

    .hours strong {
        color: var(--color-text);
    }

    h2 {
        font-size: 0.85rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-muted);
    }

    ul {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    li + li {
        margin-top: var(--space-2);
    }

    li a {
        color: var(--color-text);
        text-decoration: none;
    }

    li a:hover {
        text-decoration: underline;
    }

    .legal {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: var(--space-4);
        margin-top: var(--space-12);
        padding-top: var(--space-6);
        border-top: 1px solid var(--color-border);
    }

    .legal p {
        margin: 0;
    }
</style>
