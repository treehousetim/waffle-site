---
/**
 * The footer: the business's name, address, phone and hours on every page,
 * written exactly as in src/site.ts, then the links.
 */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { addressLine, site } from '../site';
import { buildTime } from '../settings';

const dayRange = (days: readonly string[]) =>
    days.length === 1 ? days[0] : `${(days[0] ?? '').slice(0, 3)}–${(days[days.length - 1] ?? '').slice(0, 3)}`;
---

<footer class="site-footer">
    <div class="container grid">
        <div class="brand">
            <Logo tone="light" />
            <p class="tagline">{site.tagline}, serving Springfield and nearby towns since {site.business.founded}.</p>
            <address>
                <span class="line"><Icon name="pin" size={18} /> {addressLine}</span>
                <a class="line" href={`tel:${site.business.phoneE164}`}><Icon name="phone" size={18} /> {site.business.phone}</a>
                <a class="line" href={`mailto:${site.business.email}`}><Icon name="mail" size={18} /> {site.business.email}</a>
            </address>
            <p class="hours">
                {
                    site.business.hours.map((hours) => (
                        <span>
                            {dayRange(hours.days)} {hours.opens}–{hours.closes}
                            <br />
                        </span>
                    ))
                }
                <strong>{site.business.emergency}</strong>
            </p>
        </div>
        {
            site.footer.map((column) => (
                <nav aria-label={column.heading}>
                    <h2>{column.heading}</h2>
                    <ul>
                        {column.links.map((link) => (
                            <li>
                                <a href={link.href}>{link.label}</a>
                            </li>
                        ))}
                    </ul>
                </nav>
            ))
        }
    </div>
    <div class="container legal">
        <p>© {buildTime.getUTCFullYear()} {site.business.legalName} · {site.business.licence}</p>
        <p><a href="/credits/">Photo credits</a> · <a href="/blog/rss.xml">RSS</a></p>
    </div>
</footer>

<style>
    .site-footer {
        padding: var(--space-20) 0 var(--space-8);
        background: var(--color-ink);
        color: var(--color-on-ink-muted);
        font-size: 0.95rem;
    }

    .grid {
        display: grid;
        gap: var(--space-10);
        grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    }

    .brand {
        grid-column: 1 / -1;
        max-width: 26rem;
    }

    @media (min-width: 64rem) {
        .grid {
            grid-template-columns: 1.8fr 1fr 1fr 1fr;
        }

        .brand {
            grid-column: auto;
        }
    }

    .tagline {
        margin: var(--space-5) 0;
    }

    address {
        display: grid;
        gap: var(--space-2);
        margin-bottom: var(--space-5);
        font-style: normal;
    }

    .line {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        color: var(--color-on-ink);
        text-decoration: none;
    }

    .line :global(svg) {
        flex: none;
        color: var(--color-accent);
    }

    a.line:hover {
        color: #ffffff;
    }

    .hours strong {
        color: var(--color-on-ink);
        font-weight: 600;
    }

    h2 {
        margin-bottom: var(--space-4);
        color: var(--color-on-ink);
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    ul {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    li + li {
        margin-top: var(--space-3);
    }

    nav a,
    .legal a {
        color: var(--color-on-ink-muted);
        text-decoration: none;
    }

    nav a:hover,
    .legal a:hover {
        color: #ffffff;
    }

    .legal {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: var(--space-4);
        margin-top: var(--space-16);
        padding-top: var(--space-6);
        border-top: 1px solid rgb(255 255 255 / 0.1);
        font-size: 0.875rem;
    }

    .legal p {
        margin: 0;
    }
</style>
