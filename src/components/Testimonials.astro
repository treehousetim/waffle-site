---
export interface Testimonial {
    quote: string;
    name: string;
    role: string;
}

interface Props {
    items: Testimonial[];
}

const { items } = Astro.props;
---

<ul class="testimonials">
    {/* Stars as decoration: the rating is in the words, not in markup. */}
    {
        items.map((item) => (
            <li>
                <figure>
                    <p class="stars" aria-hidden="true">★★★★★</p>
                    <blockquote>
                        <p>“{item.quote}”</p>
                    </blockquote>
                    <figcaption>
                        <strong>{item.name}</strong>
                        <span class="muted">{item.role}</span>
                    </figcaption>
                </figure>
            </li>
        ))
    }
</ul>

<style>
    .testimonials {
        display: grid;
        gap: var(--space-6);
        grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
        margin: 0;
        padding: 0;
        list-style: none;
    }

    figure {
        height: 100%;
        margin: 0;
        padding: var(--space-8);
        border-radius: var(--radius);
        background: var(--color-bg);
        box-shadow: var(--shadow);
    }

    .stars {
        margin: 0 0 var(--space-3);
        color: #e6a700;
        letter-spacing: 0.1em;
    }

    blockquote {
        margin: 0 0 var(--space-6);
        font-size: 1.05rem;
    }

    figcaption {
        display: grid;
    }
</style>
