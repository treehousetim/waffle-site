---
/**
 * The bar fixed to the bottom of a phone's screen: call, or ask for a quote.
 * Most visitors to an electrician's site are on a phone and want one of the
 * two. Hidden on wider screens, where the header carries both.
 */
import Icon from './Icon.astro';
import { site } from '../site';
---

<nav class="mobile-actions" aria-label="Quick actions">
    <a class="call" href={`tel:${site.business.phoneE164}`}>
        <Icon name="phone" size={20} />
        Call now
    </a>
    <a class="quote" href={site.cta.href}>
        {site.cta.label}
    </a>
</nav>

<style>
    .mobile-actions {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 20;
        display: grid;
        grid-template-columns: 1fr 1.3fr;
        gap: var(--space-2);
        padding: var(--space-3) var(--space-3) calc(var(--space-3) + env(safe-area-inset-bottom));
        background: rgb(255 255 255 / 0.94);
        border-top: 1px solid var(--color-border);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        box-shadow: 0 -8px 24px -12px rgb(23 19 43 / 0.25);
    }

    a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-2);
        min-height: 3.25rem;
        border-radius: 999px;
        font-weight: 700;
        text-decoration: none;
    }

    .call {
        border: 2px solid var(--color-border-strong);
        color: var(--color-text);
    }

    .quote {
        background: var(--color-brand);
        color: var(--color-on-brand);
    }

    @media (min-width: 40.01rem) {
        .mobile-actions {
            display: none;
        }
    }
</style>
