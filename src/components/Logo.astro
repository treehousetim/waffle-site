---
/** The mark and the name. Decorative mark, so the name is the link's text. */
import { site } from '../site';

interface Props {
    tone?: 'dark' | 'light';
}

const { tone = 'dark' } = Astro.props;
---

<a class:list={['logo', tone]} href="/">
    <svg width="34" height="34" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <rect x="1" y="1" width="30" height="30" rx="9" fill="currentColor" />
        <path d="M17.5 6L9.5 18h6l-1.5 8 8.5-12.5h-6.2L17.5 6z" fill="#f5a524" />
    </svg>
    <span>{site.name}</span>
</a>

<style>
    .logo {
        display: inline-flex;
        align-items: center;
        gap: var(--space-3);
        font-weight: 800;
        font-size: 1.2rem;
        letter-spacing: -0.02em;
        text-decoration: none;
        white-space: nowrap;
    }

    .dark {
        color: var(--color-text);
    }

    .dark svg {
        color: var(--color-brand);
    }

    .light {
        color: #ffffff;
    }

    .light svg {
        color: var(--color-brand);
    }

    .logo:hover {
        color: inherit;
    }
</style>
