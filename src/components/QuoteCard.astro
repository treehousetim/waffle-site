---
/**
 * The sidebar card on service and town pages: both ways to get in touch,
 * and what happens next. Sticks in view on wide screens while the copy
 * scrolls past it.
 */
import Icon from './Icon.astro';
import { site } from '../site';

interface Props {
    heading?: string;
}

const { heading = 'Get a free, written quote' } = Astro.props;
---

<aside class="quote-card" aria-label="Get a quote">
    <p class="title">{heading}</p>
    <p class="muted">Tell us about the job. We reply the same working day, usually within the hour.</p>
    <p class="buttons">
        <a class="button" href={site.cta.href}>{site.cta.label}</a>
        <a class="button button-secondary" href={`tel:${site.business.phoneE164}`}>
            <Icon name="phone" size={18} />
            {site.business.phone}
        </a>
    </p>
    <ul>
        <li><Icon name="check" size={16} /> Licensed, insured, permitted</li>
        <li><Icon name="check" size={16} /> Price agreed before work starts</li>
        <li><Icon name="check" size={16} /> Two-year workmanship guarantee</li>
    </ul>
</aside>

<style>
    .quote-card {
        padding: var(--space-8);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-large);
        background: var(--color-bg);
        box-shadow: var(--shadow);
    }

    .title {
        margin-bottom: var(--space-2);
        font-size: 1.3rem;
        font-weight: 750;
        letter-spacing: -0.02em;
        line-height: 1.25;
    }

    .buttons {
        display: grid;
        gap: var(--space-3);
        margin: var(--space-6) 0;
    }

    ul {
        display: grid;
        gap: var(--space-2);
        margin: 0;
        padding: var(--space-5) 0 0;
        border-top: 1px solid var(--color-border);
        list-style: none;
        color: var(--color-muted);
        font-size: 0.925rem;
    }

    li {
        display: flex;
        align-items: center;
        gap: var(--space-2);
    }

    li :global(svg) {
        flex: none;
        color: var(--color-success);
    }
</style>
