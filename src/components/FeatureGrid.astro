---
import Icon, { type IconName } from './Icon.astro';

export interface Feature {
    icon: IconName;
    title: string;
    text: string;
}

interface Props {
    features: Feature[];
    /** The heading level of each feature title: h3 under a section heading. */
    level?: 'h2' | 'h3';
}

const { features, level = 'h3' } = Astro.props;
const Heading = level;
---

<ul class="features">
    {
        features.map((feature) => (
            <li>
                <span class="icon">
                    <Icon name={feature.icon} />
                </span>
                <Heading class="title">{feature.title}</Heading>
                <p>{feature.text}</p>
            </li>
        ))
    }
</ul>

<style>
    .features {
        display: grid;
        gap: var(--space-6);
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
        margin: 0;
        padding: 0;
        list-style: none;
    }

    li {
        padding: var(--space-8);
        border-radius: var(--radius);
        background: var(--color-bg);
        box-shadow: var(--shadow-small);
    }

    .icon {
        display: inline-grid;
        place-items: center;
        width: 3rem;
        height: 3rem;
        margin-bottom: var(--space-5);
        border-radius: var(--radius);
        background: var(--color-brand-soft);
        color: var(--color-brand);
    }

    .title {
        margin-bottom: var(--space-2);
        font-size: 1.15rem;
    }

    p {
        margin: 0;
        color: var(--color-muted);
    }
</style>
