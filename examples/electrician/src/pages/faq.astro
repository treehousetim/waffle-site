---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Faq from '../components/Faq.astro';
import CallToAction from '../components/CallToAction.astro';
import { faqPage } from '@core/lib/jsonld.js';

const general = [
    { question: 'Are you licensed and insured?', answer: 'Yes. Every job is done or supervised by a licensed electrician, and we carry general liability and workers compensation insurance. We are happy to send certificates.' },
    { question: 'Do you work on commercial properties?', answer: 'Yes, light commercial: shops, offices, cafés and small workshops. Large new construction is outside what we take on.' },
    { question: 'How soon can you come out?', answer: 'Most jobs are booked within the week. Emergencies get a truck within the hour where we can.' },
    { question: 'Do you guarantee your work?', answer: 'Our workmanship is guaranteed for two years. Parts carry the manufacturer’s warranty, which we handle for you.' },
];

const planning = [
    { question: 'Do I need a permit?', answer: 'For panel work, new circuits, rewiring, generators and EV chargers, almost always. We pull the permit and book the inspection.' },
    { question: 'Can I buy my own fixtures or charger?', answer: 'Yes. We will check that what you bought is rated for where it is going before we install it.' },
    { question: 'Will you clean up afterwards?', answer: 'Always. We use drop cloths, vacuum as we go and take our debris with us.' },
];
---

<Base
    title="Frequently asked questions"
    description="Answers to the questions Springfield homeowners ask electricians most: licensing, permits, scheduling, guarantees, payment and what to expect on the day."
    breadcrumbs={[{ name: 'FAQ', href: '/faq/' }]}
    jsonLd={[faqPage([...general, ...planning])]}
>
    <Hero size="small" eyebrow="FAQ" heading="Questions, answered" lead="Can't find yours? Call or send it through the quote form and a person will reply." photo="electricianDrilling" />

    <Section eyebrow="About us" heading="Who we are and how we work">
        <Faq items={general} />
    </Section>

    <Section tone="surface" eyebrow="Planning" heading="Planning a job">
        <Faq items={planning} />
    </Section>

    <CallToAction heading="Still have a question?" text="Ask us anything. A licensed electrician will answer, usually the same day." action={{ label: 'Ask us', href: '/contact/' }} />
</Base>
