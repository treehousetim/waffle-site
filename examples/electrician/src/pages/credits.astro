---
/**
 * Who took the photographs. The example photos are from Unsplash, free
 * under the Unsplash License; credit is not required, but given. Kept out of
 * search results (src/site.ts, noindex).
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { photos } from '../data/photos';

const credits = Object.values(photos);
---

<Base
    title="Photo credits"
    description="The photographers whose work appears on this site, with links to the originals. Example photos are from Unsplash, under the Unsplash License."
    breadcrumbs={[{ name: 'Photo credits', href: '/credits/' }]}
>
    <Hero size="small" eyebrow="Credits" heading="Photo credits" lead="With thanks to the photographers whose work appears on this site." />

    <div class="prose page">
        <p>Photographs from <a href="https://unsplash.com/">Unsplash</a>, used under the <a href="https://unsplash.com/license">Unsplash License</a>.</p>
        <ul>
            {credits.map((photo) => (
                <li>
                    {photo.alt.replace(/\.$/, '')}: <a href={photo.credit.url}>{photo.credit.name}</a>
                </li>
            ))}
        </ul>
        <p>The typeface is <a href="https://rsms.me/inter/">Inter</a>, by Rasmus Andersson, under the <a href="https://openfontlicense.org/">SIL Open Font License</a>.</p>
    </div>
</Base>

<style>
    .page {
        padding-bottom: var(--section);
    }
</style>
