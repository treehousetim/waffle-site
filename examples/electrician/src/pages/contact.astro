---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icon.astro';
import { addressLine, site } from '../site';

const steps = [
    { title: 'We read it the same working day', text: 'Usually within the hour, by a licensed electrician.' },
    { title: 'We call, text or email you back', text: 'However you asked, with questions or a price.' },
    { title: 'You get a written quote', text: 'Small jobs on the spot; bigger ones after a free visit.' },
];
---

<Base
    title="Get a free quote"
    description="Request a free, written quote from a licensed Springfield electrician. Tell us about the job and we reply the same working day, often within the hour."
    breadcrumbs={[{ name: 'Contact', href: '/contact/' }]}
>
    <Hero size="small" eyebrow="Free quote" heading="Tell us about the job" lead="A licensed electrician reads every request. We reply the same working day, often within the hour." />

    <div class="container layout">
        <QuoteForm thanks="/contact/thanks/" />

        <aside class="side">
            <div class="panel">
                <h2>What happens next</h2>
                <ol class="next">
                    {steps.map((step) => (
                        <li>
                            <strong>{step.title}</strong>
                            <span>{step.text}</span>
                        </li>
                    ))}
                </ol>
            </div>

            <div class="panel">
                <h2>Rather talk?</h2>
                <p class="contact-line"><Icon name="phone" size={18} /> <a href={`tel:${site.business.phoneE164}`}>{site.business.phone}</a></p>
                <p class="contact-line"><Icon name="mail" size={18} /> <a href={`mailto:${site.business.email}`}>{site.business.email}</a></p>
                <p class="contact-line"><Icon name="pin" size={18} /> <span>{addressLine}</span></p>
            </div>

            <div class="panel urgent">
                <h2>Emergency?</h2>
                <p>Please don't wait for a reply. <a href="/emergency/">Call our 24/7 line</a> and a licensed electrician will answer.</p>
            </div>
        </aside>
    </div>
</Base>

<style>
    .layout {
        display: grid;
        gap: var(--space-8);
        padding-bottom: var(--section);
    }

    @media (min-width: 64rem) {
        .layout {
            grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
            align-items: start;
        }

        .side {
            position: sticky;
            top: calc(var(--header-height) + var(--space-6));
        }
    }

    .side {
        display: grid;
        gap: var(--space-5);
    }

    .panel {
        padding: var(--space-6) var(--space-8);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-large);
        background: var(--color-surface);
    }

    .panel h2 {
        margin-bottom: var(--space-4);
        font-size: 1.2rem;
    }

    .next {
        display: grid;
        gap: var(--space-4);
        margin: 0;
        padding: 0;
        list-style: none;
        counter-reset: next;
    }

    .next li {
        display: grid;
        grid-template-columns: 2rem 1fr;
        column-gap: var(--space-3);
        counter-increment: next;
        line-height: 1.4;
    }

    .next li::before {
        content: counter(next);
        grid-row: span 2;
        display: inline-grid;
        place-items: center;
        width: 2rem;
        height: 2rem;
        border-radius: 50%;
        background: var(--color-brand);
        color: #ffffff;
        font-size: 0.875rem;
        font-weight: 750;
    }

    .next span {
        color: var(--color-muted);
        font-size: 0.925rem;
    }

    .contact-line {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        margin-bottom: var(--space-3);
    }

    .contact-line :global(svg) {
        flex: none;
        color: var(--color-brand);
    }

    .contact-line a {
        font-weight: 650;
        text-decoration: none;
    }

    .urgent {
        border-color: #f3c97a;
        background: var(--color-accent-soft);
    }

    .urgent p {
        margin: 0;
    }
</style>
