---
/**
 * Reviews as quotes. The stars are decoration: the rating is in the words,
 * never in markup (src/data/reviews.ts says why).
 */
export interface Testimonial {
    quote: string;
    name: string;
    role: string;
}

interface Props {
    items: Testimonial[];
}

const { items } = Astro.props;
const initials = (name: string) =>
    name
        .split(/\s+/)
        .filter((word) => /^[A-Za-z]/.test(word) && word !== 'and')
        .slice(0, 2)
        .map((word) => word[0])
        .join('');
---

<ul class="testimonials">
    {
        items.map((item) => (
            <li>
                <figure>
                    <p class="stars" aria-hidden="true">★★★★★</p>
                    <blockquote>
                        <p>{item.quote}</p>
                    </blockquote>
                    <figcaption>
                        <span class="avatar" aria-hidden="true">{initials(item.name)}</span>
                        <span>
                            <strong>{item.name}</strong>
                            <span class="role">{item.role}</span>
                        </span>
                    </figcaption>
                </figure>
            </li>
        ))
    }
</ul>

<style>
    .testimonials {
        display: grid;
        gap: var(--space-6);
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
        margin: 0;
        padding: 0;
        list-style: none;
    }

    figure {
        display: flex;
        flex-direction: column;
        height: 100%;
        margin: 0;
        padding: var(--space-8);
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        background: var(--color-bg);
        box-shadow: var(--shadow-small);
    }

    .stars {
        margin: 0 0 var(--space-4);
        color: var(--color-accent);
        font-size: 1.1rem;
        letter-spacing: 0.15em;
    }

    blockquote {
        flex: 1;
        margin: 0 0 var(--space-6);
        font-size: 1.05rem;
        line-height: 1.6;
    }

    blockquote p {
        margin: 0;
    }

    blockquote p::before {
        content: '“';
    }

    blockquote p::after {
        content: '”';
    }

    figcaption {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        line-height: 1.3;
    }

    .avatar {
        display: inline-grid;
        flex: none;
        place-items: center;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 50%;
        background: var(--color-brand-soft);
        color: var(--color-brand-strong);
        font-size: 0.9rem;
        font-weight: 750;
    }

    strong {
        display: block;
    }

    .role {
        color: var(--color-muted);
        font-size: 0.875rem;
    }
</style>
