---
/**
 * The price guide, as the waffle app sends it (src/lib/prices.js has the
 * shape and refuses anything else). Rendered at build time: the page ships
 * with the prices in it. `service` narrows it to one service's prices.
 */
import { byCategory, formatPrice, type PriceGuide } from '@core/lib/prices.js';

interface Props {
    guide: PriceGuide;
    service?: string;
    showCategories?: boolean;
}

const { guide, service, showCategories = true } = Astro.props;
const items = service === undefined ? guide.items : guide.items.filter((item) => item.service === service);
const per = { job: '', hour: 'per hour', visit: 'per visit', fixture: 'each' } as const;
---

{
    items.length > 0 && (
        <div class:list={['guide', { grouped: showCategories }]}>
            {byCategory(items).map((group) => (
                <section class="group">
                    {showCategories && <h3>{group.category}</h3>}
                    <dl>
                        {group.items.map((item) => (
                            <div class="item">
                                <dt>
                                    <span class="name">{item.name}</span>
                                    <span class="description">{item.description}</span>
                                    {item.service && (
                                        <a class="service" href={`/services/${item.service}/`}>
                                            About this service <span aria-hidden="true">→</span>
                                        </a>
                                    )}
                                </dt>
                                <dd>
                                    {item.fromCents > 0 && <span class="from">from</span>}
                                    <strong>{formatPrice(item.fromCents, item.currency)}</strong>
                                    {item.fromCents > 0 && per[item.unit] !== '' && <span class="per">{per[item.unit]}</span>}
                                </dd>
                            </div>
                        ))}
                    </dl>
                </section>
            ))}
        </div>
    )
}

<style>
    .guide {
        display: grid;
        gap: var(--space-6);
    }

    .group {
        overflow: hidden;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-large);
        background: var(--color-bg);
        box-shadow: var(--shadow-small);
    }

    h3 {
        margin: 0;
        padding: var(--space-5) var(--space-6);
        border-bottom: 1px solid var(--color-border);
        background: var(--color-surface);
        font-size: 1.05rem;
    }

    dl {
        margin: 0;
    }

    .item {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: var(--space-6);
        padding: var(--space-5) var(--space-6);
    }

    .item + .item {
        border-top: 1px solid var(--color-border);
    }

    dt {
        display: grid;
        gap: var(--space-1);
    }

    .name {
        font-weight: 650;
    }

    .description {
        color: var(--color-muted);
        font-size: 0.95rem;
    }

    .service {
        margin-top: var(--space-1);
        font-size: 0.875rem;
        font-weight: 650;
        text-decoration: none;
    }

    dd {
        display: grid;
        flex: none;
        justify-items: end;
        margin: 0;
        line-height: 1.2;
        text-align: right;
    }

    .from,
    .per {
        color: var(--color-subtle);
        font-size: 0.8rem;
        font-weight: 550;
    }

    dd strong {
        color: var(--color-text);
        font-size: 1.4rem;
        font-weight: 750;
        letter-spacing: -0.02em;
    }

    @media (min-width: 64rem) {
        .grouped {
            grid-template-columns: 1fr 1fr;
            align-items: start;
        }
    }
</style>
