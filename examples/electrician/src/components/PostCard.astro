---
/**
 * One post in a list: the blog index, a tag page, the home page. Its picture
 * is the post's cover, or its topic's photo (src/data/photos.ts), so every
 * card has one.
 */
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import Photo from './Photo.astro';
import { defaultPostPhoto, topicPhotos } from '../data/photos';
import { readingMinutes, tagSlug } from '@core/lib/posts.js';

interface Props {
    post: CollectionEntry<'blog'>;
    /** h2 on a page of posts; h3 inside a section that has its own h2. */
    level?: 'h2' | 'h3';
    featured?: boolean;
}

const { post, level = 'h2', featured = false } = Astro.props;
const Heading = level;
const firstTag = post.data.tags[0];
const topicPhoto = (firstTag !== undefined ? topicPhotos[tagSlug(firstTag)] : undefined) ?? defaultPostPhoto;
const sizes = featured ? '(min-width: 64rem) 55vw, 100vw' : '(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw';
---

<article class:list={['card', { featured }]}>
    <a class="photo" href={`/blog/${post.id}/`} tabindex="-1" aria-hidden="true">
        {
            post.data.cover && post.data.coverAlt ? (
                <Photo src={post.data.cover} alt="" sizes={sizes} />
            ) : (
                <Photo name={topicPhoto} sizes={sizes} />
            )
        }
    </a>
    <div class="body">
        <p class="meta">
            {firstTag && <span class="tag">{firstTag}</span>}
            {post.data.draft && <span class="draft">Draft</span>}
            <span><FormattedDate date={post.data.pubDate} /> · {readingMinutes(post.body ?? '')} min read</span>
        </p>
        <Heading class="title"><a href={`/blog/${post.id}/`}>{post.data.title}</a></Heading>
        <p class="description">{post.data.description}</p>
    </div>
</article>

<style>
    .card {
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        background: var(--color-bg);
        box-shadow: var(--shadow-small);
        transition: box-shadow 0.2s ease, transform 0.2s ease;
    }

    .card:hover {
        box-shadow: var(--shadow);
        transform: translateY(-3px);
    }

    .photo {
        display: block;
        overflow: hidden;
        aspect-ratio: 16 / 9;
        background: var(--color-surface);
    }

    .photo :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .card:hover .photo :global(img) {
        transform: scale(1.04);
    }

    .body {
        display: flex;
        flex: 1;
        flex-direction: column;
        padding: var(--space-6);
    }

    .meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2) var(--space-3);
        margin-bottom: var(--space-3);
        color: var(--color-subtle);
        font-size: 0.85rem;
    }

    .tag,
    .draft {
        padding: 0.15rem 0.6rem;
        border-radius: 999px;
        background: var(--color-brand-soft);
        color: var(--color-brand-strong);
        font-weight: 650;
    }

    .draft {
        background: var(--color-accent-soft);
        color: var(--color-accent-ink);
    }

    .title {
        margin-bottom: var(--space-3);
        font-size: 1.2rem;
        line-height: 1.3;
    }

    .title a {
        color: var(--color-text);
        text-decoration: none;
    }

    .title a::after {
        content: '';
        position: absolute;
        inset: 0;
    }

    .card {
        position: relative;
    }

    .title a:hover {
        color: var(--color-brand-strong);
    }

    .description {
        margin: 0;
        color: var(--color-muted);
        font-size: 0.975rem;
        line-height: 1.6;
    }

    @media (min-width: 64rem) {
        .featured {
            display: grid;
            grid-template-columns: 1.2fr 1fr;
        }

        .featured .photo {
            aspect-ratio: auto;
            min-height: 22rem;
        }

        .featured .body {
            justify-content: center;
            padding: var(--space-12);
        }

        .featured .title {
            font-size: clamp(1.6rem, 1.2rem + 1vw, 2.1rem);
            letter-spacing: -0.025em;
        }

        .featured .description {
            font-size: 1.05rem;
        }
    }
</style>
