---
/**
 * Questions and answers as <details>, readable without script. Pass the same
 * items to faqPage() in the page's jsonLd so search engines can read them too
 * (src/pages/prices.astro does).
 */
export interface FaqItem {
    question: string;
    answer: string;
}

interface Props {
    items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="faq">
    {
        items.map((item) => (
            <details>
                <summary>
                    <span>{item.question}</span>
                    <span class="marker" aria-hidden="true" />
                </summary>
                <p>{item.answer}</p>
            </details>
        ))
    }
</div>

<style>
    .faq {
        display: grid;
        gap: var(--space-3);
        max-width: 48rem;
        margin-inline: auto;
    }

    details {
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        background: var(--color-bg);
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    details[open] {
        border-color: var(--color-border-strong);
        box-shadow: var(--shadow-small);
    }

    summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        padding: var(--space-5) var(--space-6);
        font-size: 1.05rem;
        font-weight: 650;
        list-style: none;
        cursor: pointer;
    }

    summary::-webkit-details-marker {
        display: none;
    }

    .marker {
        position: relative;
        flex: none;
        width: 1.75rem;
        height: 1.75rem;
        border-radius: 50%;
        background: var(--color-brand-soft);
    }

    .marker::before,
    .marker::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 0.75rem;
        height: 2px;
        margin: -1px 0 0 -0.375rem;
        border-radius: 1px;
        background: var(--color-brand);
        transition: transform 0.2s ease;
    }

    .marker::after {
        transform: rotate(90deg);
    }

    details[open] .marker::after {
        transform: rotate(0deg);
    }

    p {
        margin: 0;
        padding: 0 var(--space-6) var(--space-6);
        color: var(--color-muted);
    }
</style>
