---
/** The four things people check before they let an electrician in. */
import Icon from './Icon.astro';
import { site } from '../site';
import { buildTime } from '@core/settings';

const years = buildTime.getUTCFullYear() - site.business.founded;
const items = [
    { icon: 'shield', title: 'Licensed and insured', text: 'Every job, permitted to code' },
    { icon: 'calendar', title: `${years} years local`, text: `Springfield since ${site.business.founded}` },
    { icon: 'clock', title: '24/7 emergencies', text: 'A real person answers' },
    { icon: 'dollar', title: 'Written prices', text: 'Free estimates over $500' },
] as const;
---

<ul class="trust" aria-label="Why people choose us">
    {
        items.map((item) => (
            <li>
                <span class="icon">
                    <Icon name={item.icon} size={22} />
                </span>
                <span>
                    <strong>{item.title}</strong>
                    <span class="text">{item.text}</span>
                </span>
            </li>
        ))
    }
</ul>

<style>
    .trust {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
        gap: var(--space-4);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    li {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        line-height: 1.3;
    }

    .icon {
        display: inline-grid;
        flex: none;
        place-items: center;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 50%;
        background: var(--color-bg);
        color: var(--color-brand);
        box-shadow: var(--shadow-small);
    }

    strong {
        display: block;
        font-size: 0.975rem;
    }

    .text {
        color: var(--color-muted);
        font-size: 0.875rem;
    }
</style>
