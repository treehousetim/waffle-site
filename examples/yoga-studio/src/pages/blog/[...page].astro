---
/** /blog/, then /blog/2/ and on: every post the build shows, newest first. */
import type { GetStaticPaths, Page } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import PostList from '../../components/PostList.astro';
import { site } from '../../site';
import { buildTime, settings } from '@core/settings';
import { tagIndex, visiblePosts } from '@core/lib/posts.js';

export const getStaticPaths = (async ({ paginate }) => {
    const posts = visiblePosts(await getCollection('blog'), { includeDrafts: !settings.production, now: buildTime });

    return paginate(posts, { pageSize: 6, props: { tags: tagIndex(posts) } });
}) satisfies GetStaticPaths;

interface Props {
    page: Page<CollectionEntry<'blog'>>;
    tags: ReturnType<typeof tagIndex>;
}

const { page, tags } = Astro.props;
const first = page.currentPage === 1;
// Page 2 and on need their own title and description (docs/seo.md, 12).
const title = first ? site.blog.title : `${site.blog.title}, page ${page.currentPage}`;
const description = first ? site.blog.description : `${site.blog.description} Page ${page.currentPage} of ${page.lastPage}.`;
---

<Base title={title} description={description} breadcrumbs={[{ name: site.blog.title, href: '/blog/' }]}>
    <PageHead
        label={first ? 'Notes from the studio' : `Page ${page.currentPage} of ${page.lastPage}`}
        heading={first ? 'The *journal*' : `The journal, *page ${page.currentPage}*`}
        lead={site.blog.description}
    >
        {
            tags.length > 0 && (
                <ul class="topics" aria-label="Topics">
                    {tags.map((tag) => (
                        <li>
                            <a href={`/blog/tags/${tag.slug}/`}>
                                {tag.tag} <span>{tag.count}</span>
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
    </PageHead>

    <div class="wide list">
        {page.data.length === 0 && <p>No posts yet.</p>}
        <PostList posts={page.data} />

        {
            page.lastPage > 1 && (
                <nav class="pager" aria-label="More posts">
                    {page.url.prev ? <a class="button button-quiet" href={page.url.prev}>← Newer</a> : <span />}
                    <span class="count">Page {page.currentPage} of {page.lastPage}</span>
                    {page.url.next ? <a class="button button-quiet" href={page.url.next}>Older →</a> : <span />}
                </nav>
            )
        }
    </div>
</Base>

<style>
    .topics {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .topics a {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        padding: 0.35rem 0.5rem 0.35rem 1rem;
        border: 1px solid var(--color-line);
        border-radius: 999px;
        color: var(--color-ink);
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        transition: border-color 0.6s var(--ease-settle), background-color 0.6s var(--ease-settle);
    }

    .topics a:hover {
        border-color: var(--color-sage-deep);
        background: var(--color-paper);
    }

    .topics span {
        display: inline-grid;
        place-items: center;
        min-width: 1.5rem;
        height: 1.5rem;
        border-radius: 50%;
        background: var(--color-sand-deep);
        color: var(--color-ink);
        font-size: 0.75rem;
    }

    .list {
        padding-bottom: var(--section);
    }

    .pager {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        margin-top: var(--space-12);
        padding-top: var(--space-8);
        border-top: 1px solid var(--color-line);
    }

    .count {
        color: var(--color-muted);
        font-size: 0.95rem;
        text-align: center;
    }
</style>
