---
/**
 * Who took the photographs, and who made the typefaces. The example photos
 * are from Unsplash, free under the Unsplash License; credit is not
 * required, but given. Kept out of search results (src/site.ts, noindex).
 */
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { photos } from '../data/photos';

const credits = Object.values(photos);
---

<Base
    title="Photo credits"
    description="The photographers whose work appears on this site, with links to the originals. Example photos are from Unsplash, under the Unsplash License."
    breadcrumbs={[{ name: 'Photo credits', href: '/credits/' }]}
>
    <PageHead label="Credits" heading="With *thanks*" lead="To the photographers whose work appears on this site, and the people who made its typefaces." />

    <div class="prose page">
        <p>Photographs from <a href="https://unsplash.com/">Unsplash</a>, used under the <a href="https://unsplash.com/license">Unsplash License</a>. The people in them are not the studio's teachers or students: Still Water Yoga is a fictional example.</p>
        <ul>
            {
                credits.map((photo) => (
                    <li>
                        {photo.alt.replace(/\.$/, '')}: <a href={photo.credit.url}>{photo.credit.name}</a>
                    </li>
                ))
            }
        </ul>
        <p>The typefaces are <a href="https://github.com/CatharsisFonts/Cormorant">Cormorant</a>, by Christian Thalmann, and <a href="https://github.com/Fonthausen/NunitoSans">Nunito Sans</a>, by Vernon Adams, Jacques Le Bailly and others, both under the <a href="https://openfontlicense.org/">SIL Open Font License</a>.</p>
    </div>
</Base>

<style>
    .page {
        padding-bottom: var(--section);
    }
</style>
