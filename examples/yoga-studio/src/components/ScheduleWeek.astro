---
/**
 * The whole week, from the waffle app (src/data/schedule.ts), day by day.
 * A row of choices above it narrows the week to one class style, with no
 * script: radio buttons and :has(). The days slide in, one after another,
 * as they reach the screen (motion.css, .day).
 *
 * The filter rules name each style in src/data/classes.ts; a new style
 * gets a line in each of the two :has() rules below.
 */
import Slot from './Slot.astro';
import { classes } from '../data/classes';
import { byDay, dayName, type Schedule } from '../lib/schedule';

interface Props {
    schedule: Schedule;
}

const { schedule } = Astro.props;
const days = byDay(schedule.classes);
---

<div class="week">
    <fieldset class="filter">
        <legend>Show</legend>
        <div class="choices">
            <label class="choice"><input type="radio" name="show" value="all" id="show-all" checked /> <span>Everything</span></label>
            {
                classes.map((style) => (
                    <label class="choice" data-style={style.slug}>
                        <input type="radio" name="show" value={style.slug} id={`show-${style.slug}`} /> <span><span class="dot" aria-hidden="true" />{style.name}</span>
                    </label>
                ))
            }
        </div>
    </fieldset>

    <ol class="days">
        {
            days.map(({ day, classes: slots }) => (
                <li class="day" id={day}>
                    <h2 class="day-name">
                        {dayName(day)}
                        <span class="count">{slots.length === 1 ? 'one class' : `${slots.length} classes`}</span>
                    </h2>
                    <ul class="slots">
                        {slots.map((item) => <Slot item={item} />)}
                    </ul>
                    <p class="none">Nothing in this style today.</p>
                </li>
            ))
        }
    </ol>
</div>

<style>
    .filter {
        position: sticky;
        top: var(--header-height);
        z-index: 5;
        margin: 0 calc(-1 * var(--space-2)) var(--space-12);
        padding: var(--space-3) var(--space-2);
        border: 0;
        background: color-mix(in srgb, var(--color-sand) 88%, transparent);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }

    legend {
        float: left;
        margin: 0.55rem var(--space-4) 0 0;
        color: var(--color-muted);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
    }

    .choices {
        display: flex;
        gap: var(--space-2);
        overflow-x: auto;
        scrollbar-width: none;
    }

    .choice {
        position: relative;
        flex: none;
        display: inline-flex;
        align-items: center;
        padding: 0.45rem 1rem;
        border: 1px solid var(--color-line);
        border-radius: 999px;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.6s var(--ease-settle), border-color 0.6s var(--ease-settle);
    }

    .choice span {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
    }

    .choice input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .choice:hover {
        border-color: var(--color-stone);
    }

    .choice:has(input:checked) {
        border-color: var(--color-ink);
        background: var(--color-paper);
    }

    .choice:has(input:focus-visible) {
        outline: 2px solid var(--color-focus);
        outline-offset: 3px;
    }

    .dot {
        width: 0.6rem;
        height: 0.6rem;
        border-radius: 50%;
        background: var(--style-color);
    }

    .days {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .day {
        display: grid;
        gap: var(--space-2) var(--space-12);
        padding: var(--space-10) 0;
        scroll-margin-top: calc(var(--header-height) + 5rem);
    }

    .day + .day {
        border-top: 1px solid var(--color-line);
    }

    .day-name {
        display: grid;
        align-content: start;
        margin: 0;
        font-size: clamp(2.25rem, 1.8rem + 1.6vw, 3.25rem);
        font-style: italic;
        font-weight: 300;
    }

    .count {
        margin-top: var(--space-2);
        color: var(--color-muted);
        font-family: var(--font-sans);
        font-size: 0.8rem;
        font-style: normal;
        font-weight: 600;
        letter-spacing: 0.04em;
    }

    .slots {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .slots :global(.slot:first-child) {
        border-top: 0;
    }

    .none {
        display: none;
        margin: 0;
        padding: var(--space-5) 0;
        color: var(--color-muted);
        font-style: italic;
    }

    @media (min-width: 64rem) {
        .day {
            grid-template-columns: 14rem minmax(0, 1fr);
        }

        .day-name {
            position: sticky;
            top: calc(var(--header-height) + 5.5rem);
            align-self: start;
        }

        .none {
            grid-column: 2;
        }
    }

    /* One style at a time: everything else on the week steps aside. */
    .week:has(#show-vinyasa:checked) :global(.slot:not([data-style='vinyasa'])),
    .week:has(#show-yin:checked) :global(.slot:not([data-style='yin'])),
    .week:has(#show-restorative:checked) :global(.slot:not([data-style='restorative'])),
    .week:has(#show-prenatal:checked) :global(.slot:not([data-style='prenatal'])),
    .week:has(#show-beginners:checked) :global(.slot:not([data-style='beginners'])) {
        display: none;
    }

    .week:has(#show-vinyasa:checked) .day:not(:has([data-style='vinyasa'])) .none,
    .week:has(#show-yin:checked) .day:not(:has([data-style='yin'])) .none,
    .week:has(#show-restorative:checked) .day:not(:has([data-style='restorative'])) .none,
    .week:has(#show-prenatal:checked) .day:not(:has([data-style='prenatal'])) .none,
    .week:has(#show-beginners:checked) .day:not(:has([data-style='beginners'])) .none {
        display: block;
    }
</style>
