---
/**
 * Concentric rings, like water after a stone. Decorative only. Placed
 * absolutely by the parent (which needs position: relative); the rings
 * spread outwards as their section scrolls into view (motion.css, .ripple),
 * and simply sit, still, where that cannot run.
 */
interface Props {
    class?: string;
    /** How many rings, three to five. */
    rings?: number;
}

const { class: className, rings = 4 } = Astro.props;
---

<div class:list={['ripple', className]} aria-hidden="true">
    {Array.from({ length: rings }, () => <span />)}
</div>

<style>
    .ripple {
        position: absolute;
        pointer-events: none;
        aspect-ratio: 1;
    }

    .ripple span {
        position: absolute;
        inset: 0;
        border: 1px solid var(--ring-color, var(--color-stone));
        border-radius: 50%;
        opacity: 0.55;
    }

    .ripple span:nth-child(2) {
        inset: 12%;
        opacity: 0.45;
    }

    .ripple span:nth-child(3) {
        inset: 24%;
        opacity: 0.35;
    }

    .ripple span:nth-child(4) {
        inset: 36%;
        opacity: 0.28;
    }

    .ripple span:nth-child(5) {
        inset: 44%;
        opacity: 0.2;
    }
</style>
