---
/**
 * The header: the logo, the navigation and the new-student invitation, on a
 * bar that stays at the top and quietly gains a ground as the page scrolls
 * (motion.css).
 *
 * Two navigations, one shown at a time: a plain one on wide screens, and on
 * phones a <details> that opens without any script into a full, calm sheet.
 * A browser hides a closed <details>'s contents whatever the CSS says, so
 * the wide-screen navigation cannot live inside it.
 */
import Logo from './Logo.astro';
import { site } from '../site';

const current = Astro.url.pathname;
const isCurrent = (href: string) => current === href || (href !== '/' && current.startsWith(href));
---

<header class="site-header">
    <div class="wide bar">
        <Logo ripple />

        <nav class="nav-wide" aria-label="Main">
            <ul>
                {
                    site.nav.map((link) => (
                        <li>
                            <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                                {link.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
            <a class="button button-quiet start" href={site.cta.href}>{site.cta.label}</a>
        </nav>

        <details class="menu">
            <summary>
                <span class="menu-word">Menu</span>
                <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
            </summary>
            <nav class="nav-narrow" aria-label="Main, on small screens">
                <ul>
                    {
                        site.nav.map((link) => (
                            <li>
                                <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                                    {link.label}
                                </a>
                            </li>
                        ))
                    }
                    <li><a href="/about/">The studio</a></li>
                    <li><a href="/contact/">Contact</a></li>
                </ul>
                <p class="actions">
                    <a class="button" href={site.cta.href}>{site.cta.label}</a>
                    <a class="button button-quiet" href={`tel:${site.business.phoneE164}`}>Call {site.business.phone}</a>
                </p>
            </nav>
        </details>
    </div>
</header>

<style>
    .site-header {
        position: sticky;
        top: 0;
        z-index: 20;
        background: color-mix(in srgb, var(--color-sand) 92%, transparent);
        backdrop-filter: blur(16px) saturate(1.1);
        -webkit-backdrop-filter: blur(16px) saturate(1.1);
    }

    .bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-6);
        min-height: var(--header-height);
    }

    ul {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .nav-wide {
        display: none;
        align-items: center;
        gap: var(--space-8);
    }

    .nav-wide ul {
        display: flex;
        gap: var(--space-1);
    }

    .nav-wide li a {
        position: relative;
        display: block;
        padding: var(--space-2) var(--space-3);
        color: var(--color-ink);
        font-size: 0.92rem;
        font-weight: 550;
        letter-spacing: 0.02em;
        text-decoration: none;
    }

    /* A small ring marks where you are; it fills in on hover. */
    .nav-wide li a::after {
        content: '';
        position: absolute;
        left: 50%;
        bottom: -0.2rem;
        width: 0.4rem;
        height: 0.4rem;
        margin-left: -0.2rem;
        border: 1px solid var(--color-clay);
        border-radius: 50%;
        opacity: 0;
        transform: scale(0.4);
        transition: opacity 0.6s var(--ease-settle), transform 0.6s var(--ease-settle), background-color 0.6s var(--ease-settle);
    }

    .nav-wide li a:hover::after,
    .nav-wide li a[aria-current='page']::after {
        opacity: 1;
        transform: none;
    }

    .nav-wide li a[aria-current='page']::after {
        background: var(--color-clay);
    }

    .start {
        min-height: 2.75rem;
        padding: 0.55rem 1.25rem;
        font-size: 0.88rem;
    }

    summary {
        display: inline-flex;
        align-items: center;
        gap: var(--space-3);
        min-height: 2.75rem;
        padding: 0 var(--space-1) 0 var(--space-4);
        border: 1px solid color-mix(in srgb, var(--color-ink) 30%, transparent);
        border-radius: 999px;
        font-size: 0.85rem;
        font-weight: 650;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        list-style: none;
        cursor: pointer;
    }

    summary::-webkit-details-marker {
        display: none;
    }

    .menu-icon {
        position: relative;
        display: inline-block;
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 50%;
        background: var(--color-sage-mist);
    }

    .menu-icon span {
        position: absolute;
        left: 0.6rem;
        right: 0.6rem;
        height: 1px;
        background: var(--color-ink);
        transition: transform 0.6s var(--ease-settle);
    }

    .menu-icon span:first-child {
        top: 0.95rem;
    }

    .menu-icon span:last-child {
        top: 1.3rem;
    }

    .menu[open] .menu-icon span:first-child {
        transform: translateY(0.175rem) rotate(45deg);
    }

    .menu[open] .menu-icon span:last-child {
        transform: translateY(-0.175rem) rotate(-45deg);
    }

    .nav-narrow {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        height: calc(100dvh - var(--header-height));
        padding: var(--space-8) var(--gutter) var(--space-12);
        overflow-y: auto;
        background: var(--color-sand);
    }

    .nav-narrow li + li {
        border-top: 1px solid var(--color-line);
    }

    .nav-narrow li a {
        display: block;
        padding: var(--space-3) 0;
        color: var(--color-ink);
        font-family: var(--font-serif);
        font-size: 2rem;
        font-weight: 350;
        line-height: 1.3;
        text-decoration: none;
    }

    .nav-narrow li a[aria-current='page'] {
        color: var(--color-clay-ink);
        font-style: italic;
    }

    .nav-narrow .actions {
        margin-top: var(--space-8);
    }

    @media (min-width: 68rem) {
        .nav-wide {
            display: flex;
        }

        .menu {
            display: none;
        }
    }
</style>
