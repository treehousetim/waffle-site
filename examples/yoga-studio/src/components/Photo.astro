---
/**
 * A photograph: from src/data/photos.ts by name, or any imported image with
 * its alt text. Astro's <Picture> serves AVIF with a WebP fallback, at the
 * sizes the layout needs, with a width and a height so the page does not
 * shift. The one way a page shows a photo.
 *
 * `priority` is for the one image at the top of a page: loaded straight
 * away instead of lazily, at high priority. `decorative` empties the alt
 * text where a link or caption beside the photo already says it all.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { photos, type PhotoName } from '../data/photos';

type Props = {
    /** How wide it is drawn, for the browser to pick a size: a CSS sizes value. */
    sizes?: string;
    priority?: boolean;
    decorative?: boolean;
    class?: string;
} & ({ name: PhotoName } | { src: ImageMetadata; alt: string });

const { sizes = '(min-width: 64rem) 50vw, 100vw', priority = false, decorative = false, class: className } = Astro.props;
const { src, alt } = 'name' in Astro.props ? photos[Astro.props.name] : Astro.props;
---

<Picture
    src={src}
    alt={decorative ? '' : alt}
    formats={['avif', 'webp']}
    layout="constrained"
    width={Math.min(src.width, 1600)}
    sizes={sizes}
    quality={68}
    priority={priority}
    class={className}
/>
