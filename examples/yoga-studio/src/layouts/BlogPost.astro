---
/**
 * The one template every journal post uses (docs/blog.md): the headline set
 * large and light, the picture (the post's cover, or its topic's photo) in
 * a wide soft frame, the article in a narrow column, who wrote it, an
 * invitation, and more to read. A thread on the left fills as you read.
 */
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from './Base.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Photo from '../components/Photo.astro';
import PostList from '../components/PostList.astro';
import { site } from '../site';
import { settings } from '@core/settings';
import { defaultPostPhoto, photos, topicPhotos } from '../data/photos';
import { teachers, teacherUrl } from '../data/teachers';
import { blogPosting } from '@core/lib/jsonld.js';
import { absoluteUrl, canonicalUrl } from '@core/lib/seo.js';
import { readingMinutes, tagSlug } from '@core/lib/posts.js';

interface Props {
    post: CollectionEntry<'blog'>;
    related: CollectionEntry<'blog'>[];
}

const { post, related } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover, coverAlt, draft } = post.data;
const author = post.data.author ?? site.blog.defaultAuthor;
const teacher = teachers.find((person) => person.name === author);
const url = canonicalUrl(Astro.url.pathname, settings.siteUrl);
const firstTag = tags[0];
const topicPhoto = (firstTag !== undefined ? topicPhotos[tagSlug(firstTag)] : undefined) ?? defaultPostPhoto;

// The link preview: the cover, or the topic photo, cropped to 1200x630.
const preview = await getImage({ src: cover ?? photos[topicPhoto].src, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const image = { src: absoluteUrl(preview.src, settings.siteUrl), alt: cover !== undefined ? (coverAlt ?? '') : photos[topicPhoto].alt };
---

<Base
    title={title}
    description={description}
    type="article"
    image={image}
    breadcrumbs={[
        { name: site.blog.title, href: '/blog/' },
        { name: title, href: Astro.url.pathname },
    ]}
    article={{ published: pubDate, updated: updatedDate, tags }}
    jsonLd={[
        blogPosting(
            { url, title, description, image: image.src, published: pubDate, updated: updatedDate, author, tags },
            settings.siteUrl,
        ),
    ]}
>
    <div class="reading-thread" aria-hidden="true"></div>
    <article class="post">
        <header class="head page-head">
            <div class="copy">
                <p class="crumbs label">
                    <a href="/blog/">{site.blog.title}</a>
                    {firstTag && (
                        <>
                            <span aria-hidden="true">·</span>
                            <a href={`/blog/tags/${tagSlug(firstTag)}/`}>{firstTag}</a>
                        </>
                    )}
                </p>
                {draft && <p class="draft">Draft: not published in production.</p>}
                <h1>{title}</h1>
                <p class="lead">{description}</p>
                <p class="meta">
                    <span>
                        By {teacher ? <a href={teacherUrl(teacher.slug)}>{author}</a> : <strong>{author}</strong>}
                    </span>
                    <span>
                        <FormattedDate date={pubDate} /> · {readingMinutes(post.body ?? '')} min read
                        {updatedDate && (
                            <>
                                {' '}
                                · Updated <FormattedDate date={updatedDate} />
                            </>
                        )}
                    </span>
                </p>
            </div>
        </header>

        <figure class="cover">
            <div class="cover-frame">
                {
                    cover && coverAlt ? (
                        <Photo src={cover} alt={coverAlt} sizes="(min-width: 80rem) 76rem, 100vw" priority class="parallax" />
                    ) : (
                        <Photo name={topicPhoto} sizes="(min-width: 80rem) 76rem, 100vw" priority class="parallax" />
                    )
                }
            </div>
        </figure>

        <div class="prose body">
            <slot />
        </div>

        <footer class="prose foot">
            {
                tags.length > 0 && (
                    <ul class="tags" aria-label="Topics">
                        {tags.map((tag) => (
                            <li>
                                <a href={`/blog/tags/${tagSlug(tag)}/`}>{tag}</a>
                            </li>
                        ))}
                    </ul>
                )
            }

            <div class="invite">
                <p class="invite-title">Practise it with us</p>
                <p class="muted">New to the studio? Three weeks of every class for $40, from your first visit.</p>
                <p class="actions">
                    <a class="button" href={site.cta.href}>{site.cta.label}</a>
                    <a class="button button-quiet" href="/schedule/">This week's classes</a>
                </p>
            </div>
        </footer>
    </article>

    {
        related.length > 0 && (
            <section class="related">
                <div class="container">
                    <h2>Keep <em>reading</em></h2>
                    <PostList posts={related} level="h3" />
                </div>
            </section>
        )
    }
</Base>

<style>
    .head {
        width: min(100% - 2 * var(--gutter), 60rem);
        margin-inline: auto;
        padding: clamp(3rem, 2rem + 5vw, 7rem) 0 var(--space-12);
    }

    .crumbs {
        gap: var(--space-2);
    }

    .crumbs a {
        color: inherit;
        text-decoration: none;
    }

    .crumbs a:hover {
        color: var(--color-clay-ink);
    }

    .draft {
        display: inline-block;
        padding: 0.15rem 0.75rem;
        border-radius: 999px;
        background: var(--color-clay-mist);
        color: var(--color-clay-ink);
        font-weight: 700;
    }

    h1 {
        font-size: clamp(2.75rem, 1.6rem + 4.6vw, 6rem);
    }

    .meta {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-1) var(--space-6);
        margin: var(--space-8) 0 0;
        padding-top: var(--space-5);
        border-top: 1px solid var(--color-line);
        color: var(--color-muted);
        font-size: 0.95rem;
    }

    .meta a {
        font-weight: 700;
    }

    .cover {
        width: min(100% - 2 * var(--gutter), 76rem);
        margin: 0 auto;
    }

    .cover-frame {
        overflow: hidden;
        aspect-ratio: 16 / 8;
        border-radius: 999px 999px var(--radius) var(--radius);
        background: var(--color-sand-deep);
    }

    .cover-frame :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    @media (max-width: 40rem) {
        .cover-frame {
            aspect-ratio: 4 / 3;
            border-radius: 50% 50% var(--radius) var(--radius) / 30% 30% var(--radius) var(--radius);
        }
    }

    .body {
        margin-top: var(--space-16);
        font-size: 1.125rem;
        line-height: 1.8;
    }

    .body > :global(p:first-child) {
        font-family: var(--font-serif);
        font-size: clamp(1.5rem, 1.3rem + 0.8vw, 1.9rem);
        font-weight: 400;
        line-height: 1.45;
    }

    .foot {
        margin-top: var(--space-16);
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin: 0 0 var(--space-12);
        padding: 0;
        list-style: none;
    }

    .tags a {
        display: inline-block;
        padding: 0.3rem 1rem;
        border: 1px solid var(--color-line);
        border-radius: 999px;
        color: var(--color-ink);
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        transition: border-color 0.6s var(--ease-settle), background-color 0.6s var(--ease-settle);
    }

    .tags a:hover {
        border-color: var(--color-sage-deep);
        background: var(--color-sage-mist);
    }

    .invite {
        padding: var(--space-10) 0;
        border-top: 1px solid var(--color-ink);
        border-bottom: 1px solid var(--color-line);
    }

    .invite-title {
        margin-bottom: var(--space-2);
        font-family: var(--font-serif);
        font-size: 2rem;
        font-style: italic;
        line-height: 1.2;
    }

    .invite .actions {
        margin-top: var(--space-6);
    }

    .related {
        padding: var(--section) 0;
    }

    .related h2 {
        margin-bottom: var(--space-10);
    }
</style>
