---
/**
 * The gallery: a film strip that runs sideways as the page scrolls down
 * (scroll-driven, CSS only; where the browser cannot, or motion is not
 * wanted, it is a strip you swipe), then a wall of details.
 *
 * The example photos are Unsplash stand-ins (src/data/photos.ts). A real
 * detailer's gallery is its own work, captioned with the car, the package
 * and the zone: replace them before launch.
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Band from '../components/Band.astro';
import Photo from '../components/Photo.astro';
import Closing from '../components/Closing.astro';
import type { PhotoName } from '../data/photos';

const strip: { photo: PhotoName; caption: string }[] = [
    { photo: 'garageBlackCoupe', caption: 'Under the strip lights' },
    { photo: 'foamGreySuv', caption: 'Snow foam, first' },
    { photo: 'polisherCloseup', caption: 'Taped, then polished' },
    { photo: 'handWaxGarage', caption: 'Panel by panel' },
    { photo: 'headlightDark', caption: 'Lights, restored' },
    { photo: 'tireBrush', caption: 'Wheels get their own brushes' },
    { photo: 'silverNight', caption: 'The finish, at night' },
    { photo: 'quiltedInterior', caption: 'Leather, conditioned' },
];

const wall: { photo: PhotoName; caption: string; wide?: boolean }[] = [
    { photo: 'polisherBlueHood', caption: 'Correction on deep blue', wide: true },
    { photo: 'keysLeatherSeat', caption: 'Seats, extracted and dried' },
    { photo: 'microfiberDarkHood', caption: 'Plush towels only' },
    { photo: 'redBlackInterior', caption: 'Every seam steamed' },
    { photo: 'dashboardBrush', caption: 'Soft brushes for old wood', wide: true },
    { photo: 'sandingPaint', caption: 'Rotary polishing a white panel' },
    { photo: 'redCoupeRain', caption: 'Beading after a sealant', wide: true },
];
---

<Base
    title="Gallery: detailing work up close"
    description="Close-ups of mobile detailing in progress: snow foam, paint correction, ceramic coating, wheels and interiors, as Gloss Theory works on them."
    breadcrumbs={[{ name: 'Gallery', href: '/gallery/' }]}
>
    <PageHero
        eyebrow="Gallery"
        heading="Up close"
        lead="Detailing is a close-up job. Scroll to run the film strip, and see the work the way we see it: one panel, one seam, one wheel at a time."
    >
        <p class="stand-in spec">Example photographs from Unsplash, credited on the credits page.</p>
    </PageHero>

    <section class="film" aria-label="Film strip">
        <div class="film-sticky">
            <ul class="film-track">
                {
                    strip.map((frame, index) => (
                        <li>
                            <figure>
                                <Photo name={frame.photo} sizes="(min-width: 64rem) 34vw, 80vw" />
                                <figcaption>
                                    <span class="spec num">{String(index + 1).padStart(2, '0')}</span>
                                    <span>{frame.caption}</span>
                                </figcaption>
                            </figure>
                        </li>
                    ))
                }
            </ul>
        </div>
    </section>

    <Band index="02" eyebrow="Details" heading="The small things" tone="raised">
        <ul class="wall">
            {
                wall.map((tile) => (
                    <li class:list={{ wide: tile.wide }}>
                        <figure>
                            <Photo name={tile.photo} sizes="(min-width: 64rem) 50vw, 100vw" />
                            <figcaption class="spec">{tile.caption}</figcaption>
                        </figure>
                    </li>
                ))
            }
        </ul>
    </Band>

    <Closing />
</Base>

<style>
    .stand-in {
        color: var(--color-subtle);
        font-size: 0.68rem;
    }

    .film {
        position: relative;
        border-block: 1px solid var(--color-line);
        background:
            repeating-linear-gradient(90deg, rgb(255 255 255 / 0.12) 0 10px, transparent 10px 26px) top / 100% 8px no-repeat,
            repeating-linear-gradient(90deg, rgb(255 255 255 / 0.12) 0 10px, transparent 10px 26px) bottom / 100% 8px no-repeat,
            var(--color-raised);
    }

    .film-sticky {
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scrollbar-width: thin;
    }

    .film-track {
        display: flex;
        gap: var(--space-4);
        width: max-content;
        margin: 0;
        padding: var(--space-10) var(--gutter);
        list-style: none;
    }

    .film-track li {
        scroll-snap-align: center;
    }

    figure {
        position: relative;
        margin: 0;
    }

    .film-track figure {
        width: min(78vw, 30rem);
        overflow: hidden;
        border-radius: var(--radius);
        border: 1px solid var(--color-line-strong);
    }

    .film-track :global(img) {
        width: 100%;
        aspect-ratio: 4 / 5;
        object-fit: cover;
    }

    .film-track figcaption {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        gap: var(--space-3);
        align-items: baseline;
        padding: var(--space-10) var(--space-5) var(--space-4);
        background: linear-gradient(0deg, rgb(5 6 7 / 0.9), transparent);
        font-weight: 750;
        font-stretch: 112%;
    }

    .num {
        color: var(--color-cyan);
    }

    /* Where the browser can, the strip runs sideways as the page scrolls down. */
    @media (prefers-reduced-motion: no-preference) {
        @supports (animation-timeline: view()) {
            .film {
                height: 320vh;
                view-timeline-name: --film;
            }

            .film-sticky {
                position: sticky;
                top: var(--header-height);
                display: flex;
                align-items: center;
                height: calc(100vh - var(--header-height));
                overflow: hidden;
            }

            .film-track {
                animation: film-run linear both;
                animation-timeline: --film;
                animation-range: contain 0% contain 100%;
            }

            .film-track figure {
                width: min(78vw, calc((100vh - var(--header-height) - 7rem) * 0.8), 30rem);
            }

            @keyframes film-run {
                from { transform: translateX(0); }
                to { transform: translateX(calc(-100% + 100vw)); }
            }
        }
    }

    .wall {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
        grid-auto-flow: dense;
        gap: var(--space-4);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    @media (min-width: 64rem) {
        .wall .wide {
            grid-column: span 2;
        }
    }

    .wall figure {
        height: 100%;
        overflow: hidden;
        border-radius: var(--radius);
    }

    .wall :global(img) {
        width: 100%;
        height: 100%;
        min-height: 18rem;
        object-fit: cover;
        transition: transform 0.8s var(--ease-out);
    }

    .wall figure:hover :global(img) {
        transform: scale(1.04);
    }

    .wall figcaption {
        position: absolute;
        left: var(--space-4);
        bottom: var(--space-4);
        padding: 0.25rem 0.55rem;
        border-radius: var(--radius-small);
        background: rgb(5 6 7 / 0.7);
        color: var(--color-text);
    }
</style>
