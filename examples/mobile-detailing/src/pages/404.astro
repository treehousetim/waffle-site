---
/**
 * Served by Caddy, with status 404, for any path that is not in the build
 * (docker/caddy/Caddyfile). Kept out of search results (src/site.ts).
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Band from '../components/Band.astro';
import { packageCopy } from '../data/packages';
import { packageUrl } from '../lib/catalog';
---

<Base title="Page not found" description="That page is not here. It may have moved, or the link may be mistyped. Try the packages, the service zones or the booking form instead.">
    <PageHero
        eyebrow="Error 404"
        heading="Nothing to polish here"
        lead="This page has moved, or the link has a typo in it. One of these is probably what you were after."
        primary={{ label: 'Go to the home page', href: '/' }}
        secondary={{ label: 'Book a detail', href: '/book/' }}
    />
    <Band index="01" eyebrow="Packages" heading="Popular pages">
        <ul class="links">
            {
                packageCopy.map((item) => (
                    <li>
                        <a class="arrow-link" href={packageUrl(item.slug)}>{item.title}</a>
                    </li>
                ))
            }
            <li><a class="arrow-link" href="/zones/">Service zones</a></li>
            <li><a class="arrow-link" href="/faq/">Questions, answered</a></li>
        </ul>
    </Band>
</Base>

<style>
    .links {
        display: grid;
        gap: var(--space-4);
        margin: 0;
        padding: 0;
        list-style: none;
    }
</style>
