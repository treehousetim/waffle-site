---
/**
 * The one template every journal post uses (docs/blog.md): the headline in
 * chrome, the picture (the post's cover, or its topic's photo), the
 * article, who wrote it, a way to book what it describes, and more to read.
 * A thin cyan bar tracks reading progress (motion.css).
 */
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from './Base.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Photo from '../components/Photo.astro';
import PostGrid from '../components/PostGrid.astro';
import { site } from '../site';
import { settings } from '@core/settings';
import { defaultPostPhoto, photos, topicPhotos } from '../data/photos';
import { blogPosting } from '@core/lib/jsonld.js';
import { absoluteUrl, canonicalUrl } from '@core/lib/seo.js';
import { readingMinutes, tagSlug } from '@core/lib/posts.js';

interface Props {
    post: CollectionEntry<'blog'>;
    related: CollectionEntry<'blog'>[];
}

const { post, related } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover, coverAlt, draft } = post.data;
const author = post.data.author ?? site.blog.defaultAuthor;
const url = canonicalUrl(Astro.url.pathname, settings.siteUrl);
const firstTag = tags[0];
const topicPhoto = (firstTag !== undefined ? topicPhotos[tagSlug(firstTag)] : undefined) ?? defaultPostPhoto;

// The link preview: the cover, or the topic photo, cropped to 1200x630.
const preview = await getImage({ src: cover ?? photos[topicPhoto].src, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const image = { src: absoluteUrl(preview.src, settings.siteUrl), alt: cover !== undefined ? (coverAlt ?? '') : photos[topicPhoto].alt };
---

<Base
    title={title}
    description={description}
    type="article"
    image={image}
    breadcrumbs={[
        { name: site.blog.title, href: '/blog/' },
        { name: title, href: Astro.url.pathname },
    ]}
    article={{ published: pubDate, updated: updatedDate, tags }}
    jsonLd={[
        blogPosting(
            { url, title, description, image: image.src, published: pubDate, updated: updatedDate, author, tags },
            settings.siteUrl,
        ),
    ]}
>
    <div class="reading-progress" aria-hidden="true"></div>
    <article class="post">
        <header class="head">
            <p class="crumbs spec">
                <a href="/blog/">{site.blog.title}</a>
                {firstTag && (
                    <>
                        <span aria-hidden="true">/</span>
                        <a href={`/blog/tags/${tagSlug(firstTag)}/`}>{firstTag}</a>
                    </>
                )}
            </p>
            {draft && <p class="draft spec">Draft: not published in production.</p>}
            <h1 class="chrome">{title}</h1>
            <p class="lead">{description}</p>
            <p class="meta spec">
                <span>{author}</span>
                <span><FormattedDate date={pubDate} /></span>
                <span>{readingMinutes(post.body ?? '')} min read</span>
                {updatedDate && (
                    <span>
                        Updated <FormattedDate date={updatedDate} />
                    </span>
                )}
            </p>
        </header>

        <figure class="cover">
            {
                cover && coverAlt ? (
                    <Photo src={cover} alt={coverAlt} sizes="(min-width: 72rem) 72rem, 100vw" priority />
                ) : (
                    <Photo name={topicPhoto} sizes="(min-width: 72rem) 72rem, 100vw" priority />
                )
            }
        </figure>

        <div class="prose body">
            <slot />
        </div>

        <footer class="prose foot">
            {
                tags.length > 0 && (
                    <ul class="tags" aria-label="Topics">
                        {tags.map((tag) => (
                            <li>
                                <a href={`/blog/tags/${tagSlug(tag)}/`}>{tag}</a>
                            </li>
                        ))}
                    </ul>
                )
            }

            <div class="help">
                <p class="help-title">Rather we did it for you?</p>
                <p class="muted">We come to your driveway or office lot with our own water and power. Tell us the car and a few days that suit.</p>
                <p class="actions">
                    <a class="button" href={site.cta.href}>{site.cta.label}</a>
                    <a class="button button-ghost" href="/packages/">See the packages</a>
                </p>
            </div>
        </footer>
    </article>

    {
        related.length > 0 && (
            <section class="related">
                <div class="container">
                    <p class="eyebrow">Keep reading</p>
                    <h2 class="chrome">More from the journal</h2>
                    <PostGrid posts={related} level="h3" shape="tile" />
                </div>
            </section>
        )
    }
</Base>

<style>
    .post {
        padding-top: clamp(2.5rem, 2rem + 3vw, 5rem);
    }

    .head {
        width: min(100% - 2 * var(--gutter), 60rem);
        margin-inline: auto;
    }

    .crumbs {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin-bottom: var(--space-6);
        color: var(--color-subtle);
    }

    .crumbs a {
        color: var(--color-cyan);
        text-decoration: none;
    }

    .draft {
        color: var(--color-error);
    }

    h1 {
        font-size: clamp(2rem, 1.2rem + 3.4vw, 4rem);
        font-stretch: 118%;
        line-height: 1;
        text-transform: none;
    }

    .meta {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2) var(--space-5);
        margin: var(--space-8) 0 0;
        padding-top: var(--space-5);
        border-top: 1px solid var(--color-line);
        color: var(--color-muted);
    }

    .meta span:first-child {
        color: var(--color-text);
    }

    .cover {
        width: min(100% - 2 * var(--gutter), 72rem);
        margin: var(--space-12) auto 0;
        overflow: hidden;
        border-radius: var(--radius);
        clip-path: polygon(0 0, calc(100% - var(--cut) * 2) 0, 100% calc(var(--cut) * 2), 100% 100%, 0 100%);
    }

    .cover :global(img) {
        width: 100%;
        aspect-ratio: 21 / 9;
        object-fit: cover;
    }

    .body {
        margin-top: var(--space-12);
        font-size: 1.12rem;
        line-height: 1.75;
    }

    .foot {
        margin-top: var(--space-12);
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin: 0 0 var(--space-10);
        padding: 0;
        list-style: none;
    }

    .tags a {
        display: inline-block;
        padding: 0.35rem 0.75rem;
        border: 1px solid var(--color-line-strong);
        border-radius: var(--radius-small);
        color: var(--color-text);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.06em;
        text-decoration: none;
        text-transform: uppercase;
    }

    .tags a:hover {
        border-color: var(--color-cyan);
        color: var(--color-cyan);
    }

    .help {
        padding: var(--space-8);
        border: 1px solid rgb(46 230 255 / 0.3);
        border-radius: var(--radius);
        background: radial-gradient(30rem 12rem at 0% 0%, rgb(46 230 255 / 0.12), transparent 70%), var(--color-raised);
    }

    .help-title {
        margin-bottom: var(--space-2);
        font-size: 1.2rem;
        font-weight: 850;
        font-stretch: 125%;
        text-transform: uppercase;
    }

    .help .actions {
        margin: var(--space-5) 0 0;
    }

    .related {
        margin-top: var(--section);
        padding: var(--section) 0;
        border-top: 1px solid var(--color-line);
        background: linear-gradient(180deg, var(--color-raised), var(--color-bg));
    }

    .related h2 {
        margin-bottom: var(--space-10);
    }
</style>
