---
/**
 * The service zones on a drawn map of Port Alder: the bay to the west, the
 * lake to the north-east, each zone a shape you can click, and the vans'
 * route from the yard through every zone. As the map scrolls into view the
 * route draws itself, like a van's line on a dispatch screen (motion.css,
 * .route); each stop pulses gently.
 *
 * Hovering a zone in the list beside the map lights it on the map (CSS
 * :has, by position, so the list and the map must stay in the same order).
 * The map is an illustration; the list carries the same links in text.
 */
import { yard, zones, zoneUrl } from '../data/zones';

interface Props {
    /** The zone this page is about, lit on the map. */
    current?: string;
    /** Show the list of zones beside the map. */
    legend?: boolean;
}

const { current, legend = true } = Astro.props;

type Point = [number, number];

/** A smooth line through the points (Catmull-Rom, as cubic Béziers). */
function smooth(points: Point[]): string {
    const [first] = points;

    if (first === undefined) {
        return '';
    }

    let d = `M${first[0]} ${first[1]}`;

    for (let i = 0; i < points.length - 1; i++) {
        const p0 = points[Math.max(0, i - 1)] ?? first;
        const p1 = points[i] ?? first;
        const p2 = points[i + 1] ?? first;
        const p3 = points[Math.min(points.length - 1, i + 2)] ?? p2;
        const c1: Point = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
        const c2: Point = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
        d += ` C${c1[0].toFixed(1)} ${c1[1].toFixed(1)} ${c2[0].toFixed(1)} ${c2[1].toFixed(1)} ${p2[0]} ${p2[1]}`;
    }

    return d;
}

// The day's loop: out of the yard, round the city, home again.
const order = ['cinder-hill', 'old-harbor', 'fenwick-park', 'brightwater', 'northgate'];
const stops = order.map((slug) => zones.find((zone) => zone.slug === slug)).filter((zone) => zone !== undefined);
const route = smooth([yard, ...stops.map((zone) => zone.map.stop), yard]);
---

<div class:list={['zone-map', { 'with-legend': legend }]}>
    <figure class="map">
        <svg viewBox="0 0 800 520" role="group" aria-label="Map of Port Alder's five service zones and the vans' daily route from the yard">
            <defs>
                <pattern id="zone-grid" width="20" height="20" patternUnits="userSpaceOnUse">
                    <path d="M20 0H0V20" fill="none" stroke="rgb(214 228 240 / 0.05)" stroke-width="1" />
                </pattern>
                <linearGradient id="zone-water" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="#062a33" />
                    <stop offset="1" stop-color="#03141a" />
                </linearGradient>
            </defs>

            <rect width="800" height="520" fill="url(#zone-grid)" />
            <path class="water" d="M0 0H150C128 70 152 140 120 210 92 272 128 330 104 400 88 450 112 490 96 520H0Z" fill="url(#zone-water)" />
            <ellipse class="water" cx="668" cy="160" rx="62" ry="40" fill="url(#zone-water)" />
            <path class="road" d="M150 260H780M372 20V500M120 120C300 160 500 120 790 280M200 500C300 380 520 300 720 470" />
            <text class="water-label" x="34" y="270">Alder Bay</text>
            <text class="water-label" x="636" y="164">Bright Lake</text>

            {
                zones.map((zone) => (
                    <a class:list={['area', { current: zone.slug === current }]} href={zoneUrl(zone.slug)} aria-label={zone.name}>
                        <polygon points={zone.map.points} />
                        <text x={zone.map.label[0]} y={zone.map.label[1]}>{zone.name.replace(' Business Park', '')}</text>
                    </a>
                ))
            }

            <path class="route-base" d={route} />
            <path class="route" d={route} pathLength="1" />

            {
                stops.map((zone) => (
                    <g class="stop" transform={`translate(${zone.map.stop[0]} ${zone.map.stop[1]})`}>
                        <circle class="ring" r="9" />
                        <circle class="dot" r="4" />
                    </g>
                ))
            }

            <g class="yard" transform={`translate(${yard[0]} ${yard[1]})`}>
                <rect x="-9" y="-9" width="18" height="18" transform="rotate(45)" />
                <text x="16" y="5">Yard</text>
            </g>
        </svg>
    </figure>

    {
        legend && (
            <ol class="legend">
                {zones.map((zone, index) => (
                    <li class:list={{ current: zone.slug === current }}>
                        <a href={zoneUrl(zone.slug)}>
                            <span class="spec num">{String(index + 1).padStart(2, '0')}</span>
                            <span class="name">{zone.name}</span>
                            <span class="spec days">{zone.days}</span>
                            <span class="summary">{zone.summary}</span>
                        </a>
                    </li>
                ))}
            </ol>
        )
    }
</div>

<style>
    .zone-map {
        display: grid;
        gap: var(--space-8);
    }

    @media (min-width: 64rem) {
        .with-legend {
            grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
            align-items: center;
        }
    }

    .map {
        margin: 0;
        overflow: hidden;
        border: 1px solid var(--color-line);
        border-radius: var(--radius);
        background: radial-gradient(circle at 50% 45%, #0d1217, #06080a 75%);
    }

    svg {
        width: 100%;
    }

    .road {
        fill: none;
        stroke: rgb(214 228 240 / 0.08);
        stroke-width: 6;
    }

    .water-label {
        fill: #4f8f9c;
        font-family: var(--font-mono);
        font-size: 13px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .area polygon {
        fill: rgb(214 228 240 / 0.04);
        stroke: rgb(214 228 240 / 0.35);
        stroke-width: 1.2;
        stroke-dasharray: 4 4;
        transition: fill 0.3s ease, stroke 0.3s ease;
    }

    .area text {
        fill: var(--color-text);
        font-family: var(--font-sans);
        font-size: 15px;
        font-stretch: 125%;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        pointer-events: none;
    }

    .area:hover polygon,
    .area:focus-visible polygon,
    .area.current polygon {
        fill: rgb(46 230 255 / 0.12);
        stroke: var(--color-cyan);
        stroke-dasharray: none;
    }

    .area:focus-visible {
        outline: none;
    }

    /* Hovering a zone in the list lights it on the map, by position. */
    .zone-map:has(.legend li:nth-child(1) a:is(:hover, :focus-visible)) .area:nth-of-type(1) polygon,
    .zone-map:has(.legend li:nth-child(2) a:is(:hover, :focus-visible)) .area:nth-of-type(2) polygon,
    .zone-map:has(.legend li:nth-child(3) a:is(:hover, :focus-visible)) .area:nth-of-type(3) polygon,
    .zone-map:has(.legend li:nth-child(4) a:is(:hover, :focus-visible)) .area:nth-of-type(4) polygon,
    .zone-map:has(.legend li:nth-child(5) a:is(:hover, :focus-visible)) .area:nth-of-type(5) polygon,
    .zone-map:has(.legend li:nth-child(6) a:is(:hover, :focus-visible)) .area:nth-of-type(6) polygon {
        fill: rgb(46 230 255 / 0.14);
        stroke: var(--color-cyan);
        stroke-dasharray: none;
    }

    .route-base {
        fill: none;
        stroke: rgb(46 230 255 / 0.14);
        stroke-width: 6;
        stroke-linecap: round;
    }

    .route {
        fill: none;
        stroke: var(--color-cyan);
        stroke-width: 2.5;
        stroke-linecap: round;
        stroke-dasharray: 1;
        stroke-dashoffset: 0;
        filter: drop-shadow(0 0 6px rgb(46 230 255 / 0.8));
    }

    .stop .dot {
        fill: var(--color-cyan);
    }

    .stop .ring {
        fill: none;
        stroke: var(--color-cyan);
        stroke-width: 1.5;
        opacity: 0.5;
        transform-box: fill-box;
        transform-origin: center;
    }

    .yard rect {
        fill: #ffffff;
    }

    .yard text {
        fill: #ffffff;
        font-family: var(--font-mono);
        font-size: 13px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .legend {
        display: grid;
        margin: 0;
        padding: 0;
        list-style: none;
        border-top: 1px solid var(--color-line);
    }

    .legend li {
        border-bottom: 1px solid var(--color-line);
    }

    .legend a {
        display: grid;
        grid-template-columns: 2.5rem 1fr;
        gap: 0.15rem var(--space-3);
        padding: var(--space-4) var(--space-2);
        color: var(--color-text);
        text-decoration: none;
        transition: background-color 0.25s ease;
    }

    .legend a:hover,
    .legend .current a {
        background: linear-gradient(90deg, var(--color-cyan-soft), transparent);
    }

    .num {
        grid-row: span 3;
        padding-top: 0.2rem;
        color: var(--color-cyan);
    }

    .name {
        font-weight: 800;
        font-stretch: 125%;
        text-transform: uppercase;
    }

    .days {
        color: var(--color-muted);
        font-size: 0.7rem;
    }

    .summary {
        color: var(--color-muted);
        font-size: 0.9rem;
        line-height: 1.45;
    }

    @media (max-width: 40rem) {
        .area text {
            font-size: 19px;
        }
    }
</style>
