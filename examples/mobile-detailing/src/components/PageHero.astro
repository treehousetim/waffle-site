---
/**
 * The top of every page but the home page, and the page's one <h1>.
 *
 * Copy on the left on a black studio floor, lit by a cyan glow and a strip
 * light; the photo, when there is one, stands on the right as a tall panel
 * with a chamfered corner and a chrome edge, and is the page's one eager
 * image. `transition` names the photo for the view transition from a card
 * on the previous page (motion.css lists the names).
 */
import Photo from './Photo.astro';
import type { PhotoName } from '../data/photos';

interface Action {
    label: string;
    href: string;
}

interface Props {
    eyebrow?: string;
    heading: string;
    lead?: string;
    photo?: PhotoName;
    primary?: Action;
    secondary?: Action;
    /** A class from motion.css that names the photo for a view transition. */
    transition?: string;
}

const { eyebrow, heading, lead, photo, primary, secondary, transition } = Astro.props;
---

<section class:list={['page-hero', { 'has-photo': photo !== undefined }]}>
    <span class="strip" aria-hidden="true"></span>
    <div class="container inner">
        <div class="copy">
            {eyebrow && <p class="eyebrow">{eyebrow}</p>}
            <h1 class="chrome">{heading}</h1>
            {lead && <p class="lead">{lead}</p>}
            <slot />
            {
                (primary || secondary) && (
                    <p class="actions">
                        {primary && <a class="button button-large" href={primary.href}>{primary.label}</a>}
                        {secondary && <a class="button button-ghost button-large" href={secondary.href}>{secondary.label}</a>}
                    </p>
                )
            }
        </div>
        {
            photo && (
                <figure class:list={['media', transition]}>
                    <Photo name={photo} priority sizes="(min-width: 64rem) 40vw, 100vw" />
                </figure>
            )
        }
    </div>
</section>

<style>
    .page-hero {
        position: relative;
        overflow: hidden;
        padding: clamp(3rem, 2rem + 4vw, 6rem) 0 clamp(3rem, 2rem + 4vw, 5.5rem);
        background: radial-gradient(42rem 22rem at 12% 0%, rgb(46 230 255 / 0.13), transparent 70%);
    }

    /* A strip light across the ceiling of the studio. */
    .strip {
        position: absolute;
        top: 0;
        left: 8%;
        right: 8%;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.65), transparent);
        box-shadow: 0 0 24px 2px rgb(255 255 255 / 0.25);
    }

    .inner {
        position: relative;
        display: grid;
        gap: var(--space-10);
        align-items: end;
    }

    .copy {
        max-width: 54rem;
    }

    h1 {
        margin-bottom: var(--space-6);
    }

    .actions {
        margin: var(--space-8) 0 0;
    }

    .media {
        position: relative;
        margin: 0;
        clip-path: polygon(0 0, calc(100% - var(--cut) * 2) 0, 100% calc(var(--cut) * 2), 100% 100%, 0 100%);
    }

    .media::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, transparent 55%, rgb(5 6 7 / 0.55));
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.35);
        pointer-events: none;
    }

    .media :global(img) {
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
    }

    @media (min-width: 64rem) {
        .has-photo .inner {
            grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.9fr);
        }

        .media :global(img) {
            aspect-ratio: 4 / 5;
            max-height: 36rem;
        }
    }
</style>
