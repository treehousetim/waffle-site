---
/**
 * The end of every long page: one line in huge chrome, the booking button
 * and the phone number, over a slow wet-paint shimmer and drifting water
 * beads (motion.css). The eye learns that a page ends here.
 */
import Bubbles from './Bubbles.astro';
import { site } from '../site';

interface Props {
    heading?: string;
    text?: string;
    action?: { label: string; href: string };
}

const {
    heading = 'Your driveway. Our gloss.',
    text = 'Tell us the car, the place and a few days that suit you. We reply within one working day with a time.',
    action = site.cta,
} = Astro.props;
---

<section class="closing">
    <Bubbles />
    <div class="container inner">
        <h2 class="chrome">{heading}</h2>
        <div class="side">
            <p class="lead">{text}</p>
            <p class="actions">
                <a class="button button-large" href={action.href}>{action.label}</a>
                <a class="button button-ghost button-large" href={`tel:${site.business.phoneE164}`}>{site.business.phone}</a>
            </p>
        </div>
    </div>
</section>

<style>
    .closing {
        position: relative;
        overflow: hidden;
        padding: clamp(5rem, 3rem + 8vw, 10rem) 0;
        border-top: 1px solid var(--color-line);
        background:
            radial-gradient(40rem 20rem at 85% 30%, rgb(46 230 255 / 0.16), transparent 70%),
            linear-gradient(180deg, var(--color-raised), var(--color-bg));
    }

    .inner {
        position: relative;
        display: grid;
        gap: var(--space-8);
        align-items: end;
    }

    h2 {
        margin: 0;
        font-size: clamp(2.25rem, 1rem + 5.4vw, 6rem);
        line-height: 0.92;
    }

    .actions {
        margin: var(--space-6) 0 0;
    }

    @media (min-width: 64rem) {
        .inner {
            grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
        }
    }
</style>
