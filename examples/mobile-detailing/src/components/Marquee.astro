---
/**
 * A slow ribbon of words in outlined extended type, sliding sideways like
 * reflections along a car's flank (motion.css, .marquee-track). The words
 * are written twice so the loop is seamless; the copy is hidden from
 * screen readers, and the whole thing is decoration around content that
 * says the same thing elsewhere.
 */
interface Props {
    words: string[];
}

const { words } = Astro.props;
---

<div class="marquee" aria-hidden="true">
    <div class="marquee-track">
        {
            [0, 1].map(() => (
                <ul>
                    {words.map((word) => (
                        <li>
                            <span>{word}</span>
                            <svg viewBox="0 0 24 24" width="22" height="22">
                                <path d="M12 3s-6 6.6-6 11a6 6 0 0 0 12 0c0-4.4-6-11-6-11z" />
                            </svg>
                        </li>
                    ))}
                </ul>
            ))
        }
    </div>
</div>

<style>
    .marquee {
        overflow: hidden;
        padding: var(--space-6) 0;
        border-block: 1px solid var(--color-line);
        background: var(--color-raised);
        mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    }

    .marquee-track {
        display: flex;
        width: max-content;
    }

    ul {
        display: flex;
        flex: none;
        gap: var(--space-8);
        margin: 0;
        padding: 0 var(--space-8) 0 0;
        list-style: none;
    }

    li {
        display: flex;
        align-items: center;
        gap: var(--space-8);
        white-space: nowrap;
    }

    span {
        color: transparent;
        font-size: clamp(1.6rem, 1rem + 2.5vw, 3rem);
        font-weight: 900;
        font-stretch: 125%;
        letter-spacing: 0.01em;
        text-transform: uppercase;
        -webkit-text-stroke: 1px rgb(214 228 240 / 0.55);
    }

    li:nth-child(odd) span {
        color: var(--color-text);
        -webkit-text-stroke: 0;
    }

    svg {
        fill: var(--color-cyan);
    }
</style>
