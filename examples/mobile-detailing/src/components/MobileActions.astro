---
/**
 * The bar fixed to the bottom of a phone's screen: call, or book. Most
 * people looking for a detailer are on a phone, often standing next to the
 * car. Hidden on wider screens, where the header carries both.
 */
import Icon from './Icon.astro';
import { site } from '../site';
---

<nav class="mobile-actions" aria-label="Quick actions">
    <a class="call" href={`tel:${site.business.phoneE164}`}>
        <Icon name="phone" size={18} />
        Call
    </a>
    <a class="book" href={site.cta.href}>
        {site.cta.label}
    </a>
</nav>

<style>
    .mobile-actions {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 25;
        display: grid;
        grid-template-columns: 1fr 1.6fr;
        gap: var(--space-2);
        padding: var(--space-3) var(--space-3) calc(var(--space-3) + env(safe-area-inset-bottom));
        background: rgb(5 6 7 / 0.9);
        border-top: 1px solid var(--color-line-strong);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
    }

    a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-2);
        min-height: 3.1rem;
        border-radius: var(--radius-small);
        font-size: 0.8rem;
        font-weight: 750;
        font-stretch: 125%;
        letter-spacing: 0.06em;
        text-decoration: none;
        text-transform: uppercase;
    }

    .call {
        border: 1px solid var(--color-line-strong);
        color: var(--color-text);
    }

    .call :global(svg) {
        color: var(--color-cyan);
    }

    .book {
        background: var(--color-cyan);
        color: var(--color-on-cyan);
    }

    @media (min-width: 40.01rem) {
        .mobile-actions {
            display: none;
        }
    }
</style>
