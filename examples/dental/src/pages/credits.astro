---
/**
 * Who took the photographs, and whose typefaces these are. The example
 * photos are from Unsplash, free under the Unsplash License; credit is not
 * required, but given. Kept out of search results (src/site.ts, noindex).
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { photos } from '../data/photos';

const credits = Object.values(photos);
---

<Base
    title="Photo credits"
    description="The photographers whose work appears on this site, with links to the originals, and the typefaces it uses. Photos are from Unsplash, under the Unsplash License."
    breadcrumbs={[{ name: 'Photo credits', href: '/credits/' }]}
>
    <PageHero eyebrow="Credits" heading="Photo credits" lead="With thanks to the photographers whose work appears on this site. The people in these photos are models, not our dentists or patients." />

    <div class="prose page">
        <p>Photographs from <a href="https://unsplash.com/">Unsplash</a>, used under the <a href="https://unsplash.com/license">Unsplash License</a>.</p>
        <ul>
            {
                credits.map((photo) => (
                    <li>
                        {photo.alt.replace(/\.$/, '')}: <a href={photo.credit.url}>{photo.credit.name}</a>
                    </li>
                ))
            }
        </ul>
        <p>Headings are set in <a href="https://github.com/hafontia/Fredoka-One">Fredoka</a>, by Milena Brandão, and text in <a href="https://github.com/erikdkennedy/figtree">Figtree</a>, by Erik Kennedy, both under the <a href="https://openfontlicense.org/">SIL Open Font License</a>.</p>
    </div>
</Base>

<style>
    .page {
        padding-bottom: var(--section);
    }
</style>
