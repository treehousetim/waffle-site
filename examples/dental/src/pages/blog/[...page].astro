---
/** /blog/, then /blog/2/ and on: every post the build shows, newest first. */
import type { GetStaticPaths, Page } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PostGrid from '../../components/PostGrid.astro';
import TopicList from '../../components/TopicList.astro';
import { site } from '../../site';
import { buildTime, settings } from '@core/settings';
import { tagIndex, visiblePosts } from '@core/lib/posts.js';

export const getStaticPaths = (async ({ paginate }) => {
    const posts = visiblePosts(await getCollection('blog'), { includeDrafts: !settings.production, now: buildTime });

    return paginate(posts, { pageSize: 6, props: { tags: tagIndex(posts) } });
}) satisfies GetStaticPaths;

interface Props {
    page: Page<CollectionEntry<'blog'>>;
    tags: ReturnType<typeof tagIndex>;
}

const { page, tags } = Astro.props;
const first = page.currentPage === 1;
// Page 2 and on need their own title and description (docs/seo.md, 12).
const title = first ? site.blog.title : `${site.blog.title}, page ${page.currentPage}`;
const description = first ? site.blog.description : `${site.blog.description} Page ${page.currentPage} of ${page.lastPage}.`;
---

<Base title={title} description={description} breadcrumbs={[{ name: site.blog.title, href: '/blog/' }]}>
    <PageHero
        eyebrow={first ? 'From the Brightside dentists' : `Page ${page.currentPage} of ${page.lastPage}`}
        heading={first ? 'Kind, plain advice for healthy smiles' : title}
        smile={first ? 'healthy smiles' : undefined}
        lead={site.blog.description}
    >
        <TopicList tags={tags} />
    </PageHero>

    <div class="container list">
        {page.data.length === 0 && <p>No posts yet.</p>}
        <PostGrid posts={page.data} feature={first} />

        {
            page.lastPage > 1 && (
                <nav class="pager" aria-label="More posts">
                    {page.url.prev ? <a class="button button-quiet" href={page.url.prev}>← Newer posts</a> : <span />}
                    <span class="count">Page {page.currentPage} of {page.lastPage}</span>
                    {page.url.next ? <a class="button button-quiet" href={page.url.next}>Older posts →</a> : <span />}
                </nav>
            )
        }
    </div>
</Base>

<style>
    .list {
        padding-bottom: var(--space-8);
    }

    .pager {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        margin-top: var(--space-16);
    }

    .count {
        color: var(--color-muted);
        font-weight: 600;
    }
</style>
