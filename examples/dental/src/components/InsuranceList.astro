---
/**
 * The plans the practice accepts, from the waffle app (GET
 * /api/site/insurance, parsed by src/lib/insurance.ts), with a filter that
 * needs no script: three radio buttons and :has(). Without :has() every plan
 * simply shows. Then the ways to pay, with their prices.
 */
import Icon from './Icon.astro';
import { dollars, type InsuranceGuide } from '../lib/insurance';

interface Props {
    guide: InsuranceGuide;
}

const { guide } = Astro.props;
const inNetwork = guide.plans.filter((plan) => plan.network === 'in-network').length;
const outNetwork = guide.plans.length - inNetwork;
const updated = new Date(`${guide.updated}T00:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<div class="insurance">
    <div class="filters" role="radiogroup" aria-label="Show plans">
        <input type="radio" name="network-filter" id="filter-all" value="all" checked />
        <label for="filter-all">All plans <span>{guide.plans.length}</span></label>
        <input type="radio" name="network-filter" id="filter-in" value="in" />
        <label for="filter-in">In network <span>{inNetwork}</span></label>
        <input type="radio" name="network-filter" id="filter-out" value="out" />
        <label for="filter-out">Out of network <span>{outNetwork}</span></label>
    </div>

    <ul class="plans">
        {
            guide.plans.map((plan) => (
                <li class:list={['plan', plan.network]} data-plan={plan.id}>
                    <p class="badges">
                        <span class:list={['network', plan.network]}>
                            {plan.network === 'in-network' ? <Icon name="check" size={16} /> : <Icon name="shield" size={16} />}
                            {plan.network === 'in-network' ? 'In network' : 'Out of network'}
                        </span>
                        <span class="type">{plan.type}</span>
                    </p>
                    <h3 class="name">{plan.name}</h3>
                    <p class="note">{plan.note}</p>
                </li>
            ))
        }
    </ul>
    <p class="updated">The front desk last updated this list on {updated}. Plans change: we always check yours before your visit.</p>

    <h2 class="pay-heading" id="paying">Ways to pay</h2>
    <ul class="payments">
        {
            guide.payments.map((option) => (
                <li class="payment" data-payment={option.id}>
                    <span class="pay-icon">
                        <Icon name={option.price === null ? 'card' : option.price.per === 'year' ? 'heart' : 'calendar'} size={24} />
                    </span>
                    <h3>{option.name}</h3>
                    <p>{option.note}</p>
                    {option.price && (
                        <p class="price">
                            <span class="from">from</span> <strong>{dollars(option.price.cents)}</strong> <span class="per">a {option.price.per}</span>
                        </p>
                    )}
                </li>
            ))
        }
    </ul>
</div>

<style>
    .filters {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin-bottom: var(--space-8);
    }

    .filters input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .filters label {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        padding: 0.6rem 0.75rem 0.6rem 1.2rem;
        border-radius: var(--radius-pill);
        background: var(--color-surface);
        color: var(--color-forest);
        font-weight: 650;
        cursor: pointer;
        transition: background-color 0.6s var(--ease-calm);
    }

    .filters label span {
        min-width: 1.8rem;
        padding: 0 0.5rem;
        border-radius: var(--radius-pill);
        background: var(--color-bg);
        font-size: 0.9rem;
        text-align: center;
    }

    .filters label:hover {
        background: var(--color-mint-soft);
    }

    .filters input:checked + label {
        background: var(--color-mint);
    }

    .filters input:focus-visible + label {
        outline: 3px solid var(--color-focus);
        outline-offset: 3px;
    }

    .plans,
    .payments {
        display: grid;
        gap: var(--space-5);
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .insurance:has(#filter-in:checked) .plan.out-of-network,
    .insurance:has(#filter-out:checked) .plan.in-network {
        display: none;
    }

    .plan {
        padding: var(--space-6);
        border-radius: 2rem;
        background: var(--color-surface-raised);
        box-shadow: var(--shadow-soft);
    }

    .plan.out-of-network {
        background: transparent;
        box-shadow: inset 0 0 0 2px var(--color-border);
    }

    .badges {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin-bottom: var(--space-4);
    }

    .network,
    .type {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.2rem 0.75rem;
        border-radius: var(--radius-pill);
        font-size: 0.85rem;
        font-weight: 700;
    }

    .network.in-network {
        background: var(--color-mint);
        color: var(--color-forest);
    }

    .network.out-of-network {
        background: var(--color-butter);
        color: var(--color-forest);
    }

    .type {
        background: var(--color-surface);
        color: var(--color-muted);
    }

    .name {
        font-size: 1.35rem;
    }

    .note {
        margin: 0;
        color: var(--color-muted);
        font-size: 1rem;
    }

    .updated {
        margin: var(--space-6) 0 0;
        color: var(--color-muted);
        font-size: 0.95rem;
    }

    .pay-heading {
        margin: var(--section) 0 var(--space-10);
    }

    .payments {
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 13.5rem), 1fr));
    }

    .payment {
        display: flex;
        flex-direction: column;
        padding: var(--space-6);
        border-radius: 2.25rem;
        background: var(--color-coral-soft);
    }

    .payment:nth-child(even) {
        background: var(--color-butter-soft);
    }

    .pay-icon {
        display: inline-grid;
        place-items: center;
        width: 3rem;
        height: 3rem;
        margin-bottom: var(--space-4);
        border-radius: var(--blob-a);
        background: var(--color-bg);
        color: var(--color-coral-ink);
    }

    .payment p {
        color: #3f4c47;
        font-size: 1rem;
    }

    .price {
        margin: auto 0 0;
        color: var(--color-forest);
    }

    .price strong {
        font-family: var(--font-display);
        font-size: 2rem;
        font-weight: 600;
    }

    .from,
    .per {
        color: var(--color-muted);
        font-weight: 600;
    }
</style>
