---
/**
 * The top of every page but the home page: the page's one <h1>, an eyebrow,
 * a lead, up to two actions, and (when given) a photograph in a soft,
 * slowly breathing blob mask, with blobs drifting behind. One word of the
 * heading can wear a hand-drawn smile.
 *
 * `vt` names the photo for a view transition (motion.css), so a treatment's
 * card photo grows into its page's hero.
 */
import Photo from './Photo.astro';
import Blobs from './Blobs.astro';
import Smile from './Smile.astro';
import Sparkle from './Sparkle.astro';
import type { PhotoName } from '../data/photos';

interface Action {
    label: string;
    href: string;
}

interface Props {
    eyebrow?: string;
    heading: string;
    /** A word or phrase of the heading to underline with a smile. */
    smile?: string;
    lead?: string;
    photo?: PhotoName;
    /** The photo's mask: an organic blob, or an arch (portraits). */
    shape?: 'blob' | 'arch';
    /** A view-transition class from motion.css, e.g. vt-treatment-implants. */
    vt?: string;
    primary?: Action;
    secondary?: Action;
    tone?: 'mint' | 'coral' | 'butter';
}

const { eyebrow, heading, smile, lead, photo, shape = 'blob', vt, primary, secondary, tone = 'mint' } = Astro.props;
const at = smile !== undefined ? heading.indexOf(smile) : -1;
const before = at >= 0 ? heading.slice(0, at) : heading;
const after = at >= 0 && smile !== undefined ? heading.slice(at + smile.length) : '';
---

<section class:list={['page-hero', `tone-${tone}`, { 'has-photo': photo !== undefined }]}>
    <Blobs set="hero" />
    <div class="container inner">
        <div class="copy">
            {eyebrow && <p class="eyebrow">{eyebrow}</p>}
            <h1>
                {before}
                {
                    at >= 0 && (
                        <span class="smiled">
                            {smile}
                            <Smile />
                        </span>
                    )
                }
                {after}
            </h1>
            {lead && <p class="lead">{lead}</p>}
            {
                (primary || secondary) && (
                    <p class="actions">
                        {primary && (
                            <a class="button button-large" href={primary.href}>
                                {primary.label}
                            </a>
                        )}
                        {secondary && (
                            <a class="button button-quiet button-large" href={secondary.href}>
                                {secondary.label}
                            </a>
                        )}
                    </p>
                )
            }
            <slot />
        </div>
        {
            photo && (
                <div class="media">
                    <span class="halo" aria-hidden="true" />
                    <div class:list={['frame', shape, vt]}>
                        <Photo name={photo} sizes="(min-width: 64rem) 40vw, 90vw" priority />
                    </div>
                    <Sparkle class="hero-sparkle" />
                </div>
            )
        }
        {
            !photo && (
                <div class="mascot" aria-hidden="true">
                    <svg viewBox="0 0 48 48" focusable="false">
                        <path class="pebble" d="M24.6 3.2c8.7-.3 16.8 4.6 19.4 12.6 2.7 8.2-.6 17.6-7.8 22.9-7.4 5.5-18.3 6.4-25.4 1.2C3.6 34.7 1.7 25 4.8 17.2 7.6 9.6 15.8 3.5 24.6 3.2Z" />
                        <path class="grin" pathLength="1" d="M13.2 25.4c2.7 6 6.6 9 11 9s8.4-3 11-9" />
                    </svg>
                    <Sparkle class="hero-sparkle" />
                </div>
            )
        }
    </div>
</section>

<style>
    .page-hero {
        position: relative;
        isolation: isolate;
        overflow: clip;
        margin-top: calc(-1 * var(--header-height) - 0.75rem);
        padding: calc(var(--header-height) + clamp(3rem, 2rem + 4vw, 6rem)) 0 clamp(3.5rem, 2rem + 5vw, 7rem);
    }

    .inner {
        display: grid;
        gap: clamp(2.5rem, 1.5rem + 4vw, 5rem);
        align-items: center;
    }

    .copy {
        max-width: 44rem;
    }

    .copy > :last-child {
        margin-bottom: 0;
    }

    .lead {
        max-width: 36rem;
        margin-top: var(--space-8);
    }

    .actions {
        margin: var(--space-8) 0 0;
    }

    .media {
        position: relative;
        width: min(100%, 34rem);
        justify-self: center;
    }

    .halo {
        position: absolute;
        inset: 6% -6% -6% 8%;
        border-radius: var(--blob-b);
        background: var(--color-mint);
    }

    .tone-coral .halo {
        background: var(--color-coral-soft);
    }

    .tone-butter .halo {
        background: var(--color-butter);
    }

    .frame {
        position: relative;
        overflow: hidden;
        aspect-ratio: 1 / 1;
        border-radius: var(--blob-a);
        box-shadow: var(--shadow-lift);
    }

    .frame.arch {
        aspect-ratio: 4 / 5;
        border-radius: var(--arch);
    }

    .frame :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .media :global(.hero-sparkle) {
        position: absolute;
        top: -0.5rem;
        right: 8%;
        width: 2.75rem;
        color: var(--color-coral);
    }

    /* Pages without a photo get the practice's smiling pebble instead, on wide screens. */
    .mascot {
        position: relative;
        display: none;
        width: min(100%, 22rem);
        justify-self: end;
        margin-right: 4%;
    }

    .mascot svg {
        width: 100%;
        height: auto;
        overflow: visible;
    }

    .mascot .pebble {
        fill: var(--color-mint);
        transform-box: fill-box;
        transform-origin: 50% 50%;
    }

    .tone-coral .mascot .pebble {
        fill: var(--color-coral-soft);
    }

    .tone-butter .mascot .pebble {
        fill: var(--color-butter);
    }

    .mascot .grin {
        fill: none;
        stroke: var(--color-forest);
        stroke-width: 2.6;
        stroke-linecap: round;
    }

    .mascot :global(.hero-sparkle) {
        position: absolute;
        top: 2%;
        right: 6%;
        width: 3.5rem;
        color: var(--color-coral);
    }

    @media (min-width: 64rem) {
        .page-hero:not(.has-photo) .inner {
            grid-template-columns: 1.4fr 0.6fr;
        }

        .mascot {
            display: block;
        }

        .has-photo .inner {
            grid-template-columns: 1.15fr 0.85fr;
        }

        .media {
            justify-self: end;
        }
    }
</style>
