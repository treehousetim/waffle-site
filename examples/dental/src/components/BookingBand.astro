---
/**
 * The end of most pages: a warm coral panel with soft blobs drifting inside
 * it, the one action and the phone number, and when we are open.
 */
import Blobs from './Blobs.astro';
import Icon from './Icon.astro';
import { clock, dayList, site } from '../site';

interface Props {
    heading?: string;
    text?: string;
}

const {
    heading = 'Ready when you are',
    text = 'Book online in two minutes, or call and talk to Jo or Marcus at the front desk. No pressure, no lectures about flossing.',
} = Astro.props;
---

<section class="booking-band">
    <div class="container">
        <div class="panel">
            <Blobs set="band" />
            <div class="copy">
                <h2>{heading}</h2>
                <p>{text}</p>
                <p class="actions">
                    <a class="button button-forest button-large" href={site.cta.href}>
                        <Icon name="calendar" size={22} />
                        {site.cta.label}
                    </a>
                    <a class="button button-cream button-large" href={`tel:${site.business.phoneE164}`}>
                        <Icon name="phone" size={20} />
                        {site.business.phone}
                    </a>
                </p>
            </div>
            <ul class="hours" aria-label="Opening hours">
                {
                    site.business.hours.map((hours) => (
                        <li>
                            <span>{dayList(hours.days)}</span>
                            <strong>
                                {clock(hours.opens)} – {clock(hours.closes)}
                            </strong>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</section>

<style>
    .booking-band {
        padding-top: var(--section);
    }

    /* A band above already leaves room. */
    :global(.section) + .booking-band {
        padding-top: 0;
    }

    .panel {
        position: relative;
        isolation: isolate;
        overflow: clip;
        display: grid;
        gap: var(--space-10);
        align-items: center;
        padding: clamp(2.5rem, 1.5rem + 5vw, 5.5rem) clamp(1.5rem, 1rem + 4vw, 5rem);
        border-radius: clamp(2.5rem, 6vw, 5rem);
        background: var(--color-coral);
    }

    h2 {
        font-size: clamp(2.2rem, 1.5rem + 3vw, 4rem);
    }

    .copy p {
        max-width: 34rem;
        color: var(--color-forest);
        font-size: 1.15rem;
    }

    .actions {
        margin-top: var(--space-8);
    }

    .hours {
        display: grid;
        gap: var(--space-2);
        margin: 0;
        padding: var(--space-6);
        border-radius: 2rem;
        background: rgb(253 248 240 / 0.9);
        list-style: none;
    }

    .hours li {
        display: flex;
        justify-content: space-between;
        gap: var(--space-4);
        padding: var(--space-2) 0;
        color: var(--color-forest);
    }

    .hours li + li {
        border-top: 1px dashed var(--color-border-strong);
    }

    .hours strong {
        white-space: nowrap;
    }

    @media (min-width: 60rem) {
        .panel {
            grid-template-columns: 1.4fr 1fr;
        }
    }
</style>
