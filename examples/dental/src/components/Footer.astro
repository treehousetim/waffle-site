---
/**
 * The footer: the practice's name, address, phone and hours on every page,
 * written exactly as in src/site.ts, then the links. A forest-green ground
 * with a soft wave for a top edge, so every page ends the same calm way.
 */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { addressLine, clock, dayList, site } from '../site';
import { buildTime } from '@core/settings';
---

<footer class="site-footer">
    <svg class="wave" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M0 80V40c160-34 330-44 520-22 190 22 330 48 520 30 170-16 280-40 400-30v62Z" />
    </svg>
    <div class="ground">
        <div class="container grid">
            <div class="brand">
                <Logo tone="light" />
                <p class="tagline">{site.tagline}, in {site.business.address.city} since {site.business.founded}.</p>
                <address>
                    <span class="line"><Icon name="pin" size={20} /> {addressLine}</span>
                    <a class="line" href={`tel:${site.business.phoneE164}`}><Icon name="phone" size={20} /> {site.business.phone}</a>
                    <a class="line" href={`mailto:${site.business.email}`}><Icon name="mail" size={20} /> {site.business.email}</a>
                </address>
            </div>
            <div class="hours">
                <h2>Opening hours</h2>
                <dl>
                    {
                        site.business.hours.map((hours) => (
                            <div>
                                <dt>{dayList(hours.days)}</dt>
                                <dd>
                                    {clock(hours.opens)} – {clock(hours.closes)}
                                </dd>
                            </div>
                        ))
                    }
                </dl>
                <p class="emergency">{site.business.emergency}</p>
            </div>
            {
                site.footer.map((column) => (
                    <nav aria-label={column.heading}>
                        <h2>{column.heading}</h2>
                        <ul>
                            {column.links.map((link) => (
                                <li>
                                    <a href={link.href}>{link.label}</a>
                                </li>
                            ))}
                        </ul>
                    </nav>
                ))
            }
        </div>
        <div class="container legal">
            <p>© {buildTime.getUTCFullYear()} {site.business.legalName} · {site.business.licence}</p>
            <p><a href="/credits/">Photo credits</a> · <a href="/blog/rss.xml">RSS</a> · <a href="/privacy/">Privacy</a></p>
        </div>
    </div>
</footer>

<style>
    .site-footer {
        margin-top: calc(var(--section) * 0.75);
        color: var(--color-on-forest-muted);
        font-size: 1rem;
    }

    .wave {
        display: block;
        width: 100%;
        height: clamp(2.5rem, 5vw, 5rem);
        margin-bottom: -1px;
    }

    .wave path {
        fill: var(--color-forest);
    }

    .ground {
        padding: var(--space-12) 0 var(--space-8);
        background: var(--color-forest);
    }

    .grid {
        display: grid;
        gap: var(--space-10);
        grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    }

    .brand {
        grid-column: 1 / -1;
        max-width: 26rem;
    }

    @media (min-width: 68rem) {
        .grid {
            grid-template-columns: 1.5fr 1.35fr 1fr 1fr 1fr;
        }

        .brand {
            grid-column: auto;
        }
    }

    .tagline {
        margin: var(--space-5) 0;
    }

    address {
        display: grid;
        gap: var(--space-2);
        font-style: normal;
    }

    .line {
        display: inline-flex;
        align-items: flex-start;
        gap: var(--space-2);
        color: var(--color-on-forest);
        text-decoration: none;
    }

    .line :global(svg) {
        flex: none;
        margin-top: 0.2rem;
        color: var(--color-coral);
    }

    a.line:hover {
        color: #ffffff;
    }

    h2 {
        margin-bottom: var(--space-4);
        color: var(--color-on-forest);
        font-size: 1.2rem;
        font-weight: 500;
    }

    dl {
        display: grid;
        gap: var(--space-2);
        margin: 0;
    }

    dl div {
        display: flex;
        justify-content: space-between;
        gap: var(--space-4);
        padding-bottom: var(--space-2);
        border-bottom: 1px dashed rgb(185 207 198 / 0.3);
    }

    dt {
        color: var(--color-on-forest);
        font-weight: 600;
        white-space: nowrap;
    }

    dd {
        margin: 0;
        white-space: nowrap;
    }

    .emergency {
        margin-top: var(--space-4);
        color: var(--color-mint);
        font-size: 0.95rem;
    }

    ul {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    li + li {
        margin-top: var(--space-3);
    }

    nav a,
    .legal a {
        color: var(--color-on-forest-muted);
        text-decoration: none;
        transition: color 0.4s var(--ease-calm);
    }

    nav a:hover,
    .legal a:hover {
        color: #ffffff;
    }

    .legal {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: var(--space-4);
        margin-top: var(--space-16);
        padding-top: var(--space-6);
        border-top: 1px solid rgb(255 255 255 / 0.12);
        font-size: 0.9rem;
    }

    .legal p {
        margin: 0;
    }
</style>
