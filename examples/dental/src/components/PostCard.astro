---
/** One post, as a card: its cover in a soft rounded mask, its topic, title, summary and date. */
import type { CollectionEntry } from 'astro:content';
import Photo from './Photo.astro';
import FormattedDate from './FormattedDate.astro';
import { photos } from '../data/photos';

interface Props {
    post: CollectionEntry<'blog'>;
    level?: 'h2' | 'h3';
    large?: boolean;
}

const { post, level = 'h3', large = false } = Astro.props;
const { title, description, pubDate, tags, cover } = post.data;
const Heading = level;
const firstTag = tags[0];
---

<article class:list={['post-card', { large }]}>
    <span class="cover">
        {cover ? <Photo src={cover} alt="" sizes={large ? '(min-width: 64rem) 40rem, 100vw' : '(min-width: 64rem) 24rem, 100vw'} /> : <Photo src={photos.bambooBrushes.src} alt="" sizes="(min-width: 64rem) 24rem, 100vw" />}
    </span>
    <div class="body">
        {firstTag && <p class="topic">{firstTag}</p>}
        <Heading class="title">
            <a href={`/blog/${post.id}/`}>{title}</a>
        </Heading>
        <p class="summary">{description}</p>
        <p class="date">
            <FormattedDate date={pubDate} />
        </p>
    </div>
</article>

<style>
    .post-card {
        position: relative;
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 0.65rem 0.65rem var(--space-6);
        border-radius: 2.25rem;
        background: var(--color-surface-raised);
        box-shadow: var(--shadow-soft);
        transition: transform 0.9s var(--ease-calm), box-shadow 0.9s var(--ease-calm);
    }

    .post-card:hover,
    .post-card:focus-within {
        transform: translateY(-0.5rem);
        box-shadow: var(--shadow-lift);
    }

    .cover {
        display: block;
        overflow: hidden;
        aspect-ratio: 16 / 10;
        border-radius: 1.75rem;
    }

    .cover :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 1.4s var(--ease-calm);
    }

    .post-card:hover .cover :global(img) {
        transform: scale(1.05);
    }

    .body {
        display: flex;
        flex: 1;
        flex-direction: column;
        padding: var(--space-5) var(--space-4) 0;
    }

    .topic {
        align-self: flex-start;
        margin: 0 0 var(--space-3);
        padding: 0.2rem 0.75rem;
        border-radius: var(--radius-pill);
        background: var(--color-mint-soft);
        color: var(--color-mint-deep);
        font-size: 0.85rem;
        font-weight: 700;
    }

    .title {
        margin-bottom: var(--space-3);
        font-size: 1.4rem;
    }

    .large .title {
        font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.3rem);
    }

    .title a {
        color: var(--color-forest);
        text-decoration: none;
    }

    /* The whole card is the link's target. */
    .title a::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
    }

    .title a:focus-visible {
        outline: none;
    }

    .post-card:has(.title a:focus-visible) {
        outline: 3px solid var(--color-focus);
        outline-offset: 4px;
    }

    .summary {
        color: var(--color-muted);
        font-size: 1rem;
        line-height: 1.6;
    }

    .date {
        margin: auto 0 0;
        color: var(--color-muted);
        font-size: 0.9rem;
        font-weight: 600;
    }

    @media (min-width: 56rem) {
        .large {
            display: grid;
            grid-template-columns: 1.2fr 1fr;
            gap: var(--space-4);
            align-items: center;
        }

        .large .cover {
            aspect-ratio: 4 / 3;
            border-radius: var(--blob-a);
        }

        .large .body {
            padding: var(--space-6);
        }
    }
</style>
