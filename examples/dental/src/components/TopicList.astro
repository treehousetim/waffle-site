---
/** The blog's topics, as soft pills with their post counts. */
import type { tagIndex } from '@core/lib/posts.js';

interface Props {
    tags: ReturnType<typeof tagIndex>;
    current?: string;
}

const { tags, current } = Astro.props;
---

{
    tags.length > 0 && (
        <ul class="topics" aria-label="Topics">
            {tags.map((tag) => (
                <li>
                    <a href={`/blog/tags/${tag.slug}/`} aria-current={tag.slug === current ? 'page' : undefined}>
                        {tag.tag} <span>{tag.count}</span>
                    </a>
                </li>
            ))}
        </ul>
    )
}

<style>
    .topics {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin: var(--space-8) 0 0;
        padding: 0;
        list-style: none;
    }

    a {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        padding: 0.4rem 0.45rem 0.4rem 1rem;
        border-radius: var(--radius-pill);
        background: var(--color-surface-raised);
        color: var(--color-forest);
        font-size: 0.95rem;
        font-weight: 650;
        text-decoration: none;
        box-shadow: inset 0 0 0 1px var(--color-border);
        transition: background-color 0.5s var(--ease-calm);
    }

    a:hover,
    a[aria-current='page'] {
        background: var(--color-mint);
        color: var(--color-forest);
    }

    span {
        min-width: 1.6rem;
        padding: 0 0.45rem;
        border-radius: var(--radius-pill);
        background: var(--color-mint-soft);
        font-size: 0.85rem;
        text-align: center;
    }
</style>
