---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { site } from '../site';
---

<Base
    title="Privacy policy"
    description="What Ironwood Brewing Co. collects on this website, why, how long we keep it and how to ask us to delete it. Plain language, and no tracking cookies."
    breadcrumbs={[{ name: 'Privacy', href: '/privacy/' }]}
>
    <PageHead eyebrow="The small print" heading="Privacy policy" />

    <div class="prose page">
        <p class="muted">Example text. Replace it with your own policy before you launch.</p>
        <h2>What this website collects</h2>
        <p>This website sets no tracking cookies and runs no third-party analytics, maps or embeds. When you send the event enquiry form, we receive what you typed in it, so that we can reply, check the date and send a quote.</p>
        <h2>At the bar</h2>
        <p>We check ID to confirm you are 21 or over. We look at it; we do not scan, copy or keep it.</p>
        <h2>How long we keep it</h2>
        <p>Enquiries are kept for two years, and booking records for as long as tax rules require.</p>
        <h2>Your rights</h2>
        <p>Ask us to see, correct or delete anything we hold about you at <a href={`mailto:${site.business.email}`}>{site.business.email}</a>.</p>
    </div>
</Base>

<style>
    .page {
        padding-block: var(--space-12) var(--section);
    }
</style>
