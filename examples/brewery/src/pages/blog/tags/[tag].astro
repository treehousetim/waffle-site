---
/** /blog/tags/<tag>/ for every tag in use. */
import type { GetStaticPaths } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import PostGrid from '../../../components/PostGrid.astro';
import { site } from '../../../site';
import { buildTime, settings } from '@core/settings';
import { postsTagged, tagIndex, visiblePosts } from '@core/lib/posts.js';

export const getStaticPaths = (async () => {
    const posts = visiblePosts(await getCollection('blog'), { includeDrafts: !settings.production, now: buildTime });

    return tagIndex(posts).map((tag) => ({
        params: { tag: tag.slug },
        props: { name: tag.tag, posts: postsTagged(posts, tag.slug) },
    }));
}) satisfies GetStaticPaths;

interface Props {
    name: string;
    posts: CollectionEntry<'blog'>[];
}

const { name, posts } = Astro.props;
const count = posts.length === 1 ? 'one post' : `${posts.length} posts`;
---

<Base
    title={`Brewing notes on ${name}`}
    description={`Every Ironwood brewing note about ${name}: ${count}, newest first, from the brewers of a small-batch brewery in an old Ohio foundry.`}
    breadcrumbs={[
        { name: site.blog.title, href: '/blog/' },
        { name, href: Astro.url.pathname },
    ]}
>
    <PageHead eyebrow={`Topic · ${count}`} heading={`Notes on ${name}`} ghost={name}>
        <p class="actions"><a class="button button-ghost" href="/blog/">← All brewing notes</a></p>
    </PageHead>
    <div class="container list">
        <PostGrid posts={posts} />
    </div>
</Base>

<style>
    .list {
        padding: var(--space-12) 0 var(--section);
    }
</style>
