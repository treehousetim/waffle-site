---
/**
 * Who took the photographs, and whose typefaces these are. The example
 * photos are from Unsplash, free under the Unsplash License; credit is not
 * required, but given. Kept out of search results (src/site.ts, noindex).
 */
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { photos } from '../data/photos';

const credits = Object.values(photos);
---

<Base
    title="Photo and type credits"
    description="The photographers whose work appears on this site, with links to the originals, and the typefaces. Example photos are from Unsplash, under the Unsplash License."
    breadcrumbs={[{ name: 'Credits', href: '/credits/' }]}
>
    <PageHead eyebrow="Credits" heading="With thanks" lead="To the photographers whose work stands in for ours, and the type designers whose letters we cut our labels from." />

    <div class="prose page">
        <h2>Photographs</h2>
        <p>From <a href="https://unsplash.com/">Unsplash</a>, used under the <a href="https://unsplash.com/license">Unsplash License</a>. They are stand-ins: not our brewery, our beer or our people.</p>
        <ul>
            {
                credits.map((photo) => (
                    <li>
                        {photo.alt.replace(/\.$/, '')}: <a href={photo.credit.url}>{photo.credit.name}</a>
                    </li>
                ))
            }
        </ul>
        <h2>Typefaces</h2>
        <p><a href="https://github.com/xotypeco/big_shoulders">Big Shoulders Display and Big Shoulders Stencil Display</a>, by Patric King and XO Type, and <a href="https://github.com/solmatas/BitterPro">Bitter</a>, by Huerta Tipográfica, all under the <a href="https://openfontlicense.org/">SIL Open Font License</a>.</p>
        <h2>The rest</h2>
        <p>Ironwood Brewing Co., its beers, its people and the town of Wrenford are invented. The logo, the cans and the tap board are drawn for this site.</p>
    </div>
</Base>

<style>
    .page {
        padding-block: var(--space-12) var(--section);
    }
</style>
