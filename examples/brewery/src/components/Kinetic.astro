---
/**
 * Two lines of display type, far too big for the screen, that slide across
 * it in opposite directions as the page scrolls past (motion.css, on the
 * band's own view timeline). One line is solid copper, one is outline. Pure
 * decoration: hidden from assistive technology, and still without motion.
 */
interface Props {
    lines: [string, string];
}

const { lines } = Astro.props;
const repeat = (text: string) => Array.from({ length: 4 }, () => text).join('  •  ');
---

<div class="kinetic" aria-hidden="true">
    <p class="line one">{repeat(lines[0])}</p>
    <p class="line two">{repeat(lines[1])}</p>
</div>

<style>
    .kinetic {
        overflow: hidden;
        padding: clamp(2rem, 1rem + 4vw, 4.5rem) 0;
        border-block: 1px solid var(--seam);
        background: var(--soot);
        user-select: none;
    }

    .line {
        margin: 0;
        font-family: var(--font-display);
        font-size: clamp(4.5rem, 2rem + 10vw, 12rem);
        font-weight: 900;
        line-height: 0.88;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .one {
        color: var(--copper);
        transform: translateX(-8%);
    }

    .two {
        color: transparent;
        -webkit-text-stroke: 2px var(--bone);
        transform: translateX(-30%);
    }
</style>
