    .bubbles span:nth-child(10) { left: 57.0%; top: 36%; width: 0.85rem; height: 0.85rem; }
    .bubbles span:nth-child(11) { left: 11.0%; top: 48%; width: 0.7rem; height: 0.7rem; }
    .bubbles span:nth-child(12) { left: 97.3%; top: 31%; width: 1.2rem; height: 1.2rem; }
    .bubbles span:nth-child(13) { left: 36.1%; top: 49%; width: 0.4rem; height: 0.4rem; }
    .bubbles span:nth-child(14) { left: 90.0%; top: 12%; width: 1.2rem; height: 1.2rem; }
