---
/**
 * Carbonation: bubbles rising behind whatever this sits in (position it in
 * a relatively positioned parent). Pure decoration, hidden from assistive
 * technology. Each bubble's column, size, speed and start differ by
 * :nth-child in motion.css, so no inline style is needed; without motion
 * they sit still, a faint fizz in the background.
 */
interface Props {
    count?: number;
    tone?: 'foam' | 'copper';
}

const { count = 28, tone = 'foam' } = Astro.props;
---

<div class:list={['bubbles', tone]} aria-hidden="true">
    {Array.from({ length: count }, () => <span />)}
</div>

<style>
    .bubbles {
        position: absolute;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
    }

    .bubbles span {
        position: absolute;
        left: 50%;
        width: 0.5rem;
        height: 0.5rem;
        border: 1.5px solid rgb(251 244 230 / 0.35);
        border-radius: 50%;
        background: radial-gradient(circle at 35% 30%, rgb(255 255 255 / 0.35), transparent 55%);
        opacity: 0.55;
    }

    .bubbles span:nth-child(1) { left: 33.1%; top: 41%; width: 0.5rem; height: 0.5rem; }
    .bubbles span:nth-child(2) { left: 7.6%; top: 8%; width: 0.6rem; height: 0.6rem; }
    .bubbles span:nth-child(3) { left: 7.7%; top: 90%; width: 0.4rem; height: 0.4rem; }
