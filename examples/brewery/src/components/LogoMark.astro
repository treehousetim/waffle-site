---
/**
 * Ironwood's mark: a hex nut, riveted at its corners, holding a hop cone,
 * with three bubbles rising off it. Decorative wherever it appears (the name
 * beside it says who we are). The same drawing is public/favicon.svg and
 * the source of public/logo.png (brand/).
 *
 * The bubbles carry classes so the header can set them rising
 * (motion.css); everywhere else the mark is still.
 */
interface Props {
    size?: number;
    class?: string;
}

const { size = 48, class: className } = Astro.props;
---

<svg class:list={['mark', className]} width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <polygon class="nut" points="61,32 46.5,57.1 17.5,57.1 3,32 17.5,6.9 46.5,6.9" fill="#1e1b18" stroke="#dc8d50" stroke-width="3" stroke-linejoin="round"></polygon>
    <polygon points="55.5,32 43.75,52.35 20.25,52.35 8.5,32 20.25,11.65 43.75,11.65" fill="none" stroke="#574e45" stroke-width="1" stroke-dasharray="2 2"></polygon>
    <g fill="#dc8d50">
        <circle cx="56.2" cy="32" r="1.5"></circle>
        <circle cx="44.1" cy="53" r="1.5"></circle>
        <circle cx="19.9" cy="53" r="1.5"></circle>
        <circle cx="7.8" cy="32" r="1.5"></circle>
        <circle cx="19.9" cy="11" r="1.5"></circle>
        <circle cx="44.1" cy="11" r="1.5"></circle>
    </g>
    <path class="stem" d="M32 17 C31.5 14 33 12 36.5 11.2" fill="none" stroke="#aecb5c" stroke-width="2" stroke-linecap="round"></path>
    <g class="cone" fill="#aecb5c" stroke="#1e1b18" stroke-width="1.3" stroke-linejoin="round">
        <path d="M28 40.5 C28 46.35 30.4 48.6 32 49.5 C33.6 48.6 36 46.35 36 40.5 Q32 38.25 28 40.5Z"></path>
        <path d="M23 34.5 C23 41 25.7 43.5 27.5 44.5 C29.3 43.5 32 41 32 34.5 Q27.5 32 23 34.5Z"></path>
        <path d="M32 34.5 C32 41 34.7 43.5 36.5 44.5 C38.3 43.5 41 41 41 34.5 Q36.5 32 32 34.5Z"></path>
        <path d="M19.5 29 C19.5 35.5 22.08 38 23.8 39 C25.52 38 28.1 35.5 28.1 29 Q23.8 26.5 19.5 29Z"></path>
        <path d="M27.7 29 C27.7 35.5 30.28 38 32 39 C33.72 38 36.3 35.5 36.3 29 Q32 26.5 27.7 29Z"></path>
        <path d="M35.9 29 C35.9 35.5 38.48 38 40.2 39 C41.92 38 44.5 35.5 44.5 29 Q40.2 26.5 35.9 29Z"></path>
        <path d="M22.8 23.5 C22.8 30 25.62 32.5 27.5 33.5 C29.38 32.5 32.2 30 32.2 23.5 Q27.5 21 22.8 23.5Z"></path>
        <path d="M31.8 23.5 C31.8 30 34.62 32.5 36.5 33.5 C38.38 32.5 41.2 30 41.2 23.5 Q36.5 21 31.8 23.5Z"></path>
        <path d="M27.5 18 C27.5 24.5 30.2 27 32 28 C33.8 27 36.5 24.5 36.5 18 Q32 15.5 27.5 18Z"></path>
    </g>
    <g class="fizz-dots" fill="none" stroke="#f2e9da" stroke-width="1.3">
        <circle class="b1" cx="45.5" cy="20.5" r="1.4"></circle>
        <circle class="b2" cx="48.5" cy="15" r="2"></circle>
        <circle class="b3" cx="44.2" cy="13.2" r="1.1"></circle>
    </g>
</svg>
