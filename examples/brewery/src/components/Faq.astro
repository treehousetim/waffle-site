---
/**
 * Questions and answers as <details>, readable without script; they open
 * smoothly where the browser can animate to an auto height (motion.css).
 * Pass the same items to faqPage() in the page's jsonLd so search engines
 * can read them too.
 */
export interface FaqItem {
    question: string;
    answer: string;
}

interface Props {
    items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="faq">
    {
        items.map((item) => (
            <details>
                <summary>
                    <span>{item.question}</span>
                    <span class="marker" aria-hidden="true" />
                </summary>
                <p>{item.answer}</p>
            </details>
        ))
    }
</div>

<style>
    .faq {
        display: grid;
        gap: 0;
        border-top: 1px solid var(--seam);
    }

    details {
        border-bottom: 1px solid var(--seam);
        transition: background-color 0.2s ease;
    }

    details[open] {
        background: linear-gradient(90deg, rgb(220 141 80 / 0.07), transparent 70%);
    }

    summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-5);
        padding: var(--space-5) var(--space-2);
        color: var(--bone);
        font-family: var(--font-display);
        font-size: clamp(1.35rem, 1.15rem + 0.6vw, 1.7rem);
        font-weight: 750;
        letter-spacing: 0.02em;
        line-height: 1.1;
        text-transform: uppercase;
        list-style: none;
        cursor: pointer;
    }

    summary:hover {
        color: var(--copper-bright);
    }

    summary::-webkit-details-marker {
        display: none;
    }

    /* A hex-nut marker that turns a sixth as the answer opens. */
    .marker {
        position: relative;
        flex: none;
        width: 2rem;
        height: 2rem;
        background: var(--copper);
        clip-path: polygon(25% 5%, 75% 5%, 100% 50%, 75% 95%, 25% 95%, 0 50%);
        transition: transform 0.35s cubic-bezier(0.3, 1.4, 0.5, 1), background-color 0.2s ease;
    }

    .marker::before,
    .marker::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 0.8rem;
        height: 2px;
        margin: -1px 0 0 -0.4rem;
        background: var(--soot);
        transition: transform 0.25s ease;
    }

    .marker::after {
        transform: rotate(90deg);
    }

    details[open] .marker {
        background: var(--hop);
        transform: rotate(60deg);
    }

    details[open] .marker::after {
        transform: rotate(0deg);
    }

    p {
        max-width: 46rem;
        margin: 0;
        padding: 0 var(--space-2) var(--space-6);
        color: var(--ash);
    }
</style>
