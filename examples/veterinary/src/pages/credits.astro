---
/**
 * Who took the photographs, and whose typefaces these are. The example
 * photos are from Unsplash, free under the Unsplash License; credit is not
 * required, but given. Kept out of search results (src/site.ts, noindex).
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { photos } from '../data/photos';

const credits = Object.values(photos);
---

<Base
    title="Photo and type credits"
    description="The photographers whose work appears on this site, with links to the originals, and the typefaces. Example photos are from Unsplash, under the Unsplash License."
    breadcrumbs={[{ name: 'Credits', href: '/credits/' }]}
>
    <Hero tone="paper" icon="sparkle" eyebrow="Credits" heading="With thanks" lead="To the photographers whose pictures of other people’s pets stand in for ours, and to the people who made our typefaces." />

    <div class="prose page">
        <h2>Photographs</h2>
        <p>Every photograph is from <a href="https://unsplash.com/">Unsplash</a>, used under the <a href="https://unsplash.com/license">Unsplash License</a>. They are stand-ins for an example site: none of them shows our hospital, our team or our patients.</p>
        <ul class="credits">
            {credits.map((photo) => (
                <li>
                    {photo.alt.replace(/\.$/, '')}: <a href={photo.credit.url}>{photo.credit.name}</a>
                </li>
            ))}
        </ul>
        <h2>Typefaces</h2>
        <p>Headings are set in <a href="https://github.com/hafontia/Fredoka-One">Fredoka</a>, by Milena Brandão and the Fredoka Project Authors; body text in <a href="https://github.com/googlefonts/nunito">Nunito</a>, by Vernon Adams and the Nunito Project Authors. Both are under the <a href="https://openfontlicense.org/">SIL Open Font License</a>.</p>
        <h2>Drawings</h2>
        <p>The logo, icons, paw prints, bones and stickers were drawn for this site.</p>
    </div>
</Base>

<style>
    .page {
        padding: var(--space-8) 0 var(--section);
    }

    .credits li {
        line-height: 1.5;
    }
</style>
