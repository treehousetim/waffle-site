---
/** /blog/, then /blog/2/ and on: every post the build shows, newest first. */
import type { GetStaticPaths, Page } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import PostGrid from '../../components/PostGrid.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../site';
import { buildTime, settings } from '@core/settings';
import { tagIndex, visiblePosts } from '@core/lib/posts.js';

export const getStaticPaths = (async ({ paginate }) => {
    const posts = visiblePosts(await getCollection('blog'), { includeDrafts: !settings.production, now: buildTime });

    return paginate(posts, { pageSize: 7, props: { tags: tagIndex(posts) } });
}) satisfies GetStaticPaths;

interface Props {
    page: Page<CollectionEntry<'blog'>>;
    tags: ReturnType<typeof tagIndex>;
}

const { page, tags } = Astro.props;
const first = page.currentPage === 1;
// Page 2 and on need their own title and description (docs/seo.md, 12).
const title = first ? site.blog.title : `${site.blog.title}, page ${page.currentPage}`;
const description = first ? site.blog.description : `${site.blog.description} Page ${page.currentPage} of ${page.lastPage}.`;
---

<Base title={title} description={description} breadcrumbs={[{ name: site.blog.title, href: '/blog/' }]}>
    <Hero
        tone="mint"
        icon="leaf"
        eyebrow={first ? 'From our vets and nurses' : `Page ${page.currentPage} of ${page.lastPage}`}
        heading={first ? 'Pet-health advice, minus the panic' : title}
        lead="Straight answers to the questions we hear across the exam table every week, written by the people who answer them."
        photo="puppyRunning"
        shape="blob"
    >
        {
            tags.length > 0 && (
                <ul class="topics" aria-label="Topics">
                    {tags.map((tag) => (
                        <li>
                            <a href={`/blog/tags/${tag.slug}/`}>
                                {tag.tag} <span>{tag.count}</span>
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
    </Hero>

    <div class="container list">
        {page.data.length === 0 && <p>No posts yet.</p>}
        <PostGrid posts={page.data} feature={first} />

        {
            page.lastPage > 1 && (
                <nav class="pager" aria-label="More posts">
                    {page.url.prev ? <a class="button button-cream" href={page.url.prev}>← Newer posts</a> : <span />}
                    <span class="count"><Icon name="paw" size={18} /> Page {page.currentPage} of {page.lastPage}</span>
                    {page.url.next ? <a class="button button-cream" href={page.url.next}>Older posts →</a> : <span />}
                </nav>
            )
        }
    </div>
</Base>

<style>
    .topics {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .topics a {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        padding: 0.3rem 0.4rem 0.3rem 0.9rem;
        border: 2px solid var(--line);
        border-radius: 999px;
        background: var(--paper);
        color: var(--ink);
        font-size: 0.95rem;
        font-weight: 800;
        text-decoration: none;
        transition: background-color 0.15s ease, rotate 0.25s var(--spring);
    }

    .topics a:hover {
        background: var(--sun);
        rotate: -3deg;
    }

    .topics span {
        padding: 0 0.5rem;
        border-radius: 999px;
        background: var(--ink);
        color: var(--cream);
        font-size: 0.8rem;
    }

    .list {
        padding: var(--space-12) 0 var(--section);
    }

    .pager {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        margin-top: var(--space-16);
        padding-top: var(--space-8);
        border-top: var(--stroke) dashed var(--line);
    }

    .count {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        font-weight: 800;
    }

    .count :global(svg) {
        color: var(--tomato);
    }
</style>
