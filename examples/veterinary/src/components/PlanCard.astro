---
/**
 * One wellness plan from the waffle app, drawn as a ticket: the life stage
 * and price above a tear line, what it includes below. Every value comes
 * from the parsed answer (src/lib/wellness-plans.ts); none is typed here.
 */
import { monthly, speciesNames, stageName, type WellnessPlan } from '../lib/wellness-plans';

interface Props {
    plan: WellnessPlan;
    currency: string;
    level?: 'h2' | 'h3';
    /** Say the species in the label, where plans of several species sit together. */
    showSpecies?: boolean;
}

const { plan, currency, level = 'h3', showSpecies = false } = Astro.props;
const Heading = level;
const stage = stageName(plan.species, plan.lifeStage);
const label = showSpecies && plan.lifeStage !== 'young' ? `${stage} ${speciesNames[plan.species].one.toLowerCase()}` : stage;
---

<article class:list={['plan', 'sticker', `stage-${plan.lifeStage}`, { popular: plan.popular }]} data-plan={plan.id}>
    {plan.popular && <p class="badge">Most picked</p>}
    <header class="top">
        <p class="stage"><span class="stage-name">{label}</span> <span class="ages">{plan.ages}</span></p>
        <Heading class="name">{plan.name}</Heading>
        <p class="price"><strong class="amount">{monthly(plan, currency)}</strong> <span>a month</span></p>
    </header>
    <div class="tear" aria-hidden="true"></div>
    <ul class="paw-list inclusions">
        {plan.inclusions.map((line) => <li>{line}</li>)}
    </ul>
</article>

<style>
    .plan {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: var(--space-6);
        background: var(--paper);
    }

    .stage-young {
        background: var(--sun-soft);
    }

    .stage-senior {
        background: var(--mint-soft);
    }

    .popular {
        background: var(--sun);
    }

    .badge {
        position: absolute;
        top: -1.1rem;
        right: 1rem;
        margin: 0;
        padding: 0.25rem 0.85rem;
        border: var(--stroke) solid var(--line);
        border-radius: 999px;
        background: var(--tomato-ink);
        color: #ffffff;
        font-family: var(--font-display);
        font-size: 0.95rem;
        font-weight: 600;
        rotate: 4deg;
        box-shadow: 3px 3px 0 var(--line);
    }

    .stage {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0 var(--space-2);
        margin: 0 0 var(--space-2);
        font-size: 0.9rem;
    }

    .stage-name {
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .ages {
        color: var(--muted);
        font-weight: 700;
    }

    .name {
        margin-bottom: var(--space-2);
    }

    .price {
        display: flex;
        align-items: baseline;
        gap: var(--space-2);
        margin: 0;
    }

    .amount {
        font-family: var(--font-display);
        font-size: clamp(2.6rem, 2rem + 2vw, 3.4rem);
        font-weight: 700;
        line-height: 1;
    }

    .price span {
        font-weight: 800;
    }

    /* The tear line, with a notch bitten out of each side. */
    .tear {
        position: relative;
        margin: var(--space-5) calc(-1 * var(--space-6));
        border-top: var(--stroke) dashed var(--line);
    }

    .tear::before,
    .tear::after {
        content: '';
        position: absolute;
        top: -0.95rem;
        width: 1.6rem;
        height: 1.6rem;
        border: var(--stroke) solid var(--line);
        border-radius: 50%;
        background: var(--notch, var(--cream));
    }

    .tear::before {
        left: -0.95rem;
        clip-path: inset(0 0 0 50%);
    }

    .tear::after {
        right: -0.95rem;
        clip-path: inset(0 50% 0 0);
    }

    .inclusions {
        font-weight: 600;
    }
</style>
