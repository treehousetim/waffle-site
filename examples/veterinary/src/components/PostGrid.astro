---
import type { CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';

interface Props {
    posts: CollectionEntry<'blog'>[];
    level?: 'h2' | 'h3';
    /** The first post as a wide card across the top. */
    feature?: boolean;
}

const { posts, level = 'h2', feature = false } = Astro.props;
const [first, ...rest] = posts;
---

{feature && first && <div class="feature"><PostCard post={first} level={level} featured /></div>}

<ul class="posts">
    {
        (feature ? rest : posts).map((post) => (
            <li>
                <PostCard post={post} level={level} />
            </li>
        ))
    }
</ul>

<style>
    .feature {
        margin-bottom: var(--space-10);
    }

    .posts {
        display: grid;
        gap: var(--space-10) var(--space-8);
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .posts > li:nth-child(3n + 1) :global(.post-card) {
        rotate: -1deg;
    }

    .posts > li:nth-child(3n + 3) :global(.post-card) {
        rotate: 0.8deg;
    }
</style>
