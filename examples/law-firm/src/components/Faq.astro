---
/**
 * Questions and answers as <details>, readable without script; each opens
 * with a measured slide where the browser can animate its height
 * (motion.css). Pass the same items to faqPage() in the page's jsonLd so
 * search engines can read them too.
 */
export interface FaqItem {
    question: string;
    answer: string;
}

interface Props {
    items: FaqItem[];
    level?: 'h2' | 'h3';
}

const { items } = Astro.props;
---

<div class="faq">
    {
        items.map((item, index) => (
            <details>
                <summary>
                    <span class="q" aria-hidden="true">Q{index + 1}</span>
                    <span class="question">{item.question}</span>
                    <span class="marker" aria-hidden="true" />
                </summary>
                <p class="answer">{item.answer}</p>
            </details>
        ))
    }
</div>

<style>
    .faq {
        border-top: 1px solid var(--color-navy);
    }

    details {
        border-bottom: 1px solid var(--color-rule);
    }

    summary {
        display: grid;
        grid-template-columns: 2.75rem minmax(0, 1fr) 1.25rem;
        gap: var(--space-4);
        align-items: baseline;
        padding: var(--space-6) 0;
        list-style: none;
        cursor: pointer;
    }

    summary::-webkit-details-marker {
        display: none;
    }

    .q {
        color: var(--color-brass-ink);
        font-family: var(--font-sans);
        font-size: 0.75rem;
        font-variant-numeric: lining-nums tabular-nums;
        letter-spacing: 0.1em;
    }

    .question {
        color: var(--color-navy);
        font-size: 1.35rem;
        line-height: 1.3;
        transition: color 0.3s ease;
    }

    summary:hover .question,
    details[open] .question {
        color: var(--color-brass-ink);
    }

    .marker {
        position: relative;
        align-self: center;
        width: 1rem;
        height: 1rem;
    }

    .marker::before,
    .marker::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 0;
        width: 100%;
        height: 1px;
        background: var(--color-navy);
        transition: transform 0.5s var(--ease-out);
    }

    .marker::after {
        transform: rotate(90deg);
    }

    details[open] .marker::after {
        transform: rotate(0deg);
    }

    .answer {
        max-width: 42rem;
        margin: 0;
        padding: 0 0 var(--space-8) calc(2.75rem + var(--space-4));
        color: var(--color-prose);
    }

    @media (max-width: 40rem) {
        summary {
            grid-template-columns: 2rem minmax(0, 1fr) 1rem;
            gap: var(--space-3);
        }

        .question {
            font-size: 1.2rem;
        }

        .answer {
            padding-left: calc(2rem + var(--space-3));
        }
    }
</style>
