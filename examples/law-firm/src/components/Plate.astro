---
/**
 * A photograph set as a plate in a book: a fine brass frame offset behind
 * it, and a caption in small capitals with its plate number. The picture
 * drifts slowly inside its frame as the page scrolls (motion.css).
 */
import Photo from './Photo.astro';
import type { PhotoName } from '../data/photos';

interface Props {
    photo: PhotoName;
    /** "Plate I", "Fig. 2". */
    number?: string;
    caption?: string;
    shape?: 'portrait' | 'landscape' | 'wide' | 'square';
    sizes?: string;
    priority?: boolean;
    class?: string;
}

const { photo, number, caption, shape = 'portrait', sizes = '(min-width: 64rem) 40vw, 100vw', priority = false, class: className } = Astro.props;
---

<figure class:list={['plate', shape, className]}>
    <div class="frame">
        <Photo name={photo} sizes={sizes} priority={priority} class="plate-image" />
    </div>
    {
        (number || caption) && (
            <figcaption>
                {number && <span class="number">{number}</span>}
                {caption && <span>{caption}</span>}
            </figcaption>
        )
    }
</figure>

<style>
    .plate {
        position: relative;
        margin: 0;
    }

    .frame {
        position: relative;
        overflow: hidden;
        background: var(--color-vellum);
    }

    /* The brass frame: a hairline offset down and to the right. */
    .plate::before {
        content: '';
        position: absolute;
        inset: 0.85rem -0.85rem auto 0.85rem;
        aspect-ratio: var(--plate-ratio);
        border: 1px solid var(--color-brass);
        pointer-events: none;
    }

    .frame :global(.plate-image) {
        width: 100%;
        height: 100%;
        aspect-ratio: var(--plate-ratio);
        object-fit: cover;
        filter: saturate(0.82) contrast(1.02);
    }

    .portrait {
        --plate-ratio: 4 / 5;
    }

    .landscape {
        --plate-ratio: 3 / 2;
    }

    .wide {
        --plate-ratio: 21 / 9;
    }

    .square {
        --plate-ratio: 1 / 1;
    }

    figcaption {
        display: flex;
        flex-wrap: wrap;
        gap: 0.2rem var(--space-3);
        margin-top: calc(var(--space-4) + 0.85rem);
        color: var(--color-muted);
        font-size: 1rem;
        font-style: italic;
        line-height: 1.4;
    }

    .number {
        color: var(--color-brass-ink);
        font-style: normal;
        font-variant-caps: all-small-caps;
        letter-spacing: 0.12em;
    }

    @media (max-width: 40rem) {
        .wide {
            --plate-ratio: 3 / 2;
        }

        .plate::before {
            inset: 0.5rem -0.5rem auto 0.5rem;
        }
    }
</style>
