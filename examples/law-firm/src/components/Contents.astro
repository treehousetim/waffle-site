---
/**
 * The practice areas as a brief's table of contents: numeral, title, dot
 * leaders, and a short line. Each row is a <details> that opens with a
 * measured slide (interpolate-size, motion.css) to show what the practice
 * covers and a link to its page; without script, without motion, it opens
 * all the same. The titles carry view-transition names, so a title glides
 * into the heading of the page it opens.
 */
import { practices, practiceUrl } from '../data/practice';

interface Props {
    /** Open the first row on arrival. */
    openFirst?: boolean;
    level?: 'h2' | 'h3';
}

const { openFirst = false, level = 'h3' } = Astro.props;
const Heading = level;
---

<div class="contents">
    {
        practices.map((practice, index) => (
            <details class="row" name="practice" open={openFirst && index === 0}>
                <summary>
                    <span class="numeral">{practice.numeral}</span>
                    <Heading class="title">
                        <span class:list={['title-text', `vt-practice-${practice.slug}`]}>{practice.name}</span>
                    </Heading>
                    <span class="leader" aria-hidden="true"></span>
                    <span class="short">{practice.short}</span>
                    <span class="marker" aria-hidden="true"></span>
                </summary>
                <div class="body">
                    <p class="summary">{practice.summary}</p>
                    <ul class="matters">
                        {practice.matters.slice(0, 4).map((matter) => <li>{matter.title}</li>)}
                    </ul>
                    <a class="more" href={practiceUrl(practice.slug)}>
                        The practice in full<span class="visually-hidden">: {practice.name}</span>
                    </a>
                </div>
            </details>
        ))
    }
</div>

<style>
    .contents {
        border-top: 1px solid var(--color-navy);
    }

    .row {
        border-bottom: 1px solid var(--color-rule);
    }

    summary {
        display: grid;
        grid-template-columns: 3rem minmax(0, 1fr) 2rem;
        grid-template-areas:
            'numeral title marker'
            '. short .';
        align-items: first baseline;
        column-gap: var(--space-4);
        padding: var(--space-6) 0;
        list-style: none;
        cursor: pointer;
    }

    summary::-webkit-details-marker {
        display: none;
    }

    .numeral {
        grid-area: numeral;
        color: var(--color-brass-ink);
        font-size: 1.25rem;
        font-variant-caps: all-small-caps;
        letter-spacing: 0.08em;
    }

    .title {
        grid-area: title;
        margin: 0;
        font-size: clamp(1.55rem, 1.2rem + 1.4vw, 2.4rem);
        line-height: 1.15;
        transition: color 0.3s ease;
    }

    .title-text {
        display: inline-block;
    }

    .leader {
        display: none;
    }

    .short {
        grid-area: short;
        margin-top: var(--space-2);
        color: var(--color-muted);
        font-size: 1.05rem;
        font-style: italic;
    }

    /* A plus drawn in hairlines, turning to a minus when open. */
    .marker {
        grid-area: marker;
        position: relative;
        justify-self: end;
        width: 1.1rem;
        height: 1.1rem;
        align-self: center;
    }

    .marker::before,
    .marker::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 0;
        width: 100%;
        height: 1px;
        background: var(--color-navy);
        transition: transform 0.5s var(--ease-out);
    }

    .marker::after {
        transform: rotate(90deg);
    }

    .row[open] .marker::after {
        transform: rotate(0deg);
    }

    summary:hover .title,
    .row[open] .title {
        color: var(--color-brass-ink);
    }

    .body {
        display: grid;
        gap: var(--space-5);
        padding: 0 0 var(--space-8) calc(3rem + var(--space-4));
    }

    .summary {
        max-width: 40rem;
        margin: 0;
        color: var(--color-prose);
    }

    .matters {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2) var(--space-6);
        margin: 0;
        padding: 0;
        color: var(--color-navy);
        font-family: var(--font-sans);
        font-size: 0.875rem;
        list-style: none;
    }

    .matters li::before {
        content: '§';
        margin-right: 0.45em;
        color: var(--color-brass-ink);
    }

    .body .more {
        justify-self: start;
    }

    @media (min-width: 56rem) {
        summary {
            grid-template-columns: 4.5rem auto minmax(2rem, 1fr) auto 2.5rem;
            grid-template-areas: 'numeral title leader short marker';
        }

        /* Dot leaders, as in a table of contents. */
        .leader {
            display: block;
            grid-area: leader;
            align-self: end;
            height: 1px;
            margin: 0 var(--space-2) 0.55rem;
            background: radial-gradient(circle, var(--color-brass) 0.9px, transparent 1.2px) 0 50% / 7px 3px repeat-x;
            height: 3px;
        }

        .short {
            margin: 0;
            max-width: 20rem;
            text-align: right;
        }

        .body {
            padding-left: calc(4.5rem + var(--space-4));
        }
    }

    @media (max-width: 40rem) {
        summary {
            grid-template-columns: 2.25rem minmax(0, 1fr) 1.5rem;
            column-gap: var(--space-3);
        }

        .body {
            padding-left: calc(2.25rem + var(--space-3));
        }
    }
</style>
