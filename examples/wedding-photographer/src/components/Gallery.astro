---
/**
 * A story's photographs as a printed spread, and a full-screen viewer.
 *
 * The spread: each frame laid out as the story says (across the page, a
 * wide plate, or tall plates side by side), revealed by a curtain as it
 * scrolls into view, its caption sliding in after it (motion.css).
 *
 * The viewer works with no script at all: every photograph is a plain link
 * to "#view-<n>", and the slide with that id is shown with :target, with
 * links to the previous and next photograph and back to where you were.
 * src/scripts/viewer.ts adds the keyboard (arrows, Escape), swiping, focus
 * and history that does not fill up with every photograph you looked at.
 *
 * `from` is the first frame the spread shows: a story page shows frame 1 as
 * its hero, which opens the viewer at #view-1.
 */
import Photo from './Photo.astro';
import type { Frame } from '../data/stories';

interface Props {
    frames: readonly Frame[];
    /** A name for the viewer's slides, so two galleries on one page cannot collide. */
    id: string;
    from?: number;
    label: string;
}

const { frames, id, from = 1, label } = Astro.props;
const shown = frames.map((frame, index) => ({ ...frame, n: index + 1 })).filter((frame) => frame.n >= from);
const slide = (n: number) => `${id}-view-${n}`;
const figure = (n: number) => `${id}-fig-${n}`;
const total = frames.length;
---

<section class="spread" id={id} aria-label={label}>
    <div class="plates">
        {
            shown.map((frame) => (
                <figure class:list={['plate', frame.layout]} id={figure(frame.n)}>
                    <a class="open" href={`#${slide(frame.n)}`} data-viewer-open>
                        <span class="curtain">
                            <Photo
                                name={frame.photo}
                                sizes={frame.layout === 'bleed' ? '100vw' : frame.layout === 'wide' ? '(min-width: 64rem) 75vw, 100vw' : '(min-width: 48rem) 45vw, 100vw'}
                            />
                        </span>
                        <span class="visually-hidden">Open photograph {frame.n} of {total} full screen</span>
                    </a>
                    <figcaption class="caption">
                        <span class="fig">Fig. {frame.n}</span>
                        <span>{frame.caption}</span>
                    </figcaption>
                </figure>
            ))
        }
    </div>
</section>

<div class="viewer" data-viewer>
    {
        frames.map((frame, index) => {
            const n = index + 1;
            const back = n >= from ? figure(n) : id;

            return (
                <section class="slide" id={slide(n)} aria-label={`Photograph ${n} of ${total}`} data-slide>
                    <figure>
                        <Photo name={frame.photo} sizes="100vw" class="slide-photo" />
                        <figcaption>
                            <span class="count">
                                {String(n).padStart(2, '0')} / {String(total).padStart(2, '0')}
                            </span>
                            <span>{frame.caption}</span>
                        </figcaption>
                    </figure>
                    <nav class="controls" aria-label="Photographs">
                        {n > 1 ? (
                            <a class="prev" href={`#${slide(n - 1)}`} data-viewer-prev>
                                <span aria-hidden="true">⟵</span> Previous
                            </a>
                        ) : (
                            <span />
                        )}
                        <a class="close" href={`#${back}`} data-viewer-close>
                            Close
                        </a>
                        {n < total ? (
                            <a class="next" href={`#${slide(n + 1)}`} data-viewer-next>
                                Next <span aria-hidden="true">⟶</span>
                            </a>
                        ) : (
                            <span />
                        )}
                    </nav>
                </section>
            );
        })
    }
</div>

<script>
    import { enhanceViewers } from '../scripts/viewer';

    enhanceViewers(document);
</script>

<style>
    .plates {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: clamp(3rem, 2rem + 4vw, 7rem) var(--gutter);
        width: min(100% - 2 * var(--gutter), var(--width-page));
        margin-inline: auto;
    }

    .plate {
        grid-column: 1 / -1;
        margin: 0;
    }

    .open {
        display: block;
        cursor: zoom-in;
    }

    .curtain {
        display: block;
        overflow: hidden;
        background: var(--paper-deep);
    }

    .curtain :global(img) {
        transition: transform 1.4s var(--ease-out);
    }

    .open:hover .curtain :global(img),
    .open:focus-visible .curtain :global(img) {
        transform: scale(1.03);
    }

    /* Across the page: out to both edges, the caption kept in the margin. */
    .bleed .open {
        margin-inline: calc(50% - 50vw);
    }

    .bleed .curtain {
        height: min(88vh, 60rem);
    }

    .wide .curtain {
        aspect-ratio: 3 / 2;
    }

    .tall .curtain {
        aspect-ratio: 4 / 5;
    }

    @media (min-width: 48rem) {
        .wide {
            grid-column: 2 / -1;
        }

        .wide:nth-child(even of .wide) {
            grid-column: 1 / 12;
        }

        .tall {
            grid-column: span 6;
        }

        /* A tall plate on its own sits off-centre, like a single column on a spread. */
        .tall:not(.tall + .tall):not(:has(+ .tall)) {
            grid-column: 4 / span 6;
        }

        .tall + .tall {
            margin-top: clamp(4rem, 8vw, 9rem);
        }

        .caption {
            max-width: 32rem;
        }
    }

    /* The viewer: hidden until its slide is the page's target. */

    .slide {
        display: none;
    }

    .slide:target {
        position: fixed;
        inset: 0;
        z-index: 150;
        display: grid;
        grid-template-rows: minmax(0, 1fr) auto;
        gap: var(--space-4);
        padding: clamp(0.75rem, 2vw, 2rem);
        background: var(--ink);
        color: var(--on-ink);
    }

    :global(html:has(.slide:target)) {
        overflow: hidden;
    }

    .slide figure {
        display: grid;
        grid-template-rows: minmax(0, 1fr) auto;
        gap: var(--space-3);
        min-height: 0;
        margin: 0;
    }

    .slide :global(picture) {
        min-height: 0;
    }

    .slide :global(.slide-photo) {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .slide figcaption {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: var(--space-2) var(--space-4);
        color: var(--on-ink-muted);
        font-family: var(--font-display);
        font-size: 1rem;
        font-style: italic;
        text-align: center;
    }

    .count {
        color: var(--accent-on-ink);
        font-family: var(--font-sans);
        font-size: 0.75rem;
        font-style: normal;
        letter-spacing: 0.2em;
        line-height: 1.9;
    }

    .controls {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: var(--space-4);
    }

    .controls a {
        padding: 0.6rem 0;
        color: var(--on-ink);
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.2em;
        text-decoration: none;
        text-transform: uppercase;
    }

    .controls a:hover {
        color: var(--accent-on-ink);
    }

    .controls .next {
        justify-self: end;
    }

    .controls .close {
        padding-inline: 1.1rem;
        border: 1px solid color-mix(in srgb, var(--on-ink) 40%, transparent);
    }
</style>
