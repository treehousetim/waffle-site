---
/**
 * A photograph: from src/data/photos.ts by name, or any imported image with
 * its alt text. Astro's <Picture> serves AVIF with a WebP fallback, at the
 * sizes the layout needs, with a width and a height so the page does not
 * shift. The one way a page shows a photo.
 *
 * `priority` is for the one image at the top of a page (the hero): Astro
 * loads it straight away, at high priority; every other photo is lazy.
 * `alt=""` marks a photo as decoration where a link beside it already says
 * everything (a card whose title is the link).
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { photos, type PhotoName } from '../data/photos';

type Props = {
    /** How wide it is drawn, for the browser to pick a size: a CSS sizes value. */
    sizes?: string;
    priority?: boolean;
    class?: string;
    /** The widest the layout will ever draw it, in pixels. */
    maxWidth?: number;
} & ({ name: PhotoName; alt?: string } | { src: ImageMetadata; alt: string });

const { sizes = '(min-width: 64rem) 50vw, 100vw', priority = false, class: className, maxWidth = 1800 } = Astro.props;
const entry = 'name' in Astro.props ? photos[Astro.props.name] : Astro.props;
const src = entry.src;
const alt = Astro.props.alt ?? entry.alt;
---

<Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    layout="constrained"
    width={Math.min(src.width, maxWidth)}
    sizes={sizes}
    quality={68}
    priority={priority}
    class={className}
/>
