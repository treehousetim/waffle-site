---
/**
 * The next twelve months at a glance, from the waffle app's calendar
 * (GET /api/site/availability, checked by src/lib/availability.ts): each
 * month booked, nearly full, or open, with how many dates are free.
 * Every state is said in words as well as drawn, so it never relies on
 * colour or pattern alone.
 */
import { monthParts, type Availability } from '../lib/availability';

interface Props {
    availability: Availability;
}

const { availability } = Astro.props;
const updated = new Date(`${availability.updated}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const words = (status: string, dates: number) =>
    status === 'booked' ? 'Booked' : status === 'limited' ? `${dates} ${dates === 1 ? 'date' : 'dates'} left` : `Open, ${dates} dates`;
---

<figure class="calendar">
    <ol class="months">
        {
            availability.months.map((month) => {
                const parts = monthParts(month.month);

                return (
                    <li class:list={['month', month.status]} data-month={month.month}>
                        <span class="year">{parts.year}</span>
                        <span class="name" aria-hidden="true">{parts.short}</span>
                        <span class="visually-hidden">{parts.long} {parts.year}:</span>
                        <span class="swatch" aria-hidden="true" />
                        <span class="state">{words(month.status, month.openDates)}</span>
                    </li>
                );
            })
        }
    </ol>
    <figcaption>
        <span class="key"><span class="swatch open" aria-hidden="true"></span> Open</span>
        <span class="key"><span class="swatch limited" aria-hidden="true"></span> A few dates left</span>
        <span class="key"><span class="swatch booked" aria-hidden="true"></span> Booked</span>
        <span class="updated">From our calendar, {updated}. Dates go quickly; we hold one for a week while you decide.</span>
    </figcaption>
</figure>

<style>
    .calendar {
        margin: 0;
    }

    .months {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin: 0;
        padding: 0;
        border-top: 1px solid var(--rule-strong);
        border-left: 1px solid var(--rule);
        list-style: none;
    }

    .month {
        display: grid;
        align-content: start;
        gap: var(--space-1);
        padding: var(--space-4) var(--space-3) var(--space-5);
        border-right: 1px solid var(--rule);
        border-bottom: 1px solid var(--rule);
    }

    .year {
        color: var(--faint);
        font-size: 0.7rem;
        font-weight: 500;
        letter-spacing: 0.2em;
    }

    .name {
        font-family: var(--font-display);
        font-size: clamp(1.6rem, 1.3rem + 1vw, 2.1rem);
        line-height: 1;
    }

    .booked .name {
        color: var(--faint);
        text-decoration: line-through;
        text-decoration-thickness: 1px;
    }

    /* Open: an empty bar. A few left: part filled. Booked: filled, hatched. */
    .swatch {
        display: block;
        height: 0.45rem;
        margin: var(--space-3) 0 var(--space-2);
        border: 1px solid var(--ink);
    }

    .limited .swatch,
    .swatch.limited {
        background: linear-gradient(90deg, var(--accent) 0 70%, transparent 70%);
        border-color: var(--accent);
    }

    .booked .swatch,
    .swatch.booked {
        background: repeating-linear-gradient(135deg, var(--ink) 0 2px, transparent 2px 5px);
    }

    .state {
        font-size: 0.82rem;
        line-height: 1.3;
    }

    .limited .state {
        color: var(--accent);
        font-weight: 500;
    }

    .booked .state {
        color: var(--faint);
    }

    figcaption {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2) var(--space-6);
        margin-top: var(--space-5);
        color: var(--muted);
        font-size: 0.85rem;
    }

    .key {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
    }

    .key .swatch {
        width: 1.6rem;
        margin: 0;
    }

    .updated {
        flex-basis: 100%;
        font-family: var(--font-display);
        font-size: 0.95rem;
        font-style: italic;
    }

    @media (min-width: 40rem) {
        .months {
            grid-template-columns: repeat(6, minmax(0, 1fr));
        }
    }

    @media (min-width: 80rem) {
        .months {
            grid-template-columns: repeat(12, minmax(0, 1fr));
        }
    }
</style>
