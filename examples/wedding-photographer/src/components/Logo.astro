---
/**
 * The mark and the name. The mark is one line: an arched frame (a window, a
 * portrait's edge) whose left side hooks into a J, a valley dipping to a V
 * inside it, and the sun setting into the vale. The wordmark is set in the
 * display face with an italic oxblood ampersand.
 *
 * The same drawing is public/favicon.svg and, rendered, public/logo.png
 * (brand/logo.html). In the header it draws itself in on load and the sun
 * sinks and rises, very slowly (motion.css, "The logo").
 *
 * Decorative mark, so the name is the link's text.
 */
interface Props {
    tone?: 'ink' | 'paper';
    size?: 'small' | 'large';
    /** Show "Photography" under the name. */
    full?: boolean;
}

const { tone = 'ink', size = 'small', full = true } = Astro.props;
---

<a class:list={['logo', tone, size]} href="/">
    <svg class="mark" viewBox="0 0 40 52" width="40" height="52" aria-hidden="true" focusable="false">
        <path class="frame" pathLength="1" d="M31 47V21a11 11 0 0 0-22 0v23c0 5.2-3.6 6.9-6.6 5.4" />
        <path class="vale" pathLength="1" d="M9 31.5c5 1.4 8.6 5.6 11 10.5 2.4-4.9 6-9.1 11-10.5" />
        <circle class="sun" cx="20" cy="27.5" r="3.4" />
    </svg>
    <span class="words">
        <span class="name">Juniper <em>&amp;</em> Vale</span>
        {full && <span class="trade">Photography</span>}
    </span>
</a>

<style>
    .logo {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        color: var(--ink);
        text-decoration: none;
        white-space: nowrap;
    }

    .logo:hover {
        color: inherit;
    }

    .paper {
        color: var(--paper);
    }

    .mark {
        flex: none;
        width: 1.75rem;
        height: auto;
        overflow: visible;
    }

    .large .mark {
        width: 3.25rem;
    }

    .frame,
    .vale {
        fill: none;
        stroke: currentColor;
        stroke-width: 1.7;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .sun {
        fill: var(--accent);
    }

    .paper .sun {
        fill: var(--accent-on-ink);
    }

    .words {
        display: grid;
        line-height: 1;
    }

    .name {
        font-family: var(--font-display);
        font-size: 1.45rem;
        font-weight: 500;
        letter-spacing: -0.01em;
    }

    .large .name {
        font-size: clamp(2.25rem, 1.5rem + 3vw, 3.75rem);
    }

    .name em {
        color: var(--accent);
        font-style: italic;
        font-weight: 400;
    }

    .paper .name em {
        color: var(--accent-on-ink);
    }

    .trade {
        margin-top: 0.3rem;
        padding-left: 0.1rem;
        font-family: var(--font-sans);
        font-size: 0.56rem;
        font-weight: 500;
        letter-spacing: 0.48em;
        text-transform: uppercase;
    }

    .large .trade {
        margin-top: 0.7rem;
        font-size: 0.8rem;
    }
</style>
