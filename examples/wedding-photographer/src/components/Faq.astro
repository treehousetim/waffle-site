---
/**
 * Questions and answers as <details>, readable without script, each opening
 * smoothly to its own height (interpolate-size, motion.css). Pass the same
 * items to faqPage() in the page's jsonLd so search engines can read them.
 */
export interface FaqItem {
    question: string;
    answer: string;
}

interface Props {
    items: readonly FaqItem[];
    /** Where the numbering starts, so two lists on one page run on. */
    start?: number;
}

const { items, start = 1 } = Astro.props;
---

<div class="faq">
    {
        items.map((item, index) => (
            <details>
                <summary>
                    <span class="no">{String(start + index).padStart(2, '0')}</span>
                    <span class="q">{item.question}</span>
                    <span class="mark" aria-hidden="true" />
                </summary>
                <div class="answer">
                    <p>{item.answer}</p>
                </div>
            </details>
        ))
    }
</div>

<style>
    .faq {
        border-top: 1px solid var(--rule-strong);
    }

    details {
        border-bottom: 1px solid var(--rule);
    }

    summary {
        display: grid;
        grid-template-columns: 2.5rem 1fr 1.5rem;
        align-items: baseline;
        gap: var(--space-4);
        padding: var(--space-6) 0;
        cursor: pointer;
        list-style: none;
    }

    summary::-webkit-details-marker {
        display: none;
    }

    .no {
        color: var(--accent);
        font-family: var(--font-display);
        font-size: 1rem;
        font-style: italic;
    }

    .q {
        font-family: var(--font-display);
        font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.6rem);
        line-height: 1.25;
        transition: color 0.25s ease;
    }

    summary:hover .q {
        color: var(--accent);
    }

    /* A plus that turns into a minus. */
    .mark {
        position: relative;
        align-self: center;
        width: 1rem;
        height: 1rem;
    }

    .mark::before,
    .mark::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 0;
        width: 100%;
        height: 1px;
        background: currentColor;
        transition: transform 0.4s var(--ease-out);
    }

    .mark::after {
        transform: rotate(90deg);
    }

    details[open] .mark::after {
        transform: rotate(0deg);
    }

    .answer {
        padding: 0 0 var(--space-6) calc(2.5rem + var(--space-4));
    }

    .answer p {
        max-width: 40rem;
        margin: 0;
        color: var(--muted);
    }

    @media (max-width: 40rem) {
        summary {
            grid-template-columns: 2rem 1fr 1rem;
            gap: var(--space-3);
        }

        .answer {
            padding-left: calc(2rem + var(--space-3));
        }
    }
</style>
