---
/** /journal/tags/<tag>/ for every topic in use. */
import type { GetStaticPaths } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import PostCard from '../../../components/PostCard.astro';
import { site } from '../../../site';
import { buildTime, settings } from '@core/settings';
import { postsTagged, tagIndex, visiblePosts } from '@core/lib/posts.js';

export const getStaticPaths = (async () => {
    const posts = visiblePosts(await getCollection('journal'), { includeDrafts: !settings.production, now: buildTime });

    return tagIndex(posts).map((tag) => ({
        params: { tag: tag.slug },
        props: { name: tag.tag, posts: postsTagged(posts, tag.slug) },
    }));
}) satisfies GetStaticPaths;

interface Props {
    name: string;
    posts: CollectionEntry<'journal'>[];
}

const { name, posts } = Astro.props;
const count = posts.length === 1 ? 'one note' : `${posts.length} notes`;
---

<Base
    title={`Journal: ${name.toLowerCase()}`}
    description={`Every ${site.name} journal entry about ${name.toLowerCase()}: ${count}, newest first. Planning advice from two wedding photographers.`}
    breadcrumbs={[
        { name: site.blog.title, href: '/journal/' },
        { name, href: Astro.url.pathname },
    ]}
>
    <PageHead label={`The Journal · ${count}`} heading="On" italic={name.toLowerCase()}>
        <p class="actions"><a class="arrow-link" href="/journal/">Every entry</a></p>
    </PageHead>
    <div class="page list">
        {posts.map((post, index) => <PostCard post={post} index={index + 1} />)}
    </div>
</Base>

<style>
    .list {
        padding-bottom: var(--section);
        border-top: 1px solid var(--rule-strong);
    }
</style>
