---
/**
 * Questions and answers as <details>, readable without script; they open
 * smoothly where the browser can (styles/motion.css). Pass the same items
 * to faqPage() in the page's jsonLd so search engines can read them too.
 */
export interface FaqItem {
    question: string;
    answer: string;
}

interface Props {
    items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="faq">
    {
        items.map((item) => (
            <details>
                <summary>
                    <span>{item.question}</span>
                    <span class="marker" aria-hidden="true" />
                </summary>
                <p>{item.answer}</p>
            </details>
        ))
    }
</div>

<style>
    .faq {
        display: grid;
        max-width: 50rem;
        border-top: 2px solid var(--cocoa);
    }

    details {
        border-bottom: 2px dashed var(--color-line-strong);
    }

    summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        padding: var(--space-5) 0;
        font-size: clamp(1.15rem, 1.08rem + 0.3vw, 1.3rem);
        font-weight: 800;
        line-height: 1.3;
        list-style: none;
        cursor: pointer;
    }

    summary::-webkit-details-marker {
        display: none;
    }

    summary:hover {
        color: var(--terracotta-deep);
    }

    .marker {
        position: relative;
        flex: none;
        width: 2.1rem;
        height: 2.1rem;
        border: 2px solid var(--cocoa);
        border-radius: 50%;
        background: var(--butter);
        transition: rotate 0.3s ease, background-color 0.2s ease;
    }

    .marker::before,
    .marker::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 0.8rem;
        height: 2.5px;
        margin: -1.25px 0 0 -0.4rem;
        border-radius: 2px;
        background: var(--cocoa);
    }

    .marker::after {
        rotate: 90deg;
    }

    details[open] .marker {
        rotate: 135deg;
        background: var(--terracotta-bright);
    }

    p {
        max-width: 44rem;
        margin: 0;
        padding: 0 0 var(--space-6);
        color: var(--cocoa);
    }
</style>
