---
/**
 * The bakery's hand-drawn doodles: loaves, croissants, a cup with steam, a
 * rolling pin, wheat, a whisk, a sparkle and a scribbled arrow. One ink
 * line, a flat fill, like a marker sketch on a paper bag. Decorative: always
 * hidden from screen readers. styles/motion.css makes some of them move
 * (the steam rises, a doodle marked `float` bobs).
 */
interface Props {
    name: 'loaf' | 'boule' | 'croissant' | 'cup' | 'rolling-pin' | 'wheat' | 'whisk' | 'sparkle' | 'arrow' | 'slice' | 'bean';
    class?: string;
    /** Bob gently up and down. */
    float?: boolean;
}

const { name, class: className, float = false } = Astro.props;
const viewBox = name === 'rolling-pin' ? '0 0 160 40' : name === 'arrow' ? '0 0 80 50' : '0 0 64 64';
---

<svg class:list={['doodle', `doodle-${name}`, { float }, className]} viewBox={viewBox} aria-hidden="true" focusable="false">
    <g fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
        {
            name === 'loaf' && (
                <>
                    <path class="fill-kraft" d="M5 41 C5 27 19 19 32 19 C46 19 59 27 59 41 C59 46 55 48 49 48 H15 C9 48 5 46 5 41Z" />
                    <path d="M16 33 L24 26 M28 33 L36 25.5 M40 33.5 L48 27" />
                    <path class="ink-soft" d="M12 44 C20 46 44 46 52 44" />
                </>
            )
        }
        {
            name === 'boule' && (
                <>
                    <path class="fill-terracotta" d="M8 46 C8 30 18 17 32 17 C46 17 56 30 56 46 C56 50 53 52 49 52 H15 C11 52 8 50 8 46Z" />
                    <path class="ink-cream" d="M17 42 C21 31 31 25 44 26" stroke-width="3.4" />
                    <circle class="dot-cream" cx="40" cy="38" r="1.3" stroke="none" />
                    <circle class="dot-cream" cx="27" cy="45" r="1.1" stroke="none" />
                </>
            )
        }
        {
            name === 'croissant' && (
                <>
                    <path class="fill-butter" d="M15 39 C9 41 5 46 5 51 C10 50 15 46 18 42" />
                    <path class="fill-butter" d="M49 39 C55 41 59 46 59 51 C54 50 49 46 46 42" />
                    <ellipse class="fill-butter" cx="20" cy="35" rx="7.5" ry="10" transform="rotate(-38 20 35)" />
                    <ellipse class="fill-butter" cx="44" cy="35" rx="7.5" ry="10" transform="rotate(38 44 35)" />
                    <ellipse class="fill-butter" cx="32" cy="29" rx="9.5" ry="13" />
                    <path class="ink-soft" d="M27 22 C30 26 34 26 37 22 M26 31 C30 35 34 35 38 31" />
                </>
            )
        }
        {
            name === 'cup' && (
                <>
                    <path class="wisp wisp-1" d="M24 20 C20 15 28 11 24 5" />
                    <path class="wisp wisp-2" d="M32 21 C28 16 36 12 32 6" />
                    <path class="wisp wisp-3" d="M40 20 C36 15 44 11 40 5" />
                    <path class="fill-terracotta" d="M13 27 H49 V39 C49 47 42 52 31 52 C20 52 13 47 13 39Z" />
                    <path d="M49 31 C57 31 57 42 49 42" />
                    <path d="M7 56 C18 59 44 59 56 56" />
                    <path class="ink-cream" d="M19 33 C23 35 27 35 31 33" stroke-width="2" />
                </>
            )
        }
        {
            name === 'rolling-pin' && (
                <>
                    <rect class="fill-kraft" x="34" y="8" width="92" height="24" rx="10" />
                    <path d="M8 20 H34 M126 20 H152" stroke-width="7" />
                    <path class="ink-soft" d="M50 14 C70 12 90 12 110 14" />
                    <path class="ink-soft" d="M48 26 C66 28 96 28 114 26" />
                </>
            )
        }
        {
            name === 'wheat' && (
                <>
                    <path d="M32 60 C32 44 32 28 32 6" />
                    {[12, 22, 32, 42].map((y) => (
                        <>
                            <path class="fill-butter" d={`M31 ${y + 6} C24 ${y + 5} 21 ${y} 22 ${y - 4} C28 ${y - 3} 31 ${y + 1} 31 ${y + 6}Z`} />
                            <path class="fill-butter" d={`M33 ${y + 6} C40 ${y + 5} 43 ${y} 42 ${y - 4} C36 ${y - 3} 33 ${y + 1} 33 ${y + 6}Z`} />
                        </>
                    ))}
                </>
            )
        }
        {
            name === 'whisk' && (
                <>
                    <path d="M32 62 V40" stroke-width="5" />
                    <path d="M32 40 C18 32 20 6 32 4 C44 6 46 32 32 40Z" />
                    <path d="M32 40 C25 30 26 10 32 4 C38 10 39 30 32 40" />
                    <path d="M32 40 V4" />
                </>
            )
        }
        {
            name === 'sparkle' && <path class="fill-butter" d="M32 4 C34 22 42 30 60 32 C42 34 34 42 32 60 C30 42 22 34 4 32 C22 30 30 22 32 4Z" />
        }
        {
            name === 'arrow' && (
                <>
                    <path d="M4 10 C20 4 34 10 36 22 C38 34 22 36 24 26 C26 16 48 18 58 34 C61 39 63 42 64 44" />
                    <path d="M54 42 L64 45 L67 34" />
                </>
            )
        }
        {
            name === 'slice' && (
                <>
                    <path class="fill-cream" d="M8 44 L52 20 L56 30 L56 50 L8 54Z" />
                    <path class="fill-terracotta" d="M8 44 L52 20 L56 30 L10 49Z" />
                    <path class="ink-soft" d="M12 52 L54 42" />
                    <circle class="fill-butter" cx="44" cy="20" r="5" />
                </>
            )
        }
        {
            name === 'bean' && (
                <>
                    <ellipse class="fill-cocoa" cx="32" cy="32" rx="16" ry="23" transform="rotate(30 32 32)" />
                    <path class="ink-cream" d="M24 16 C34 26 28 38 40 48" stroke-width="2.4" />
                </>
            )
        }
    </g>
</svg>

<style>
    .doodle {
        color: var(--cocoa);
        overflow: visible;
    }

    .fill-kraft {
        fill: var(--kraft);
    }

    .fill-butter {
        fill: var(--butter);
    }

    .fill-terracotta {
        fill: var(--terracotta);
    }

    .fill-cream {
        fill: var(--cream);
    }

    .fill-cocoa {
        fill: var(--cocoa-raised);
    }

    .ink-soft {
        stroke: var(--crust);
        stroke-width: 1.8;
    }

    .ink-cream {
        stroke: var(--cream);
    }

    .dot-cream {
        fill: var(--cream);
    }

    .wisp {
        stroke: var(--crust);
        stroke-width: 2.2;
    }
</style>
