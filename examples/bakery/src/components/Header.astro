---
/**
 * The header: a cream bar with a wavy edge that stays at the top as you
 * scroll, the logo, the navigation with hand-drawn underlines, and the cake
 * order button cut like a bakery ticket.
 *
 * Two navigations, one shown at a time: a plain one on wide screens, and on
 * phones a <details> menu that opens without any script (the content
 * security policy allows no inline handlers, and a menu should not depend on
 * JavaScript anyway). A browser hides a closed <details>'s contents whatever
 * the CSS says, so the wide-screen navigation cannot live inside it.
 */
import Logo from './Logo.astro';
import Squiggle from './Squiggle.astro';
import { site, addressLine } from '../site';

const current = Astro.url.pathname;
const isCurrent = (href: string) => current === href || (href !== '/' && current.startsWith(href));
---

<header class="site-header">
    <div class="container bar">
        <Logo />

        <nav class="nav-wide" aria-label="Main">
            <ul>
                {
                    site.nav.map((link, index) => (
                        <li>
                            <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                                {link.label}
                                <Squiggle variant={((index % 3) + 1) as 1 | 2 | 3} />
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>

        <a class="ticket" href={site.cta.href}>
            <span>{site.cta.label}</span>
        </a>

        <details class="menu">
            <summary>
                <span class="burger" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="menu-label">Menu</span>
            </summary>
            <nav class="nav-narrow" aria-label="Main, on small screens">
                <ul>
                    {
                        site.nav.map((link) => (
                            <li>
                                <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                                    {link.label}
                                </a>
                            </li>
                        ))
                    }
                    <li><a href="/bakers/">The bakers</a></li>
                    <li><a href="/faq/">Questions</a></li>
                    <li><a href="/contact/">Contact</a></li>
                </ul>
                <a class="button button-large" href={site.cta.href}>{site.cta.label}</a>
                <p class="where">{addressLine} · <a href={`tel:${site.business.phoneE164}`}>{site.business.phone}</a></p>
            </nav>
        </details>
    </div>
</header>

<style>
    .site-header {
        position: sticky;
        top: 0;
        z-index: 30;
        background: var(--cream);
    }

    /* A wavy cocoa line under the bar, like piped icing. */
    .site-header::before,
    .site-header::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        top: calc(100% - 1px);
        height: 13px;
        background: var(--cocoa);
        mask: var(--wave) repeat-x bottom / 48px 13px;
        -webkit-mask: var(--wave) repeat-x bottom / 48px 13px;
        transform: scaleY(-1);
        pointer-events: none;
    }

    .site-header::after {
        height: 10px;
        background: var(--cream);
        mask-size: 48px 10px;
        -webkit-mask-size: 48px 10px;
    }

    .bar {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        min-height: var(--header-height);
    }

    ul {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .nav-wide,
    .ticket {
        display: none;
    }

    .nav-wide ul {
        display: flex;
        gap: clamp(0.75rem, 0.2rem + 1.2vw, 1.6rem);
    }

    .nav-wide a {
        position: relative;
        display: block;
        padding: var(--space-2) 0;
        color: var(--cocoa);
        font-size: 1.1rem;
        font-weight: 750;
        text-decoration: none;
        white-space: nowrap;
    }

    .nav-wide a:hover {
        color: var(--terracotta-deep);
    }

    .nav-wide a[aria-current='page'] {
        color: var(--terracotta);
    }

    .nav-wide a :global(.squiggle) {
        bottom: 0;
    }

    /* The order button: a ticket with notched ends. */
    .ticket {
        position: relative;
        align-items: center;
        min-height: 2.9rem;
        padding: 0.5rem 1.35rem;
        background: var(--terracotta);
        color: var(--cream);
        font-family: var(--font-display);
        font-size: 1.08rem;
        line-height: 1;
        text-decoration: none;
        white-space: nowrap;
        mask: radial-gradient(circle at 0 50%, transparent 0.5rem, black 0.55rem) left / 51% 100% no-repeat,
            radial-gradient(circle at 100% 50%, transparent 0.5rem, black 0.55rem) right / 51% 100% no-repeat;
        -webkit-mask: radial-gradient(circle at 0 50%, transparent 0.5rem, black 0.55rem) left / 51% 100% no-repeat,
            radial-gradient(circle at 100% 50%, transparent 0.5rem, black 0.55rem) right / 51% 100% no-repeat;
        transition: background-color 0.15s ease, rotate 0.2s ease;
    }

    .ticket span {
        padding: 0.35rem 0.1rem;
        border-block: 1.5px dashed rgb(251 243 228 / 0.55);
    }

    .ticket:hover {
        background: var(--terracotta-deep);
        color: var(--cream);
        rotate: -2deg;
    }

    summary {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        min-height: 2.9rem;
        padding: 0 0.9rem;
        border: 2px solid var(--cocoa);
        border-radius: 999px;
        background: var(--butter);
        box-shadow: var(--shadow-print-small);
        font-weight: 800;
        list-style: none;
        cursor: pointer;
    }

    summary::-webkit-details-marker {
        display: none;
    }

    .burger {
        display: grid;
        gap: 4px;
        width: 1.1rem;
    }

    .burger i {
        display: block;
        height: 2.5px;
        border-radius: 2px;
        background: var(--cocoa);
        transition: transform 0.2s ease, opacity 0.2s ease;
    }

    .menu[open] .burger i:nth-child(1) {
        transform: translateY(6.5px) rotate(45deg);
    }

    .menu[open] .burger i:nth-child(2) {
        opacity: 0;
    }

    .menu[open] .burger i:nth-child(3) {
        transform: translateY(-6.5px) rotate(-45deg);
    }

    .nav-narrow {
        position: absolute;
        left: calc(-1 * var(--gutter));
        right: calc(-1 * var(--gutter));
        top: calc(100% + 10px);
        max-height: calc(100dvh - var(--header-height) - 10px);
        overflow-y: auto;
        padding: var(--space-4) var(--gutter) var(--space-8);
        background: var(--cream);
        background-image: var(--grain);
        border-bottom: 2px solid var(--cocoa);
        box-shadow: var(--shadow-soft);
    }

    .nav-narrow ul {
        margin-bottom: var(--space-6);
    }

    .nav-narrow li + li {
        border-top: 1.5px dashed var(--color-line-strong);
    }

    .nav-narrow li a {
        display: block;
        padding: var(--space-3) 0;
        color: var(--cocoa);
        font-family: var(--font-display);
        font-size: 1.6rem;
        line-height: 1.2;
        text-decoration: none;
    }

    .nav-narrow li a[aria-current='page'] {
        color: var(--terracotta);
    }

    .nav-narrow .button {
        width: 100%;
    }

    .where {
        margin: var(--space-5) 0 0;
        color: var(--crust);
        font-size: 1rem;
    }

    @media (min-width: 68rem) {
        .nav-wide,
        .ticket {
            display: flex;
        }

        .menu {
            display: none;
        }
    }

    @media (max-width: 24rem) {
        .menu-label {
            display: none;
        }
    }
</style>
