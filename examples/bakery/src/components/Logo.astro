---
/**
 * The mark and the name. The mark is a kettle whose body is a scored round
 * loaf, with steam off the spout (the same drawing as public/favicon.svg
 * and brand/mark.svg). The steam drifts and the kettle rocks a little on
 * hover (styles/motion.css). Decorative mark, so the name is the link's text.
 */
import { site } from '../site';

interface Props {
    tone?: 'dark' | 'light';
    size?: 'normal' | 'large';
}

const { tone = 'dark', size = 'normal' } = Astro.props;
const [first, second] = site.name.split(' & ');
---

<a class:list={['logo', tone, size]} href="/" aria-label={`${site.name}, home`}>
    <svg class="mark" viewBox="0 0 80 80" width="52" height="52" aria-hidden="true" focusable="false">
        <g fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path class="steam steam-1" d="M64 22 C60 17 68 13 64 7" stroke-width="3.2" />
            <path class="steam steam-2" d="M71 25 C68 21 74 17 71 12" stroke-width="3.2" />
            <g class="kettle">
                <path class="ink" d="M22 30 C22 12 50 12 50 30" stroke-width="5" />
                <path class="ink ink-fill" d="M55 52 C60 47 61 40 64 34 L67 29 C69 27 71 28 70 31 L67 39 C65 46 62 53 58 58 Z" stroke-width="2" />
                <path class="loaf" d="M11 58 C11 38 22 25 36 25 C50 25 61 38 61 58 C61 62 59 64 55 64 H17 C13 64 11 62 11 58 Z" stroke-width="3.5" />
                <path class="score" d="M20 54 C25 42 36 35 49 36" stroke-width="4.2" />
                <path class="ear" d="M23 49 C27 43 33 40 39 39" stroke-width="2" />
                <circle class="flour" cx="44" cy="47" r="1.6" />
                <circle class="flour" cx="50" cy="52" r="1.3" />
                <circle class="flour" cx="31" cy="57" r="1.3" />
                <circle class="knob" cx="36" cy="22" r="3.6" stroke-width="3" />
            </g>
        </g>
    </svg>
    <span class="word" aria-hidden="true">
        {first}<span class="amp">&amp;</span>{second}
    </span>
</a>

<style>
    .logo {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        color: var(--cocoa);
        text-decoration: none;
        white-space: nowrap;
    }

    .mark {
        flex: none;
        width: 3.1rem;
        height: 3.1rem;
        overflow: visible;
    }

    .large .mark {
        width: 4.5rem;
        height: 4.5rem;
    }

    .ink {
        stroke: var(--cocoa);
    }

    .ink-fill {
        fill: var(--cocoa);
    }

    .loaf {
        fill: var(--terracotta);
        stroke: var(--cocoa);
    }

    .score {
        stroke: var(--cream);
    }

    .ear {
        stroke: var(--butter);
    }

    .flour {
        fill: var(--cream);
    }

    .knob {
        fill: var(--butter);
        stroke: var(--cocoa);
    }

    .steam {
        stroke: var(--kraft-deep);
    }

    .word {
        display: inline-flex;
        align-items: baseline;
        gap: 0.2em;
        font-family: var(--font-display);
        font-size: 1.55rem;
        line-height: 1;
        letter-spacing: -0.01em;
    }

    .large .word {
        font-size: clamp(2rem, 1.5rem + 2vw, 2.8rem);
    }

    .amp {
        margin-right: 0.12em;
        color: var(--terracotta);
        font-family: var(--font-hand);
        font-size: 1.25em;
        font-weight: 700;
        line-height: 0.6;
        rotate: -8deg;
    }

    .light {
        color: var(--cream);
    }

    .light .ink {
        stroke: var(--cream);
    }

    .light .ink-fill {
        fill: var(--cream);
    }

    .light .loaf,
    .light .knob {
        stroke: var(--cream);
    }

    .light .amp {
        color: var(--butter);
    }

    .light .steam {
        stroke: var(--butter);
    }

    .logo:hover {
        color: inherit;
    }

    .light:hover {
        color: var(--cream);
    }
</style>
