---
/** /journal/tags/<tag>/ for every tag in use. */
import type { GetStaticPaths } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import PostGrid from '../../../components/PostGrid.astro';
import { site } from '../../../site';
import { buildTime, settings } from '@core/settings';
import { postsTagged, tagIndex, visiblePosts } from '@core/lib/posts.js';

export const getStaticPaths = (async () => {
    const posts = visiblePosts(await getCollection('blog'), { includeDrafts: !settings.production, now: buildTime });

    return tagIndex(posts).map((tag) => ({
        params: { tag: tag.slug },
        props: { name: tag.tag, posts: postsTagged(posts, tag.slug) },
    }));
}) satisfies GetStaticPaths;

interface Props {
    name: string;
    posts: CollectionEntry<'blog'>[];
}

const { name, posts } = Astro.props;
const count = posts.length === 1 ? 'one post' : `${posts.length} posts`;
---

<Base
    title={`Journal: ${name}`}
    description={`Every Crumb & Kettle journal post about ${name.toLowerCase()}: ${count}, newest first. Recipes and baking notes from our Larkhaven bakehouse.`}
    breadcrumbs={[
        { name: site.blog.title, href: site.blog.path },
        { name, href: Astro.url.pathname },
    ]}
>
    <PageHero eyebrow={`Topic · ${count}`} heading={name} lead={`From the journal: everything we have written about ${name.toLowerCase()}.`} secondary={{ label: '← The whole journal', href: site.blog.path }} doodle="wheat" />
    <div class="container list">
        <PostGrid posts={posts} />
    </div>
</Base>

<style>
    .list {
        padding: var(--space-12) 0 var(--section);
    }
</style>
