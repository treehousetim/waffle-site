---
/**
 * Who took the photographs, and whose typefaces these are. The example
 * photos are from Unsplash, free under the Unsplash License; credit is not
 * required, but given. Kept out of search results (src/site.ts, noindex).
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { photos } from '../data/photos';

const credits = Object.values(photos);
---

<Base
    title="Photo credits"
    description="The photographers whose work appears on this site, with links to the originals, and the typefaces. Example photos are from Unsplash, under the Unsplash License."
    breadcrumbs={[{ name: 'Photo credits', href: '/credits/' }]}
>
    <PageHero eyebrow="With thanks" heading="Photo credits" lead="The photographers whose work stands in for a real bakery’s own photos on this example site." doodle="sparkle" />

    <div class="prose page">
        <p>Photographs from <a href="https://unsplash.com/">Unsplash</a>, used under the <a href="https://unsplash.com/license">Unsplash License</a>.</p>
        <ul>
            {credits.map((photo) => (
                <li>
                    {photo.alt.replace(/\.$/, '')}: <a href={photo.credit.url}>{photo.credit.name}</a>
                </li>
            ))}
        </ul>
        <h2>Typefaces</h2>
        <p>
            Bagel Fat One by the Bagel Fat Project Authors (JAMO), Alegreya by Huerta Tipográfica, and Caveat by Impallari Type, all under the <a href="https://openfontlicense.org/">SIL Open Font License</a>.
        </p>
        <p>The logo, doodles, stamps and map are drawn for this site.</p>
    </div>
</Base>

<style>
    .page {
        padding-bottom: var(--section);
    }
</style>
