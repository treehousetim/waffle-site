---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../site';
---

<Base
    title="Privacy policy"
    description="What the Crumb & Kettle website collects when you order a cake, why, how long we keep it and how to ask us to delete it. Plain language, and no tracking."
    breadcrumbs={[{ name: 'Privacy', href: '/privacy/' }]}
>
    <PageHero eyebrow="The small print, kept small" heading="Privacy policy" doodle="wheat" />

    <div class="prose page">
        <p class="muted">Example text for a fictional bakery. Replace it with your own policy before you launch.</p>
        <h2>What this website collects</h2>
        <p>
            This website sets no tracking cookies and runs no third-party analytics, embeds or maps. When you send the cake order form, we
            receive what you typed in it (your name, email, phone number and the details of your cake) so that we can reply, bake it and
            hand it over.
        </p>
        <h2>How long we keep it</h2>
        <p>Cake orders are kept for two years, so we can bake the same cake again if you ask, and invoices for as long as tax rules require.</p>
        <h2>Who sees it</h2>
        <p>The five of us. We never sell it or share it, and we only email you about your order.</p>
        <h2>Your rights</h2>
        <p>Ask us to see, correct or delete anything we hold about you at <a href={`mailto:${site.business.email}`}>{site.business.email}</a>.</p>
    </div>
</Base>

<style>
    .page {
        padding-bottom: var(--section);
    }
</style>
