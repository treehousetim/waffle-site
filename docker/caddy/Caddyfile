# The web server, locally and in production. docs/https.md explains it, and
# tests/infra/caddyfile.test.js asserts every rule below.
#
# It does two things: serves the built site as files, and forwards
# /api/site/* to the waffle app (docs/waffle-api.md). There is no PHP and no
# Node in production; this is the whole server.
#
# SITE_ADDRESS decides the mode. Locally docker-compose.yml sets ":80": plain
# HTTP, no certificate. In production docker-compose.prod.yml sets the
# hostname, and Caddy gets and renews its certificate from Let's Encrypt and
# redirects HTTP to HTTPS on its own.
#
# SITE_ROOT is the directory served: dist/ locally, and in production the
# `current` link deploy.sh points at the release it is serving.
#
# Do NOT edit this file on the server. The next deploy overwrites it; change it
# here and release. deploy.sh validates it before anything restarts.
#
# Comments are whole lines only; the shape test strips them before reading.

# Security headers, on every response.
#
# `defer` writes them as the response leaves, so the waffle app's own headers
# on a proxied answer cannot drop or weaken one.
#
# HSTS pins browsers to HTTPS (ignored over plain HTTP, so harmless locally).
# nosniff: a file is only ever what its type says.
# The content security policy allows scripts, styles, fonts and connections
# from this site only, and nothing inline: the build emits no inline script or
# style (astro.config.mjs) and the audit fails a page that has one, so a
# script injected into a page through content cannot run. JSON-LD is data, not
# script, and is unaffected. Nothing may frame the site.
# The referrer policy sends only the origin to other sites.
(security_headers) {
	header {
		defer
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}
}

{$SITE_ADDRESS} {
	import security_headers

	root * {$SITE_ROOT}
	encode zstd gzip

	# Forms are the only bodies this site accepts, and none is large.
	request_body {
		max_size 64KB
	}

	# .well-known stays reachable (security.txt, app links); every other
	# dotfile is refused. Let's Encrypt's challenge is answered by Caddy itself
	# before any of this runs.
	@dotfiles {
		path_regexp /\.
		not path /.well-known/*
	}

	# A browser says where a request came from, and script cannot change it.
	# A form posted from another site is refused before it reaches the app.
	@crossSite {
		path /api/site/*
		header_regexp Sec-Fetch-Site ^(cross-site|same-site)$
	}

	# One route, so the order below is the order things happen. Caddy otherwise
	# sorts directives by its own rules, and here the order is the security.
	route {
		respond @dotfiles 404
		respond @crossSite "That request did not come from this site." 403

		# The waffle app, for forms and anything live (docs/waffle-api.md).
		# The visitor's cookies and the browser's origin headers stay here: the
		# app is called by this site, identified by the site key, and must not
		# be handed a session it could mistake for a signed-in user. The
		# visitor's address goes as X-Forwarded-For, for rate limiting.
		handle /api/site/* {
			header Cache-Control "no-store"
			reverse_proxy {$WAFFLE_APP_URL} {
				header_up Host {upstream_hostport}
				header_up X-Site-Key {$WAFFLE_SITE_KEY}
				header_up X-Forwarded-Host {host}
				header_up -Cookie
				header_up -Authorization
				header_up -Origin
				header_up -Referer
				header_up -Sec-Fetch-Site
				header_up -Sec-Fetch-Mode
				header_up -Sec-Fetch-Dest
				header_up -Sec-Fetch-User
				header_down -Set-Cookie
			}
		}

		# Astro writes content-hashed filenames here, so they never change.
		handle /_astro/* {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		# Pages and everything else: cacheable, but checked every time, so a
		# release is visible on the next page load.
		header Cache-Control "public, max-age=0, must-revalidate"

		# /pricing is redirected to /pricing/ by the file server itself, which
		# is the canonical form every page names (docs/seo.md).
		file_server
	}

	# The site's own 404 page, with a real 404 status, for anything not in
	# the build.
	handle_errors 404 {
		import security_headers
		rewrite * /404.html
		file_server {
			status 404
		}
	}

	handle_errors {
		import security_headers
		respond "{err.status_code} {err.status_text}"
	}
}
