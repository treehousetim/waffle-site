# Runs waffle_site-deploy.service every minute (docs/pull-based-deployments.md).
# A tick that finds a deploy still running skips itself (pull.sh's lock).

[Unit]
Description=Check for a new waffle_site release every minute

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
Unit=waffle_site-deploy.service

[Install]
WantedBy=timers.target
